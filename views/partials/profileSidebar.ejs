<aside class="profile-sidebar">

    <div class="profile-card">

        <div class="profile-image">

            <img
                src="<%= user.profileImage || '/images/profile/default.png' %>"
                alt="Profile Image">

            <a href="/profile/change-photo" class="camera-btn">
                <i class="bi bi-camera-fill"></i>
            </a>

        </div>

        <h3><%= user.name %></h3>

        <p><%= user.email %></p>

    </div>

    <div class="sidebar-menu">

        <a href="/profile"
           class="<%= activePage==='profile' ? 'active' : '' %>">
            <i class="bi bi-person-circle"></i>
            <span>My Profile</span>
        </a>

        <a href="/orders"
           class="<%= activePage==='orders' ? 'active' : '' %>">
            <i class="bi bi-box-seam"></i>
            <span>My Orders</span>
        </a>

        <a href="/wishlist"
           class="<%= activePage==='wishlist' ? 'active' : '' %>">
            <i class="bi bi-heart"></i>
            <span>Wishlist</span>
        </a>

        <a href="/cart"
           class="<%= activePage==='cart' ? 'active' : '' %>">
            <i class="bi bi-bag"></i>
            <span>Cart</span>
        </a>

        <a href="/addresses"
           class="<%= activePage==='addresses' ? 'active' : '' %>">
            <i class="bi bi-geo-alt"></i>
            <span>Addresses</span>
        </a>

        <a href="/coupons"
           class="<%= activePage==='coupons' ? 'active' : '' %>">
            <i class="bi bi-ticket-perforated"></i>
            <span>Coupons</span>
        </a>

        <a href="/wallet"
           class="<%= activePage==='wallet' ? 'active' : '' %>">
            <i class="bi bi-wallet2"></i>
            <span>Wallet</span>
        </a>

        <a href="/refer"
           class="<%= activePage==='refer' ? 'active' : '' %>">
            <i class="bi bi-gift"></i>
            <span>Refer & Earn</span>
        </a>

        <a href="/logout" class="logout">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
        </a>

    </div>

</aside>