<%- include("../partials/header") %>
<%- include("../partials/navbar") %>
<link rel="stylesheet" href="/css/profile/sidebar.css">
<link rel="stylesheet" href="/css/profile/changeEmail.css">
<link rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="profile-container">

    <!-- Sidebar -->
    <%- include("../partials/profileSidebar") %>

    <!-- Right Content -->

    <section class="profile-content">

        <div class="content-header">

            <h2>Change Email</h2>

            <p>
                Update your email address. An OTP will be sent to your new email for verification.
            </p>

        </div>

        <!-- Success Message -->
        <% if (success && typeof success === "string") { %>
            <div class="success-box">
                <%= success %>
            </div>
        <% } %>

        <!-- Error Message -->
        <% if (error && error.general) { %>
            <div class="error-box">
                <%= error.general %>
            </div>
        <% } %>

        <div class="profile-form-card">

            <form action="/user/profile/edit-email" method="POST" novalidate>

            

                <!-- New Email -->

                <div class="form-group">

                    <label>Enter New Email Address</label>

                    <input
                        type="email"
                        name="email"
                        placeholder="Enter new email"
                        value="<%= formData.email || '' %>"
                        required>
                    <% if (error && error.email) { %>
                        <small class="text-danger">
                            <%= error.email %>
                        </small>
                    <% } %>


                </div>

                <!-- Buttons -->

                <div class="button-group">

                    <button
                        type="submit"
                        class="save-btn">

                        <i class="bi bi-envelope-check"></i>

                        Send OTP

                    </button>

                </div>

                <div class="back-link">

                    <a href="/user/profile">

                        <i class="bi bi-arrow-left"></i>

                        Back to Profile

                    </a>

                </div>

            </form>

        </div>

    </section>

</div>

<div class="profile-bottom">

    CHRONIX • Terms & Conditions • Privacy Policy

</div>

</body>
</html>