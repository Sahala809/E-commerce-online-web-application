<%- include("../partials/header") %>

<%- include("../partials/navbar") %>

<link rel="stylesheet" href="/css/product/wishlist.css">

<main class="wishlist-container">


<!-- ================= BREADCRUMB ================= -->

<div class="breadcrumb">

    <a href="/user/home">
        Home
    </a>

    <span>›</span>

    <span>
        Wishlist
    </span>

</div>


<!-- ================= WISHLIST HEADING ================= -->

<div class="wishlist-title-section">

    <h1 class="wishlist-title">
        WISHLIST
    </h1>

    <p class="wishlist-subtitle">
        Your favourite watches, all in one place
    </p>

</div>


<!-- ================= WISHLIST CONTENT ================= -->

<% if (wishlist && wishlist.items && wishlist.items.length > 0) { %>

    <div class="wishlist-grid">

        <% wishlist.items.forEach(item => { %>

            <%
                const product = item.productId;
                const variant = item.variantId;
            %>


            <!-- ================= WISHLIST CARD ================= -->

            <div class="wishlist-card">


                <!-- ================= IMAGE ================= -->

                <div class="wishlist-image">

                    <% if (
                        variant &&
                        variant.images &&
                        variant.images.length > 0
                    ) { %>

                        <a href="/user/product/<%= product._id %>">
    <img
        src="/uploads/variants/<%= variant.images[0] %>"
        alt="<%= product ? product.productName : 'Product unavailable' %>"
    >
</a>

                    <% } else { %>

                        <div class="no-wishlist-image">

                            <i class="bi bi-image"></i>

                        </div>

                    <% } %>


                    <!-- ================= DELETE BUTTON ================= -->

                    <div class="wishlist-remove">

                        <% if (product && variant) { %>

                            <!--
                                NORMAL ITEM
                                Product and variant still exist
                            -->

                            <form
    action="/user/wishlist/remove/<%= product._id %>/<%= variant._id %>?_method=DELETE"
    method="POST"
    class="wishlist-remove-form"
>
    <button
        type="button"
        class="wishlist-remove-btn"
        title="Remove from Wishlist"
        data-product-id="<%= product._id %>"
        data-variant-id="<%= variant._id %>"
    >
        <i class="bi bi-trash3"></i>
    </button>
</form>

                        <% } else if (item._id) { %>

                            <!--
                                UNAVAILABLE ITEM
                                Product or variant was deleted

                                Use wishlist item _id
                            -->

                            <form
                                action="/user/wishlist/remove-item/<%= item._id %>?_method=DELETE"
                                method="POST"
                            >
                                <button
                                    type="submit"
                                    class="wishlist-remove-btn"
                                    title="Remove unavailable item"
                                >
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>


                        <% } %>

                    </div>

                </div>


                <!-- ================= PRODUCT INFORMATION ================= -->

                <div class="wishlist-info">


                    <!-- ================= PRODUCT NAME ================= -->

                    <% if (product) { %>

                        <h3 class="wishlist-product-name">

                            <%= product.productName %>

                        </h3>

                    <% } else { %>

                        <h3 class="wishlist-product-name">

                            Product no longer available

                        </h3>

                    <% } %>


                    <!-- ================= COLOR ================= -->

                    <% if (variant) { %>

                        <p class="wishlist-product-color">

                            <%= variant.color %>

                        </p>

                    <% } else { %>

                        <p class="wishlist-product-color">

                            Variant unavailable

                        </p>

                    <% } %>


                    <!-- ================= PRICE ================= -->

                    <% if (variant) { %>

                        <div class="wishlist-price">

                            <% if (
                                variant.offerPrice &&
                                variant.offerPrice > 0 &&
                                variant.offerPrice < variant.price
                            ) { %>

                                <span class="offer-price">

                                    ₹<%= variant.offerPrice %>

                                </span>

                                <del class="original-price">

                                    ₹<%= variant.price %>

                                </del>

                            <% } else { %>

                                <span class="offer-price">

                                    ₹<%= variant.price %>

                                </span>

                            <% } %>

                        </div>

                    <% } else { %>

                        <div class="wishlist-price">

                            <span class="offer-price">

                                Not Available

                            </span>

                        </div>

                    <% } %>


                    <!-- ================= STOCK ================= -->

                    <% if (variant && variant.stock > 0) { %>

                        <p class="wishlist-stock in-stock">

                            In Stock

                        </p>

                    <% } else { %>

                        <p class="wishlist-stock out-of-stock">

                            Out of Stock

                        </p>

                    <% } %>


                


                </div>

            </div>

        <% }) %>

    </div>


<% } else { %>


    <!-- ================= EMPTY WISHLIST ================= -->

    <div class="empty-wishlist">

        <div class="empty-wishlist-icon">

            <i class="bi bi-heart"></i>

        </div>

        <h2>

            Your Wishlist is Empty

        </h2>

        <p>

            You haven't added any watches to your wishlist yet.

        </p>

        <a
            href="/user/shop"
            class="continue-shopping-btn"
        >

            Continue Shopping

        </a>

    </div>

<% } %>


</main>


<!-- ================= CONFIRMATION MODAL ================= -->

<div
    class="modal fade"
    id="removeWishlistModal"
    tabindex="-1"
    aria-labelledby="removeWishlistModalLabel"
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5
                    class="modal-title"
                    id="removeWishlistModalLabel"
                >
                    Remove from Wishlist
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                ></button>

            </div>

            <div class="modal-body text-center">

                <i
                    class="bi bi-heartbreak"
                    style="font-size: 50px;"
                ></i>

                <p class="mt-3 mb-0">
                    Do you want to remove this product
                    from your wishlist?
                </p>

            </div>

            <div class="modal-footer justify-content-center">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal"
                >
                    Cancel
                </button>

                <button
                    type="button"
                    class="btn btn-danger"
                    id="confirmRemoveWishlist"
                >
                    Yes, Remove
                </button>

            </div>

        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- ================= WISHLIST JAVASCRIPT ================= -->


<script>
document.addEventListener("DOMContentLoaded", () => {

    // ==========================================
    // ELEMENTS
    // ==========================================

    const removeButtons =
        document.querySelectorAll(".wishlist-remove-form .wishlist-remove-btn");

    const confirmRemoveButton =
        document.getElementById("confirmRemoveWishlist");

    const removeModalElement =
        document.getElementById("removeWishlistModal");


    // ==========================================
    // CHECK MODAL
    // ==========================================

    if (!removeModalElement) {
        console.log("Remove wishlist modal not found.");
        return;
    }


    // ==========================================
    // SELECTED FORM
    // ==========================================

    let selectedForm = null;


    // ==========================================
    // CLICK REMOVE BUTTON
    // ==========================================

    removeButtons.forEach(button => {

        button.addEventListener("click", () => {

            console.log("Remove button clicked");


            // Find the form
            selectedForm =
                button.closest(".wishlist-remove-form");


            if (!selectedForm) {
                console.log("Remove form not found.");
                return;
            }


            // Open Bootstrap modal
            const removeModal =
                bootstrap.Modal.getOrCreateInstance(
                    removeModalElement
                );


            removeModal.show();

        });

    });


    // ==========================================
    // CLICK YES, REMOVE
    // ==========================================

    if (confirmRemoveButton) {

        confirmRemoveButton.addEventListener("click", () => {

            console.log("Yes, Remove clicked");


            if (!selectedForm) {
                console.log("No form selected.");
                return;
            }


            // Submit the selected form
            selectedForm.submit();

        });

    }

});
</script>
