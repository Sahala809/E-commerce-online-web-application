<%- include("../partials/header") %>

<%- include("../partials/navbar") %>

<link rel="stylesheet" href="/css/product/wishlist.css">

<main class="wishlist-container">


<!-- ================= BREADCRUMB ================= -->

<div class="breadcrumb">

    <a href="/user/home">
        Home
    </a>

    <span>›</span>

    <span>
        Wishlist
    </span>

</div>


<!-- ================= WISHLIST HEADING ================= -->

<div class="wishlist-title-section">

    <h1 class="wishlist-title">
        WISHLIST
    </h1>

    <p class="wishlist-subtitle">
        Your favourite watches, all in one place
    </p>

</div>


<!-- ================= WISHLIST CONTENT ================= -->

<% if (wishlist && wishlist.items && wishlist.items.length > 0) { %>

    <div class="wishlist-grid">

        <% wishlist.items.forEach(item => { %>

            <%
                const product = item.productId;
                const variant = item.variantId;
            %>


            <!-- ================= WISHLIST CARD ================= -->

            <div class="wishlist-card">


                <!-- ================= IMAGE ================= -->

                <div class="wishlist-image">

                    <% if (
                        variant &&
                        variant.images &&
                        variant.images.length > 0
                    ) { %>

                        <img
                            src="/uploads/variants/<%= variant.images[0] %>"
                            alt="<%= product ? product.productName : 'Product unavailable' %>"
                        >

                    <% } else { %>

                        <div class="no-wishlist-image">

                            <i class="bi bi-image"></i>

                        </div>

                    <% } %>


                    <!-- ================= DELETE BUTTON ================= -->

                    <div class="wishlist-remove">

                        <% if (product && variant) { %>

                            <!--
                                NORMAL ITEM
                                Product and variant still exist
                            -->

                            <form
    action="/user/wishlist/remove/<%= product._id %>/<%= variant._id %>?_method=DELETE"
    method="POST"
>
    <button
        type="submit"
        class="wishlist-remove-btn"
        title="Remove from Wishlist"
    >
        <i class="bi bi-trash3"></i>
    </button>
</form>

                        <% } else if (item._id) { %>

                            <!--
                                UNAVAILABLE ITEM
                                Product or variant was deleted

                                Use wishlist item _id
                            -->

                            <form
                                action="/user/wishlist/remove-item/<%= item._id %>?_method=DELETE"
                                method="POST"
                            >
                                <button
                                    type="submit"
                                    class="wishlist-remove-btn"
                                    title="Remove unavailable item"
                                >
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>


                        <% } %>

                    </div>

                </div>


                <!-- ================= PRODUCT INFORMATION ================= -->

                <div class="wishlist-info">


                    <!-- ================= PRODUCT NAME ================= -->

                    <% if (product) { %>

                        <h3 class="wishlist-product-name">

                            <%= product.productName %>

                        </h3>

                    <% } else { %>

                        <h3 class="wishlist-product-name">

                            Product no longer available

                        </h3>

                    <% } %>


                    <!-- ================= COLOR ================= -->

                    <% if (variant) { %>

                        <p class="wishlist-product-color">

                            <%= variant.color %>

                        </p>

                    <% } else { %>

                        <p class="wishlist-product-color">

                            Variant unavailable

                        </p>

                    <% } %>


                    <!-- ================= PRICE ================= -->

                    <% if (variant) { %>

                        <div class="wishlist-price">

                            <% if (
                                variant.offerPrice &&
                                variant.offerPrice > 0 &&
                                variant.offerPrice < variant.price
                            ) { %>

                                <span class="offer-price">

                                    ₹<%= variant.offerPrice %>

                                </span>

                                <del class="original-price">

                                    ₹<%= variant.price %>

                                </del>

                            <% } else { %>

                                <span class="offer-price">

                                    ₹<%= variant.price %>

                                </span>

                            <% } %>

                        </div>

                    <% } else { %>

                        <div class="wishlist-price">

                            <span class="offer-price">

                                Not Available

                            </span>

                        </div>

                    <% } %>


                    <!-- ================= STOCK ================= -->

                    <% if (variant && variant.stock > 0) { %>

                        <p class="wishlist-stock in-stock">

                            In Stock

                        </p>

                    <% } else { %>

                        <p class="wishlist-stock out-of-stock">

                            Out of Stock

                        </p>

                    <% } %>


                    <!-- ================= add to cart ================= -->

                    <% if (product && variant) { %>

                       <button
                            type="button"
                            class="view-product-btn add-to-cart-btn"
                            data-product-id="<%= product._id %>"
                            data-variant-id="<%= variant._id %>"
                        >
                            Add to Cart
                        </button>

                    <% } else { %>

                        <span
                            class="view-product-btn disabled"
                        >

                            Product Unavailable

                        </span>

                    <% } %>


                </div>

            </div>

        <% }) %>

    </div>


<% } else { %>


    <!-- ================= EMPTY WISHLIST ================= -->

    <div class="empty-wishlist">

        <div class="empty-wishlist-icon">

            <i class="bi bi-heart"></i>

        </div>

        <h2>

            Your Wishlist is Empty

        </h2>

        <p>

            You haven't added any watches to your wishlist yet.

        </p>

        <a
            href="/user/shop"
            class="continue-shopping-btn"
        >

            Continue Shopping

        </a>

    </div>

<% } %>


</main>


<!-- ================= ADD TO CART CONFIRMATION MODAL ================= -->

<div
    class="modal fade"
    id="addToCartModal"
    tabindex="-1"
    aria-labelledby="addToCartModalLabel"
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">
                <h5
                    class="modal-title"
                    id="addToCartModalLabel"
                >
                    Add to Cart
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                ></button>
            </div>

            <div class="modal-body text-center">

                <i class="bi bi-cart-plus fs-1"></i>

                <p class="mt-3 mb-0">
                    Are you sure you want to add this item
                    to your cart?
                </p>

            </div>

            <div class="modal-footer justify-content-center">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal"
                >
                    Cancel
                </button>

                <button
                    type="button"
                    class="btn btn-dark"
                    id="confirmAddToCart"
                >
                    Add to Cart
                </button>

            </div>

        </div>

    </div>
</div>

<!-- ================= WISHLIST JAVASCRIPT ================= -->


<script>

document.addEventListener("DOMContentLoaded", () => {

    // =====================================================
    // ADD TO WISHLIST
    // =====================================================

    const wishlistButtons =
        document.querySelectorAll(".wishlist-btn");

    wishlistButtons.forEach(button => {

        button.addEventListener("click", async (event) => {

            event.preventDefault();
            event.stopPropagation();

            const productId =
                button.dataset.productId;

            const variantId =
                button.dataset.variantId;

            if (!productId || !variantId) {

                showWishlistPopup(
                    "Product information is unavailable."
                );

                return;
            }

            // Prevent multiple clicks
            if (button.disabled) {
                return;
            }

            button.disabled = true;

            try {

                const response = await fetch(
                    `/user/wishlist/add/${productId}/${variantId}`,
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        }
                    }
                );

                const result =
                    await response.json();

                console.log(
                    "Wishlist response:",
                    result
                );

                showWishlistPopup(
                    result.message
                );

                // -----------------------------------------
                // If successfully added
                // -----------------------------------------

                if (result.success) {

                    button.classList.add("active");

                    const icon =
                        button.querySelector("i");

                    if (icon) {

                        icon.classList.remove(
                            "bi-heart"
                        );

                        icon.classList.add(
                            "bi-heart-fill"
                        );
                    }
                }

            } catch (error) {

                console.error(
                    "Wishlist error:",
                    error
                );

                showWishlistPopup(
                    "Unable to add product to wishlist."
                );

            } finally {

                button.disabled = false;
            }

        });

    });


    // =====================================================
    // REMOVE FROM WISHLIST
    // =====================================================

    const removeForms =
        document.querySelectorAll(
            ".wishlist-remove-form"
        );

    removeForms.forEach(form => {

        form.addEventListener("submit", (event) => {

            event.preventDefault();

            showConfirmationModal(
                "Remove from Wishlist",
                "Are you sure you want to remove this item from your wishlist?",
                () => {

                    form.submit();

                }
            );

        });

    });


    // =====================================================
    // ADD TO CART CONFIRMATION
    // =====================================================

    const addToCartButtons =
        document.querySelectorAll(
            ".add-to-cart-btn"
        );

    const addToCartModalElement =
        document.getElementById(
            "addToCartModal"
        );

    let addToCartModal = null;

    if (addToCartModalElement) {

        addToCartModal =
            new bootstrap.Modal(
                addToCartModalElement
            );
    }

    const confirmAddToCart =
        document.getElementById(
            "confirmAddToCart"
        );

    let selectedProductId = null;
    let selectedVariantId = null;


    // =====================================================
    // OPEN ADD TO CART MODAL
    // =====================================================

    addToCartButtons.forEach(button => {

        button.addEventListener("click", (event) => {

            event.preventDefault();
            event.stopPropagation();

            selectedProductId =
                button.dataset.productId;

            selectedVariantId =
                button.dataset.variantId;

            if (
                !selectedProductId ||
                !selectedVariantId
            ) {

                showWishlistPopup(
                    "Product information is unavailable."
                );

                return;
            }

            if (addToCartModal) {

                addToCartModal.show();

            }

        });

    });


    // =====================================================
    // CONFIRM ADD TO CART
    // =====================================================

    if (confirmAddToCart) {

        confirmAddToCart.addEventListener(
            "click",
            async () => {

                if (
                    !selectedProductId ||
                    !selectedVariantId
                ) {

                    return;
                }

                confirmAddToCart.disabled = true;

                try {

                    /*
                     * ADD YOUR ACTUAL ADD TO CART API HERE
                     *
                     * Example:
                     *
                     * const response = await fetch(
                     *     "/user/cart/add",
                     *     {
                     *         method: "POST",
                     *         headers: {
                     *             "Content-Type": "application/json"
                     *         },
                     *         body: JSON.stringify({
                     *             productId: selectedProductId,
                     *             variantId: selectedVariantId,
                     *             quantity: 1
                     *         })
                     *     }
                     * );
                     *
                     * const result = await response.json();
                     *
                     * showWishlistPopup(result.message);
                     */

                    console.log(
                        "Product ID:",
                        selectedProductId
                    );

                    console.log(
                        "Variant ID:",
                        selectedVariantId
                    );


                    // Close modal

                    if (addToCartModal) {

                        addToCartModal.hide();

                    }

                } catch (error) {

                    console.error(
                        "ADD TO CART ERROR:",
                        error
                    );

                    if (addToCartModal) {

                        addToCartModal.hide();

                    }

                    showWishlistPopup(
                        "Unable to add product to cart."
                    );

                } finally {

                    confirmAddToCart.disabled = false;
                }

            }
        );

    }


    // =====================================================
    // CONFIRMATION MODAL
    // =====================================================

    function showConfirmationModal(
        title,
        message,
        confirmCallback
    ) {

        // Remove existing modal

        const oldModal =
            document.getElementById(
                "confirmationModal"
            );

        if (oldModal) {

            oldModal.remove();

        }


        // Create modal

        const modalHTML = `

            <div
                class="modal fade"
                id="confirmationModal"
                tabindex="-1"
                aria-hidden="true"
            >

                <div
                    class="modal-dialog modal-dialog-centered"
                >

                    <div class="modal-content">

                        <div class="modal-header">

                            <h5 class="modal-title">
                                ${title}
                            </h5>

                            <button
                                type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"
                            ></button>

                        </div>


                        <div class="modal-body text-center">

                            <i
                                class="bi bi-question-circle fs-1"
                            ></i>

                            <p class="mt-3 mb-0">
                                ${message}
                            </p>

                        </div>


                        <div
                            class="modal-footer justify-content-center"
                        >

                            <button
                                type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal"
                            >
                                Cancel
                            </button>

                            <button
                                type="button"
                                class="btn btn-dark"
                                id="confirmActionBtn"
                            >
                                Confirm
                            </button>

                        </div>

                    </div>

                </div>

            </div>

        `;


        document.body.insertAdjacentHTML(
            "beforeend",
            modalHTML
        );


        const modalElement =
            document.getElementById(
                "confirmationModal"
            );


        const modal =
            new bootstrap.Modal(
                modalElement
            );


        const confirmButton =
            document.getElementById(
                "confirmActionBtn"
            );


        // Confirm button

        confirmButton.addEventListener(
            "click",
            async () => {

                confirmButton.disabled = true;

                try {

                    await confirmCallback();

                    modal.hide();

                } catch (error) {

                    console.error(
                        "Confirmation action error:",
                        error
                    );

                    modal.hide();

                }

            }
        );


        // Remove modal after closing

        modalElement.addEventListener(
            "hidden.bs.modal",
            () => {

                if (
                    document.body.contains(
                        modalElement
                    )
                ) {

                    modalElement.remove();

                }

            },
            {
                once: true
            }
        );


        modal.show();

    }


    // =====================================================
    // WISHLIST POPUP
    // =====================================================

    function showWishlistPopup(message) {

        // Remove old popup

        const oldPopup =
            document.getElementById(
                "wishlistPopup"
            );

        if (oldPopup) {

            oldPopup.remove();

        }


        // Create popup

        const popup =
            document.createElement("div");

        popup.id =
            "wishlistPopup";

        popup.className =
            "wishlist-popup-overlay";


        popup.innerHTML = `

            <div class="wishlist-popup">

                <button
                    type="button"
                    class="wishlist-popup-close"
                >
                    &times;
                </button>


                <div class="wishlist-popup-icon">

                    <i class="bi bi-heart-fill"></i>

                </div>


                <h3>
                    Wishlist
                </h3>


                <p>
                    ${message}
                </p>


                <button
                    type="button"
                    class="wishlist-popup-btn"
                >
                    OK
                </button>

            </div>

        `;


        document.body.appendChild(
            popup
        );


        // Close button

        const closeButton =
            popup.querySelector(
                ".wishlist-popup-close"
            );

        closeButton.addEventListener(
            "click",
            () => {

                popup.remove();

            }
        );


        // OK button

        const okButton =
            popup.querySelector(
                ".wishlist-popup-btn"
            );

        okButton.addEventListener(
            "click",
            () => {

                popup.remove();

            }
        );

    }

});

</script>