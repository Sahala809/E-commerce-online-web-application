<%- include("../partials/header") %>
<%- include("../partials/navbar") %>

<link rel="stylesheet" href="/css/product/shop.css">

<!-- ================= WISHLIST POPUP ================= -->

<% if (successMessage) { %>

    <div class="wishlist-popup-overlay" id="wishlistPopup">

        <div class="wishlist-popup">

            <button
                type="button"
                class="wishlist-popup-close"
                onclick="closeWishlistPopup()"
            >
                &times;
            </button>

            <div class="wishlist-popup-icon">
                <i class="bi bi-heart-fill"></i>
            </div>

            <h3>
                Added to Wishlist
            </h3>

            <p>
                <%= successMessage %>
            </p>

            <button
                type="button"
                class="wishlist-popup-btn"
                onclick="closeWishlistPopup()"
            >
                OK
            </button>

        </div>

    </div>

<% } %>

<main class="shop-container">

    <!-- Breadcrumb -->
    <div class="breadcrumb">
        <a href="/user/home">Home</a>
        <span>›</span>
        <span>Shop</span>
    </div>


    <!-- Shop Heading -->
    <div class="shop-title-section">
        <h1 class="shop-title">SHOP</h1>

        <p class="shop-subtitle">
            Find the perfect watch for every moment
        </p>
    </div>


    <div class="shop-layout">

        <!-- ================= SIDEBAR ================= -->

        <aside class="shop-sidebar">

            <div class="filter-heading">
                <i class="bi bi-sliders"></i>
                <span>Filters</span>
            </div>


            <!-- CATEGORY -->

            <div class="filter-section">

                <div class="filter-title">
                    <span>Category</span>
                    <i class="bi bi-chevron-up"></i>
                </div>

                <% if (categories && categories.length > 0) { %>

                    <% categories.forEach(category => { %>

                        <label class="filter-option">

                            <input
                                type="checkbox"
                                name="category"
                                value="<%= category._id %>"
                            >

                            <span>
                                <%= category.categoryName %>
                            </span>

                        </label>

                    <% }) %>

                <% } else { %>

                    <small class="text-muted">
                        No categories available
                    </small>

                <% } %>

            </div>


            <!-- BRAND -->

            <div class="filter-section">

                <div class="filter-title">
                    <span>Brand</span>
                    <i class="bi bi-chevron-up"></i>
                </div>

                <small class="text-muted">
                    No brands available
                </small>

            </div>


            <!-- PRICE -->

            <div class="filter-section">

                <div class="filter-title">
                    <span>Price</span>
                    <i class="bi bi-chevron-up"></i>
                </div>

                <div class="price-values">

                    <span>₹0</span>
                    <span id="maxPriceValue">
                        ₹50,000
                    </span>

                </div>

                <input
                    type="range"
                    id="priceSlider"
                    class="price-slider"
                    min="0"
                    max="50000"
                    value="50000"
                    step="500"
                >

            </div>


            <!-- COLOR -->

            <div class="filter-section">

                <div class="filter-title">
                    <span>Color</span>
                    <i class="bi bi-chevron-up"></i>
                </div>


                <% if (colors && colors.length > 0) { %>

                    <% colors.forEach(color => { %>

                        <label class="filter-option">

                            <input
                                type="checkbox"
                                name="color"
                                value="<%= color.toLowerCase() %>"
                            >

                            <span>
                                <%= color %>
                            </span>

                        </label>

                    <% }) %>

                <% } else { %>

                    <small class="text-muted">
                        No colors available
                    </small>

                <% } %>

                <button
                    type="button"
                    id="applyFilters"
                    class="apply-filter-btn"
                >
                    Apply Filters
                </button>

            </div>

        </aside>



        <!-- ================= SHOP CONTENT ================= -->

        <section class="shop-content">


            <!-- TOP TOOLBAR -->

            <div class="shop-toolbar">

                <div class="product-count">

                    <% if (products && products.length > 0) { %>

                        <span>
                            <%= products.length %> Products
                        </span>

                    <% } else { %>

                        <span>
                            No Products
                        </span>

                    <% } %>
                </div>


                <!-- SORT -->

                <div class="sort-container">

                    <label for="sort">
                        Sort By
                    </label>

                    <select id="sort" name="sort">

                        <option value="">
                            Default
                        </option>

                        <option value="priceLow">
                            Price: Low to High
                        </option>

                        <option value="priceHigh">
                            Price: High to Low
                        </option>

                        <option value="newest">
                            Newest
                        </option>

                    </select>

                </div>

            </div>



           
           <!-- ================= PRODUCTS ================= -->

<div class="product-grid">

    <% if (products && products.length > 0) { %>

        <% products.forEach(product => { %>

            <% if (product.variant) { %>

                <div class="product-card">

                    <!-- ================= IMAGE ================= -->

                    <div class="product-image">

                        <!-- Product Detail Link -->
                        <a
                            href="/user/product/<%= product._id %>"
                            class="product-image-link"
                        >

                            <% if (
                                product.variant.images &&
                                product.variant.images.length > 0
                            ) { %>

                                <img
                                    src="/uploads/variants/<%= product.variant.images[0] %>"
                                    alt="<%= product.productName %>"
                                >

                            <% } else { %>

                                <img
                                    src="/images/no-image.png"
                                    alt="No image"
                                >

                            <% } %>

                        </a>


                        <!-- ================= WISHLIST ================= -->

                        <form
                            action="/user/wishlist/add/<%= product._id %>/<%= product.variant._id %>"
                            method="POST"
                            class="wishlist-form"
                        >

                            <button
                                type="submit"
                                class="wishlist-btn"
                                data-product-id="<%= product._id %>"
    data-variant-id="<%= product.variant._id %>"
                                title="Add to Wishlist"
                            >

                                <i class="bi bi-heart"></i>

                            </button>

                        </form>

                    </div>


                    <!-- ================= PRODUCT INFORMATION ================= -->

                    <div class="product-info">

                        <!-- Product Name -->

                        <a
                            href="/user/product/<%= product._id %>"
                            class="product-name-link"
                        >

                            <h3 class="product-name">
                                <%= product.productName %>
                            </h3>

                        </a>


                        <!-- Color -->

                        <p class="product-color">
                            <%= product.variant.color %>
                        </p>


                        <!-- Price -->

                        <div class="product-price">

                            <% if (
                                product.variant.offerPrice &&
                                product.variant.offerPrice > 0 &&
                                product.variant.offerPrice < product.variant.price
                            ) { %>

                                <span class="offer-price">
                                    ₹<%= product.variant.offerPrice %>
                                </span>

                                <del class="original-price">
                                    ₹<%= product.variant.price %>
                                </del>

                            <% } else { %>

                                <span class="offer-price">
                                    ₹<%= product.variant.price %>
                                </span>

                            <% } %>

                        </div>


                        <!-- Add To Cart -->

                        <button
                            type="button"
                            class="add-cart-btn"
                        >

                            <span>
                                Add to Cart
                            </span>

                            <i class="bi bi-cart-plus"></i>

                        </button>

                    </div>

                </div>

            <% } %>

        <% }) %>

    <% } else { %>

        <div class="no-products">

            <h3>
                No products found
            </h3>

            <p>
                Try changing your filters.
            </p>

        </div>

    <% } %>

</div>

            <!-- ================= PAGINATION ================= -->

            <div class="pagination-container">

                <% if (totalPages && totalPages > 1) { %>

                    <div class="pagination">

                        <% if (currentPage > 1) { %>

                            <a
                                href="/user/shop?page=<%= currentPage - 1 %>"
                                class="pagination-btn"
                            >
                                <i class="bi bi-chevron-left"></i>
                            </a>

                        <% } %>


                        <% for (
                            let page = 1;
                            page <= totalPages;
                            page++
                        ) { %>

                            <a
                                href="/user/shop?page=<%= page %>"
                                class="pagination-number
                                <%= page === currentPage ? 'active' : '' %>"
                            >
                                <%= page %>
                            </a>

                        <% } %>


                        <% if (currentPage < totalPages) { %>

                            <a
                                href="/user/shop?page=<%= currentPage + 1 %>"
                                class="pagination-btn"
                            >
                                <i class="bi bi-chevron-right"></i>
                            </a>

                        <% } %>

                    </div>

                <% } %>

            </div>

        </section>

    </div>

</main>


<script>

    // =========================================================
    // PRICE SLIDER
    // =========================================================

    const priceSlider =
        document.getElementById("priceSlider");

    const maxPriceValue =
        document.getElementById("maxPriceValue");


    if (priceSlider && maxPriceValue) {

        priceSlider.addEventListener("input", () => {

            const value =
                Number(priceSlider.value);

            maxPriceValue.textContent =
                `₹${value.toLocaleString("en-IN")}`;

        });

    }


    // =========================================================
    // APPLY FILTERS BUTTON
    // =========================================================

    const applyFilters =
        document.getElementById("applyFilters");


    if (applyFilters) {

        applyFilters.addEventListener("click", () => {

            // Selected categories
            const selectedCategories = [
                ...document.querySelectorAll(
                    'input[name="category"]:checked'
                )
            ].map(checkbox => checkbox.value);


            // Selected colors
            const selectedColors = [
                ...document.querySelectorAll(
                    'input[name="color"]:checked'
                )
            ].map(checkbox => checkbox.value);


            // Max price
            const maxPrice =
                priceSlider
                    ? priceSlider.value
                    : 50000;


            // Create URL parameters
            const params =
                new URLSearchParams();


            // Add categories
            selectedCategories.forEach(category => {

                params.append(
                    "category",
                    category
                );

            });


            // Add colors
            selectedColors.forEach(color => {

                params.append(
                    "color",
                    color
                );

            });


            // Add max price
            params.set(
                "maxPrice",
                maxPrice
            );


            // Redirect
            window.location.href =
                `/user/shop?${params.toString()}`;

        });

    }


    // =========================================================
    // WISHLIST BUTTON
    // =========================================================

    const wishlistButtons =
        document.querySelectorAll(".wishlist-btn");


    wishlistButtons.forEach(button => {

        button.addEventListener("click", async (event) => {

            // Stop product card/link from opening
            event.preventDefault();
            event.stopPropagation();


            const productId =
                button.dataset.productId;

            const variantId =
                button.dataset.variantId;


            // Check IDs
            if (!productId || !variantId) {

                console.error(
                    "Product ID or Variant ID is missing."
                );

                return;
            }


            try {

                const response = await fetch(
                    `/user/wishlist/add/${productId}/${variantId}`,
                    {
                        method: "POST"
                    }
                );


                const result =
                    await response.json();


                console.log(
                    "Wishlist response:",
                    result
                );


                // Show popup
                showWishlistPopup(
                    result.message
                );


                // Change heart only when successfully added
                if (result.success) {

                    const icon =
                        button.querySelector("i");

                    if (icon) {

                        icon.classList.remove(
                            "bi-heart"
                        );

                        icon.classList.add(
                            "bi-heart-fill"
                        );

                    }

                }

            } catch (error) {

                console.error(
                    "Wishlist error:",
                    error
                );


                showWishlistPopup(
                    "Unable to add product to wishlist."
                );

            }

        });

    });


    // =========================================================
    // WISHLIST POPUP
    // =========================================================

    function showWishlistPopup(message) {

        // Remove old popup if already exists
        const oldPopup =
            document.getElementById("wishlistPopup");

        if (oldPopup) {
            oldPopup.remove();
        }


        // Create popup overlay
        const popup =
            document.createElement("div");

        popup.id =
            "wishlistPopup";

        popup.className =
            "wishlist-popup-overlay";


        // Popup HTML
        popup.innerHTML = `

            <div class="wishlist-popup">

                <button
                    type="button"
                    class="wishlist-popup-close"
                    aria-label="Close"
                >
                    &times;
                </button>


                <div class="wishlist-popup-icon">

                    <i class="bi bi-heart-fill"></i>

                </div>


                <h3>
                    Wishlist
                </h3>


                <p>
                    ${message}
                </p>


                <button
                    type="button"
                    class="wishlist-popup-btn"
                >
                    OK
                </button>

            </div>

        `;


        // Add popup to body
        document.body.appendChild(popup);


        // =====================================================
        // CLOSE BUTTON
        // =====================================================

        const closeButton =
            popup.querySelector(
                ".wishlist-popup-close"
            );


        closeButton.addEventListener(
            "click",
            () => {

                popup.remove();

            }
        );


        // =====================================================
        // OK BUTTON
        // =====================================================

        const okButton =
            popup.querySelector(
                ".wishlist-popup-btn"
            );


        okButton.addEventListener(
            "click",
            () => {

                popup.remove();

            }
        );


        // =====================================================
        // CLICK OUTSIDE POPUP
        // =====================================================

        popup.addEventListener(
            "click",
            (event) => {

                if (
                    event.target === popup
                ) {

                    popup.remove();

                }

            }
        );

    }

</script>

<%- include("../partials/footer") %>