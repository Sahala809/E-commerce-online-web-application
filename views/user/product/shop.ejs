<%- include("../partials/header") %>
<%- include("../partials/navbar") %>

<link rel="stylesheet" href="/css/product/shop.css">

<!-- ================= WISHLIST POPUP ================= -->

<% if (successMessage || errorMessage) { %>

    <div class="wishlist-popup-overlay" id="wishlistPopup">

        <div class="wishlist-popup">

            <button
                type="button"
                class="wishlist-popup-close"
                onclick="closeWishlistPopup()"
            >
                &times;
            </button>

            <div class="wishlist-popup-icon">
                <i class="bi bi-heart-fill"></i>
            </div>

            <h3>
                <%= successMessage ? "Added to Wishlist" : "Wishlist" %>
            </h3>

            <p>
                <%= successMessage || errorMessage %>
            </p>

            <button
                type="button"
                class="wishlist-popup-btn"
                onclick="closeWishlistPopup()"
            >
                OK
            </button>

        </div>

    </div>

<% } %>
<main class="shop-container">

    <!-- Breadcrumb -->
    <div class="breadcrumb">
        <a href="/user/home">Home</a>
        <span>›</span>
        <span>Shop</span>
    </div>


    <!-- Shop Heading -->
    <div class="shop-title-section">
        <h1 class="shop-title">SHOP</h1>

        <p class="shop-subtitle">
            Find the perfect watch for every moment
        </p>
    </div>

    <!-- SEARCH -->
<div class="shop-search">
    <form action="/user/shop" method="GET" id="shopSearchForm">
        <div class="search-box">
            <input
                type="text"
                name="search"
                id="shopSearch"
                placeholder="Search watches..."
                value="<%= search || '' %>"
            >

            <button type="submit">
                <i class="bi bi-search"></i>
            </button>
        </div>


    </form>

    <% if (search) { %>

        <button
            type="button"
            id="clearSearch"
            class="clear-search-btn"
        >
            Clear
        </button>

    <% } %>



</div>



    <div class="shop-layout">

        <!-- ================= SIDEBAR ================= -->

        <aside class="shop-sidebar">

            <div class="filter-heading">
                <i class="bi bi-sliders"></i>
                <span>Filters</span>
            </div>


            <!-- CATEGORY -->

            <div class="filter-section">

                <div class="filter-title">
                    <span>Category</span>
                    <i class="bi bi-chevron-up"></i>
                </div>

                <% if (categories && categories.length > 0) { %>

                    <% categories.forEach(category => { %>

                        <label class="filter-option">

                            <input
    type="checkbox"
    name="category"
    value="<%= category._id %>"
    <%= Array.isArray(selectedCategories) &&
        selectedCategories.includes(category._id.toString())
        ? "checked"
        : "" %>
>

                            <span>
                                <%= category.categoryName %>
                            </span>

                        </label>

                    <% }) %>

                <% } else { %>

                    <small class="text-muted">
                        No categories available
                    </small>

                <% } %>

            </div>


            <!-- BRAND -->

            <div class="filter-section">

                <div class="filter-title">
                    <span>Brand</span>
                    <i class="bi bi-chevron-up"></i>
                </div>

                <small class="text-muted">
                    No brands available
                </small>

            </div>


            <!-- PRICE -->

            <div class="filter-section">

                <div class="filter-title">
                    <span>Price</span>
                    <i class="bi bi-chevron-up"></i>
                </div>

                <div class="price-values">

                    <span>₹0</span>
                    <span id="maxPriceValue">
                        ₹<%= Number(maxPrice || 50000).toLocaleString("en-IN") %>
                    </span>

                </div>

                <input
                    type="range"
                    id="priceSlider"
                    class="price-slider"
                    min="0"
                    max="50000"
                    value="<%= maxPrice || 50000 %>"
                    step="500"
                >

            </div>


            <!-- COLOR -->

            <div class="filter-section">

                <div class="filter-title">
                    <span>Color</span>
                    <i class="bi bi-chevron-up"></i>
                </div>


                <% if (colors && colors.length > 0) { %>

                    <% colors.forEach(color => { %>

                        <label class="filter-option">

                            <input
    type="checkbox"
    name="color"
    value="<%= color.toLowerCase() %>"
    <%= selectedColors.includes(color.toLowerCase())
        ? "checked"
        : "" %>
>

                            <span>
                                <%= color %>
                            </span>

                        </label>

                    <% }) %>

                <% } else { %>

                    <small class="text-muted">
                        No colors available
                    </small>

                <% } %>

                <button
                    type="button"
                    id="applyFilters"
                    class="apply-filter-btn"
                >
                    Apply Filters
                </button>

                <button
    type="button"
    id="clearFilters"
    class="clear-filter-btn"
>
    Clear Filters
</button>

            </div>

        </aside>



        <!-- ================= SHOP CONTENT ================= -->

        <section class="shop-content">


            <!-- TOP TOOLBAR -->

            <div class="shop-toolbar">

                

                <div class="product-count">

                    <% if (products && products.length > 0) { %>

                        <span>
                            <%= products.length %> Products
                        </span>

                    <% } else { %>

                        <span>
                            No Products
                        </span>

                    <% } %>
                </div>


                <!-- SORT -->

                <div class="sort-container">

                    <label for="sort">
                        Sort By
                    </label>

                    <select id="sort" name="sort">

    <option value="" <%= sort === "" ? "selected" : "" %>>
        Default
    </option>

    <option value="priceLow" <%= sort === "priceLow" ? "selected" : "" %>>
        Price: Low to High
    </option>

    <option value="priceHigh" <%= sort === "priceHigh" ? "selected" : "" %>>
        Price: High to Low
    </option>

    <option value="newest" <%= sort === "newest" ? "selected" : "" %>>
        Newest
    </option>

</select>

                </div>

            </div>



           
           <!-- ================= PRODUCTS ================= -->

<div class="product-grid">

    <% if (products && products.length > 0) { %>

        <% products.forEach(product => { %>

            <% if (product.variant) { %>

                <div class="product-card">

                    <!-- ================= IMAGE ================= -->

                    <div class="product-image">

                        <!-- Product Detail Link -->
                        <a
                            href="/user/product/<%= product._id %>"
                            class="product-image-link"
                        >

                            <% if (
                                product.variant.images &&
                                product.variant.images.length > 0
                            ) { %>

                                <img
                                    src="/uploads/variants/<%= product.variant.images[0] %>"
                                    alt="<%= product.productName %>"
                                >

                            <% } else { %>

                                <img
                                    src="/images/no-image.png"
                                    alt="No image"
                                >

                            <% } %>

                        </a>


                        <!-- ================= WISHLIST ================= -->

                        <form
                            action="/user/wishlist/add/<%= product._id %>/<%= product.variant._id %>"
                            method="POST"
                            class="wishlist-form"
                        >

                            <button
                                type="submit"
                                class="wishlist-btn"
                                data-product-id="<%= product._id %>"
                                data-variant-id="<%= product.variant._id || "" %>" 
                                title="Add to Wishlist"
                            >

                                <i class="bi bi-heart"></i>

                            </button>

                        </form>

                    </div>


                    <!-- ================= PRODUCT INFORMATION ================= -->

                    <div class="product-info">

                        <!-- Product Name -->

                        <a
                            href="/user/product/<%= product._id %>"
                            class="product-name-link"
                        >

                            <h3 class="product-name">
                                <%= product.productName %>
                            </h3>

                        </a>


                        <!-- Color -->

                        <p class="product-color">
                            <%= product.variant.color %>
                        </p>


                        <!-- Price -->

                        <div class="product-price">

                            <% if (
                                product.variant.offerPrice &&
                                product.variant.offerPrice > 0 &&
                                product.variant.offerPrice < product.variant.price
                            ) { %>

                                <span class="offer-price">
                                    ₹<%= product.variant.offerPrice %>
                                </span>

                                <del class="original-price">
                                    ₹<%= product.variant.price %>
                                </del>

                            <% } else { %>

                                <span class="offer-price">
                                    ₹<%= product.variant.price %>
                                </span>

                            <% } %>

                        </div>


                        

                    </div>

                </div>

            <% } %>

        <% }) %>

    <% } else { %>

        <div class="no-products">

            <h3>
                No products found
            </h3>

            <p>
                Try changing your filters.
            </p>

        </div>

    <% } %>

</div>

            <!-- ================= PAGINATION ================= -->

            <!-- ================= PAGINATION ================= -->
<div class="pagination-container">

    <% if (totalPages && totalPages > 1) { %>

        <div class="pagination">

            <!-- PREVIOUS -->
            <% if (currentPage > 1) { %>

                <a
                    href="/user/shop?<%= new URLSearchParams({
                        ...queryParams,
                        page: currentPage - 1
                    }).toString() %>"
                    class="pagination-btn"
                >
                    <i class="bi bi-chevron-left"></i>
                </a>

            <% } %>


            <!-- PAGE NUMBERS -->
            <% for (
                let page = 1;
                page <= totalPages;
                page++
            ) { %>

                <a
                    href="/user/shop?<%= new URLSearchParams({
                        ...queryParams,
                        page: page
                    }).toString() %>"
                    class="pagination-number <%= page === currentPage ? 'active' : '' %>"
                >
                    <%= page %>
                </a>

            <% } %>


            <!-- NEXT -->
            <% if (currentPage < totalPages) { %>

                <a
                    href="/user/shop?<%= new URLSearchParams({
                        ...queryParams,
                        page: currentPage + 1
                    }).toString() %>"
                    class="pagination-btn"
                >
                    <i class="bi bi-chevron-right"></i>
                </a>

            <% } %>

        </div>

    <% } %>

</div>
        </section>

    </div>

</main>


<script>

    // ========================================================= 
    // // WISHLIST POPUP 
    // // ========================================================= 
    function closeWishlistPopup() {
         const popup = 
            document.getElementById("wishlistPopup"); 
        if (popup) {
            popup.remove(); 
        } 
    }

    // =========================================================
    // PRICE SLIDER
    // =========================================================

    const priceSlider =
        document.getElementById("priceSlider");

    const maxPriceValue =
        document.getElementById("maxPriceValue");

    if (priceSlider && maxPriceValue) {

        priceSlider.addEventListener("input", () => {

            const value =
                Number(priceSlider.value);

            maxPriceValue.textContent =
                `₹${value.toLocaleString("en-IN")}`;

        });

    }


    // =========================================================
    // APPLY FILTERS
    // =========================================================

    const applyFilters =
        document.getElementById("applyFilters");

    if (applyFilters) {

        applyFilters.addEventListener("click", () => {

            const params =
                new URLSearchParams(
                    window.location.search
                );


            // =================================================
            // SEARCH
            // =================================================

            const searchInput =
                document.getElementById("shopSearch");

            const search =
                searchInput
                    ? searchInput.value.trim()
                    : "";

            if (search) {

                params.set(
                    "search",
                    search
                );

            } else {

                params.delete("search");

            }


            // =================================================
            // CATEGORY
            // =================================================

            const selectedCategories = [

                ...document.querySelectorAll(
                    'input[name="category"]:checked'
                )

            ].map(
                checkbox => checkbox.value
            );


            params.delete("category");


            selectedCategories.forEach(category => {

                params.append(
                    "category",
                    category
                );

            });


            // =================================================
            // COLOR
            // =================================================

            const selectedColors = [

                ...document.querySelectorAll(
                    'input[name="color"]:checked'
                )

            ].map(
                checkbox => checkbox.value
            );


            params.delete("color");


            selectedColors.forEach(color => {

                params.append(
                    "color",
                    color
                );

            });


            // =================================================
            // MAX PRICE
            // =================================================

            const maxPrice =
                priceSlider
                    ? priceSlider.value
                    : 50000;


            params.set(
                "maxPrice",
                maxPrice
            );


            // =================================================
            // SORT
            // =================================================

            const sort =
                document.getElementById("sort").value;


            if (sort) {

                params.set(
                    "sort",
                    sort
                );

            } else {

                params.delete("sort");

            }


            // =================================================
            // RESET TO PAGE 1
            // =================================================

            params.set(
                "page",
                "1"
            );


            // =================================================
            // REDIRECT
            // =================================================

            window.location.href =
                `/user/shop?${params.toString()}`;

        });

    }


    // =========================================================
    // CLEAR SEARCH
    // =========================================================

    const clearSearch =
        document.getElementById("clearSearch");

    if (clearSearch) {

        clearSearch.addEventListener("click", () => {

            window.location.href =
                "/user/shop";

        });

    }


    // =========================================================
    // CLEAR FILTERS
    // =========================================================

    const clearFilters =
        document.getElementById("clearFilters");

    if (clearFilters) {

        clearFilters.addEventListener("click", () => {

            const params =
                new URLSearchParams();

            const searchInput =
                document.getElementById("shopSearch");

            const search =
                searchInput
                    ? searchInput.value.trim()
                    : "";

            // Keep search
            if (search) {

                params.set(
                    "search",
                    search
                );

            }

            // Go to page 1
            params.set(
                "page",
                "1"
            );

            window.location.href =
                `/user/shop?${params.toString()}`;

        });

    }


    // =========================================================
    // SORT
    // =========================================================

    const sortSelect =
        document.getElementById("sort");

    if (sortSelect) {

        sortSelect.addEventListener("change", () => {

            const params =
                new URLSearchParams(
                    window.location.search
                );


            const sort =
                sortSelect.value;


            if (sort) {

                params.set(
                    "sort",
                    sort
                );

            } else {

                params.delete("sort");

            }


            // Sorting starts from page 1
            params.set(
                "page",
                "1"
            );


            window.location.href =
                `/user/shop?${params.toString()}`;

        });

    }

</script>

<%- include("../partials/footer") %>