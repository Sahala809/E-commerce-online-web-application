<%- include("../partials/header") %>

<%- include("../partials/navbar") %>

<link rel="stylesheet" href="/css/product/productDetail.css">


<main class="product-detail-container">

    <!-- =================================================
         BREADCRUMB
    ================================================== -->

    <div class="breadcrumb">

        <a href="/user/home">Home</a>

        <span>›</span>

        <a href="/user/shop">Shop</a>

        <span>›</span>

        <span>
            <%= product.productName %>
        </span>

    </div>



    <!-- =================================================
         PRODUCT DETAIL LAYOUT
    ================================================== -->

    <div class="product-detail-layout">


        <!-- =================================================
             LEFT : PRODUCT IMAGE GALLERY
        ================================================== -->

        <section class="product-gallery">


            <!-- THUMBNAILS -->

            <div
                class="thumbnail-list"
                id="thumbnailList"
            >

                <% if (
                    variants &&
                    variants.length > 0 &&
                    variants[0].images &&
                    variants[0].images.length > 0
                ) { %>

                    <% variants[0].images
                        .slice(0, 3)
                        .forEach((image, index) => {
                    %>

                        <div
                            class="thumbnail <%= index === 0 ? 'active' : '' %>"
                            data-image="/uploads/variants/<%= image %>"
                        >

                            <img
                                src="/uploads/variants/<%= image %>"
                                alt="<%= product.productName %>"
                            >

                        </div>

                    <% }) %>

                <% } %>

            </div>



            <!-- =================================================
                 MAIN IMAGE
            ================================================== -->

            <div
                class="main-image-box"
                id="mainImageBox"
            >

                <% if (
                    variants &&
                    variants.length > 0 &&
                    variants[0].images &&
                    variants[0].images.length > 0
                ) { %>

                    <div class="zoom-container">

                        <img
                            id="mainProductImage"
                            src="/uploads/variants/<%= variants[0].images[0] %>"
                            alt="<%= product.productName %>"
                        >

                    </div>

                <% } else { %>

                    <div class="no-main-image">
                        No Image Available
                    </div>

                <% } %>


                <!-- WISHLIST -->

                <button
                    type="button"
                    class="detail-wishlist-btn"
                    title="Add to Wishlist"
                >

                    <i class="bi bi-heart"></i>

                </button>

            </div>

        </section>



        <!-- =================================================
             RIGHT : PRODUCT DETAILS
        ================================================== -->

        <section class="product-details">


            <!-- PRODUCT NAME -->

            <h1 class="detail-product-name">

                <%= product.productName %>

            </h1>



            <!-- CATEGORY -->

            <% if (product.categoryId) { %>

                <p class="detail-category">

                    <%= product.categoryId.name %>

                </p>

            <% } %>



            <!-- RATING -->

            <div class="product-rating">

                <span class="stars">
                    ★★★★★
                </span>

                <span class="review-count">
                    (0 Reviews)
                </span>

            </div>



            <!-- =================================================
                 PRICE
            ================================================== -->

            <% if (variants && variants.length > 0) { %>

                <% const variant = variants[0]; %>

                <div class="detail-price">

                    <% if (
                        variant.offerPrice &&
                        variant.offerPrice > 0 &&
                        variant.offerPrice < variant.price
                    ) { %>

                        <span class="detail-offer-price">
                            ₹<%= variant.offerPrice %>
                        </span>

                        <del class="detail-original-price">
                            ₹<%= variant.price %>
                        </del>

                    <% } else { %>

                        <span class="detail-offer-price">
                            ₹<%= variant.price %>
                        </span>

                    <% } %>

                </div>



                <!-- COLOR -->

                <div class="detail-section">

                    <h3>
                        Color
                    </h3>

                    <div class="color-options">

                        <% variants.forEach((item, index) => { %>

                            <button
                                type="button"
                                class="color-option <%= index === 0 ? 'selected' : '' %>"
                                data-variant-id="<%= item._id %>"
                            >

                                <%= item.color %>

                            </button>

                        <% }) %>

                    </div>

                </div>



                <!-- STOCK -->

                <div class="stock-info">

                    <% if (variant.stock > 0) { %>

                        <span class="in-stock">

                            <i class="bi bi-check-circle"></i>

                            In Stock

                        </span>

                    <% } else { %>

                        <span class="out-stock">

                            Out of Stock

                        </span>

                    <% } %>

                </div>

            <% } %>



            <!-- =================================================
                 DESCRIPTION
            ================================================== -->

            <div class="detail-description">

                <h3>
                    Description
                </h3>

                <p>
                    <%= product.description %>
                </p>

            </div>



            <!-- =================================================
                 QUANTITY
            ================================================== -->

            <div class="quantity-section">

                <h3>
                    Quantity
                </h3>

                <div class="quantity-control">

                    <button
                        type="button"
                        id="decreaseQuantity"
                    >
                        −
                    </button>

                    <span id="quantity">
                        1
                    </span>

                    <button
                        type="button"
                        id="increaseQuantity"
                    >
                        +
                    </button>

                </div>

            </div>



            <!-- =================================================
                 ADD TO CART
            ================================================== -->

            <div class="detail-actions">

                <form
                    action="/user/cart"
                    method="POST"
                >

                    <input
                        type="hidden"
                        name="productId"
                        value="<%= product._id %>"
                    >

                    <input
                        type="hidden"
                        name="variantId"
                        id="selectedVariantId"
                        value="<%= variants.length > 0 ? variants[0]._id : '' %>"
                    >

                    <input
                        type="hidden"
                        name="quantity"
                        id="cartQuantity"
                        value="1"
                    >

                    <button
                        type="submit"
                        class="detail-add-cart"
                    >

                        <i class="bi bi-cart-plus"></i>

                        Add to Cart

                    </button>

                </form>

            </div>



            <!-- =================================================
                 WISHLIST
            ================================================== -->

            <div class="detail-wishlist-link">

                <button type="button">

                    <i class="bi bi-heart"></i>

                    Add to Wishlist

                </button>

            </div>


        </section>

    </div>



    <!-- =================================================
         RELATED PRODUCTS
    ================================================== -->

    <% if (
        relatedProducts &&
        relatedProducts.length > 0
    ) { %>

        <section class="related-products-section">


            <!-- HEADER -->

            <div class="related-products-header">

                <h2>
                    Related Products
                </h2>

                <p>
                    You may also like these products
                </p>

            </div>



            <!-- PRODUCTS GRID -->

            <div class="related-products-grid">

                <% relatedProducts.forEach(item => { %>

                    <div class="related-product-card">


                        <!-- =================================================
                             PRODUCT IMAGE
                        ================================================== -->

                        <a
                            href="/user/product/<%= item._id %>"
                            class="related-product-image"
                        >

                            <% if (
                                item.variant &&
                                item.variant.images &&
                                item.variant.images.length > 0
                            ) { %>

                                <img
                                    src="/uploads/variants/<%= item.variant.images[0] %>"
                                    alt="<%= item.productName %>"
                                >

                            <% } else { %>

                                <div class="no-related-image">
                                    No Image
                                </div>

                            <% } %>

                        </a>



                        <!-- =================================================
                             PRODUCT INFORMATION
                        ================================================== -->

                        <div class="related-product-info">


                            <!-- CATEGORY -->

                            <% if (item.categoryId) { %>

                                <p class="related-category">

                                    <%= item.categoryId.name %>

                                </p>

                            <% } %>



                            <!-- PRODUCT NAME -->

                            <h3>

                                <a
                                    href="/user/product/<%= item._id %>"
                                >

                                    <%= item.productName %>

                                </a>

                            </h3>



                            <!-- =================================================
                                 PRICE
                            ================================================== -->

                            <% if (item.variant) { %>

                                <div class="related-price">

                                    <% if (
                                        item.variant.offerPrice &&
                                        item.variant.offerPrice > 0 &&
                                        item.variant.offerPrice < item.variant.price
                                    ) { %>

                                        <span class="offer-price">

                                            ₹<%= item.variant.offerPrice %>

                                        </span>

                                        <del>

                                            ₹<%= item.variant.price %>

                                        </del>

                                    <% } else { %>

                                        <span class="offer-price">

                                            ₹<%= item.variant.price %>

                                        </span>

                                    <% } %>

                                </div>

                            <% } %>



                            <!-- VIEW PRODUCT -->

                            <a
                                href="/user/product/<%= item._id %>"
                                class="view-product-btn"
                            >

                                View Product

                            </a>

                        </div>

                    </div>

                <% }) %>

            </div>

        </section>

    <% } %>



</main>



<!-- =================================================
     JAVASCRIPT DATA
================================================== -->

<script>

    const variants = <%- JSON.stringify(variants || []) %>;

</script>


<script src="/js/product/productDetail.js"></script>


<%- include("../partials/footer") %>