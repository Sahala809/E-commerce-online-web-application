<%- include("../partials/header") %>

<%- include("../partials/navbar") %>

<link
    rel="stylesheet"
    href="/css/userOrders/orderSuccess.css"
>


<main class="order-success-page">

    <div class="success-container">

        <div class="success-icon">
            ✓
        </div>


        <h1>
            Order Placed Successfully!
        </h1>


        <p class="success-message">
            Thank you for your purchase.
            Your order has been placed successfully.
        </p>


        <div class="order-info">

            <div class="info-row">

                <span>
                    Order ID
                </span>

                <strong>
                    #<%= orderId %>
                </strong>

            </div>


            <div class="info-row">

                <span>
                    Payment Method
                </span>

                <strong>
                    Cash on Delivery
                </strong>

            </div>


            <div class="info-row">

                <span>
                    Order Status
                </span>

                <strong class="status">
                    Placed
                </strong>

            </div>

        </div>


        <div class="success-actions">

            <a
                href="/user/orders"
                class="btn-primary"
            >
                View My Orders
            </a>


            <a
                href="/user/shop"
                class="btn-outline"
            >
                Continue Shopping
            </a>

        </div>

    </div>

</main>