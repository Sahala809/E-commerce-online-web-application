 
<%- include("../partials/header") %>
<%- include("../partials/navbar") %>

<link rel="stylesheet" href="/css/profile/sidebar.css">
<link rel="stylesheet" href="/css/userWallet/wallet.css">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="wallet-container">

    <!-- LEFT SIDEBAR -->
    <%- include("../partials/profileSidebar") %>

    <!-- RIGHT CONTENT -->
    <section class="wallet-content">

        <div class="content-header">
            <h2>My Wallet</h2>
            <p>Manage your wallet balance and transaction history.</p>
        </div>

        <!-- WALLET BALANCE -->
        <div class="wallet-balance-card">

            <div class="balance-details">
                <p>Available Balance</p>
                <h2>₹<%= Number(wallet.balance || 0).toFixed(2) %></h2>
            </div>

            <div class="wallet-icon">
                <i class="bi bi-wallet2"></i>
            </div>

        </div>

        <!-- TRANSACTION HISTORY -->
        <div class="transaction-section">

            <h3>Transaction History</h3>

            <% if (wallet.transactions && wallet.transactions.length > 0) { %>

                <div class="transaction-list">

                    <% [...wallet.transactions].reverse().forEach(transaction => { %>

                        <div class="transaction-item">

                            <div class="transaction-icon <%= transaction.type === 'CREDIT' ? 'credit-icon' : 'debit-icon' %>">
                                <i class="bi <%= transaction.type === 'CREDIT' ? 'bi-arrow-down-left' : 'bi-arrow-up-right' %>"></i>
                            </div>

                            <div class="transaction-details">
                                <h4><%= transaction.description %></h4>
                                <p><%= new Date(transaction.date).toLocaleDateString("en-IN") %></p>
                            </div>

                            <div class="transaction-amount">
                                <h4 class="<%= transaction.type === 'CREDIT' ? 'credit-amount' : 'debit-amount' %>">
                                    <%= transaction.type === 'CREDIT' ? '+' : '-' %>₹<%= Number(transaction.amount).toFixed(2) %>
                                </h4>
                                <span><%= transaction.status %></span>
                            </div>

                        </div>

                    <% }) %>

                </div>

            <% } else { %>

                <div class="empty-wallet">
                    <i class="bi bi-wallet2"></i>
                    <h3>No Transactions Yet</h3>
                    <p>Your wallet transactions will appear here.</p>
                </div>

            <% } %>

        </div>

    </section>

</div>

<div class="profile-bottom">
    CHRONIX • Terms & Conditions • Privacy Policy
</div>

</body>
</html>
