<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>

    <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <link rel="stylesheet" href="/css/login.css">

   </head>

<body>

<div class="container-fluid">

    <div class="row justify-content-center align-items-center vh-100">

        <div class="col-lg-10">

            <div class="card shadow border-0">

                <div class="row g-0">

                    <!-- Left Image -->

                    <div class="col-md-6">

                        <img
                        src="/images/signup/login.jpg"
                        class="img-fluid h-100 w-100"
                        style="object-fit:cover;"
                        alt="login">

                    </div>

                    <!-- Right -->

                    <div class="col-md-6">

                        <div class="p-5">

                            <h1 class="text-center mb-5">
                                CHRONIX
                            </h1>

                            <h3 class="mb-4">
                                Sign In To CHRONIX
                            </h3>

                            <!-- Google -->

                            <div class="mb-4">

                                <a href="/user/auth/google" class="btn btn-outline-primary w-100">

                                    <img
                                    src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg"
                                    width="22">

                                     with Google

                                </a>

                            </div>

                            <div class="text-center mb-4">

                                <h4>— OR —</h4>

                            </div>

                            

                            <% if(successMessage){ %>
                                <div class="alert alert-success">
                                    <%= successMessage %>
                                </div>
                            <% } %>

                            <% if(errorMessage){ %>
                                <div class="alert alert-danger">
                                    <%= errorMessage %>
                                </div>
                            <% } %>

                            <form action="/user/login" method="POST" autocomplete="off" novalidate>

                                <div class="mb-3">

                                    <input
                                    type="email"
                                    id="email"
                                    class="form-control"
                                    name="email"
                                    autocomplete="email"
                                    placeholder="Email"
                                    value="<%= formData?.email || '' %>"
                                    >
                                    <% if (errors && errors.email) { %>
                                        <small class="text-danger" id="emailError">
                                            <%= errors.email %>
                                        </small>
                                    <% } %>

                                </div>

                                <div class="mb-4">

                                    <div class="password-box">
                                        
                                        <input
                                        type="password"
                                        id="password"
                                        class="form-control"
                                        name="password"
                                        autocomplete="new-password"
                                        placeholder="Password"
                                        >
                                    
                                    <i class="bi bi-eye-slash toggle-password"></i>
                                    
                                    </div> 
                                    </div>

                                    
                                    <% if (errors && errors.password) { %>
                                        <small class="text-danger" id="passwordError">
                                            <%= errors.password %>
                                        </small>
                                    <% } %>

                                </div>

                                <button
                                type="submit"
                                class="btn login-button">
                                
                                    Login

                                </button>

                            </form>

                            <div class="text-center mt-4">

                                <p class="a-link">

                                    Don't have an account?

                                    <a href="/user/signup">
                                        Sign Up
                                    </a>

                                </p>
                                <p class="a-link">

                                    <a href="/user/forgot-password">

                                    Forgot Password?

                                    </a>
                                </p>
                                

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
<script>
    setTimeout(() => {

    document.querySelector(".alert")?.remove();

}, 3000);
// ========================================
// Remove field errors when user starts typing
// ========================================

const emailInput = document.getElementById("email");
const passwordInput = document.getElementById("password");


// ========================================
// Email
// ========================================

if (emailInput) {

    emailInput.addEventListener("input", function () {

        const errorElement = document.getElementById("emailError");

        if (!errorElement) {
            return;
        }

        // Remove error when user starts entering email
        if (this.value.trim() !== "") {
            errorElement.remove();
        }

    });
}


// ========================================
// Password
// ========================================

if (passwordInput) {

    passwordInput.addEventListener("input", function () {

        const errorElement = document.getElementById("passwordError");

        if (!errorElement) {
            return;
        }

        // Remove error when user starts entering password
        if (this.value.trim() !== "") {
            errorElement.remove();
        }

    });
}


document.querySelectorAll(".toggle-password").forEach(icon => {

    icon.addEventListener("click", function () {

        const input = this.previousElementSibling;

        if (input.type === "password") {
            input.type = "text";
            this.classList.replace("bi-eye-slash", "bi-eye");
        } else {
            input.type = "password";
            this.classList.replace("bi-eye", "bi-eye-slash");
        }

    });

});


</script>
</body>
</html>