<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Verify OTP</title>

    <link rel="stylesheet" href="/css/verifyOtp.css">

</head>

<body>

<div class="container">

    <div class="left">

        <img src="/images/signup/login.jpg" alt="Watch">

    </div>

    <div class="right">

        <h1 class="logo">CHRONIX</h1>

        <div class="card">

            <h2>Verify OTP</h2>

            <p>
                Enter the 6-digit verification code sent to your email.
            </p>

            <% if (error) { %>
                <div class="alert alert-danger">
                    <%= error %>
                </div>
            <% } %>

           <form action="/user/forgot-password/verify-otp" method="POST" novalidate>

                <div class="otp-boxes">

                    <input type="text" maxlength="1" class="otp">
                    <input type="text" maxlength="1" class="otp">
                    <input type="text" maxlength="1" class="otp">
                    <input type="text" maxlength="1" class="otp">
                    <input type="text" maxlength="1" class="otp">
                    <input type="text" maxlength="1" class="otp">

                </div>

                <input type="hidden" name="otp" id="fullOtp">

                <p id="timer">01:00</p>

                <button class="btn">
                    Verify OTP
                </button>

            </form>

            <div id="resendArea" style="display: none;">

                <p>
                    Didn't receive the code?
                </p>

                <form action= "/user/forgot-password/resend-otp" method="POST" novalidate>

                    <button type="submit" class="linkBtn" >
                        Resend OTP
                    </button>

                </form>

            </div>

            <div
    id="otpTimerData"
    data-expired="<%= otpExpired %>"
    data-expires-at="<%= expiresAt || 0 %>"
    style="display: none;"
></div>


            <a href="/user/login" class="back">
                ← Back to Login
            </a>

        </div>

    </div>

</div>

<script>

const boxes=document.querySelectorAll(".otp");
const fullOtp = document.getElementById("fullOtp");

boxes.forEach((box,index)=>{

    box.addEventListener("input",()=>{

        if(box.value.length===1 && index<boxes.length-1){

            boxes[index+1].focus();

        }

        fullOtp.value= [...boxes].map(i=>i.value).join("");

    });

    box.addEventListener("keydown",(e)=>{

        if(e.key==="Backspace" && !box.value && index>0){

            boxes[index-1].focus();

        }

    });

});


const timer = document.getElementById("timer");
const resend = document.getElementById("resendArea");


// Get values from Express/EJS
const otpExpired =
    <%= typeof otpExpired !== "undefined" ? otpExpired : false %>;

const expiresAt =
    <%= typeof expiresAt !== "undefined" && expiresAt ? expiresAt : 0 %>;


// ========================================
// OTP ALREADY EXPIRED / NOT AVAILABLE
// ========================================

if (otpExpired || !expiresAt) {

    timer.style.display = "none";
    resend.style.display = "block";

}


// ========================================
// OTP STILL VALID
// ========================================

else {

    resend.style.display = "none";


    // ========================================
    // UPDATE TIMER FUNCTION
    // ========================================

    function updateTimer() {

        const remaining = Math.max(
            0,
            Math.floor((expiresAt - Date.now()) / 1000)
        );


        const min = Math.floor(remaining / 60);

        const sec = remaining % 60;


        timer.innerHTML =
            `${String(min).padStart(2, "0")}:${String(sec).padStart(2, "0")}`;


        // ========================================
        // OTP EXPIRED
        // ========================================

        if (remaining <= 0) {

            clearInterval(count);

            timer.style.display = "none";

            resend.style.display = "block";

        }

    }


    // ========================================
    // SHOW CORRECT TIME IMMEDIATELY
    // ========================================

    updateTimer();


    // ========================================
    // THEN UPDATE EVERY SECOND
    // ========================================

    const count = setInterval(updateTimer, 1000);

}
</script>
<!-- <script src="/js/auth/forgotOtp.js"></script> -->
</body>
</html>