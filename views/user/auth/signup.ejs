<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/signup.css">
</head>

<body>

<div class="container-fluid vh-100 d-flex align-items-center justify-content-center">

    <div class="signup-card row">

        <!-- Left Image -->

        <div class="col-md-6">

            <img
            src="/images/signup/login.jpg"
            class="img-fluid h-100 w-100"
            style="object-fit:cover;"
            alt="login">

        </div>

        <!-- Right -->
        <div class="col-md-6 right-side">

            <h1 class="logo">
                CHRONIX
            </h1>

            <h2>Create Account</h2>

            <div class="mb-4">

                    <a href="/user/auth/google" class="btn btn-outline-primary w-100">

                        <img
                        src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg"
                        width="22">

                        Continue with Google

                    </a>

                </div>

            <div class="divider">
                <span>OR</span>
            </div>

            <% if (error && error.general) { %>
                <div class="alert alert-danger">
                    <%= error.general %>
                </div>
            <% } %>

            <form id="signupForm" action="/user/signup" method="POST" autocomplete="off" novalidate>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <input type="text" 
                            id="name"
                            name="name" 
                            class="form-control" 
                            value="<%= formData ? formData.name : '' %>"
                            placeholder="Full Name">
                        <% if (error && error.name) { %>
                            <small class="text-danger">
                                <%= error.name %>
                            </small>
                        <% } %>

                    </div>

                    <div class="col-md-6 mb-3">

                        <input
                            type="email"
                            id="email"
                            class="form-control"
                            name="email"
                            autocomplete="email"
                            value="<%= formData ? formData.email : '' %>"
                            placeholder="Email Address">
                        <% if(error && error.email) { %>
                         <small class="text-danger">
                                <%= error.email %>
                            </small>
                        <% } %>
                    </div>

                    <div class="col-md-6 mb-3">

                        <input
                            type="text"
                            id="phone"
                            class="form-control"
                            name="phone"
                            value="<%= formData ? formData.phone : '' %>"
                            placeholder="Phone Number">
                        <% if (error && error.phone) { %>
                        <small class="text-danger">
                            <%= error.phone %>
                        </small>
                        <% } %>
                    </div>

                    <div class="col-md-6 mb-3">

                        <input
                            type="text"
                            id="referral"
                            class="form-control"
                            name="referral"
                            value="<%= formData ? formData.referral : '' %>"
                            placeholder="Referral Code (Optional)">

                    </div>

                    <div class="col-md-6 mb-3 password-box">

                        <input
                            id="password"
                            type="password"
                            class="form-control"
                            name="password"
                            autocomplete="new-password"
                            placeholder="Password">

                           

                        <i class="bi bi-eye-slash toggle-password"></i>
                    
                            <% if (error && error.password) { %>
                                <small class="text-danger">
                                    <%= error.password %>
                                </small>
                            <% } %>
                        
                    </div>

                    <div class="col-md-6 mb-3 password-box">

                        <input
                            id="confirmPassword"
                            type="password"
                            class="form-control"
                            name="confirmPassword"
                            placeholder="Confirm Password">

                        <i class="bi bi-eye-slash toggle-password"></i>

                    

                            <% if (error && error.confirmPassword) { %>
                                <small class="text-danger">
                                    <%= error.confirmPassword %>
                                </small>
                            <% } %>

                        

                    </div>

                </div>

                <button class="btn btn-dark w-100 signup-btn">
                    Create Account
                </button>

            </form>

            <p class="login-link">
                Already have an account?
                <a href="/user/login">Login</a>
            </p>

        </div>

    </div>

</div>

<script src="/js/signup.js"></script>

</body>
</html>