
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chronix Admin Login</title>

    <link rel="stylesheet" href="/css/admin/login.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="login-container">

    <div class="login-card">

        <h2>CHRONIX</h2>
        <h5>Admin Login</h5>

        

        <form action="/admin/login" method="POST" novalidate autocomplete="off">

            <div class="mb-3">

                <% if(message){ %>

                    <div class="alert alert-danger">
                        <%= message %>
                    </div>

                <% } %>

                <label>Email</label>

                <input
                    type="email"
                    name="email"
                    autocomplete="off"
                    class="form-control"
                    value="<%= formData?.email || '' %>">

                <% if (errors?.email) { %>
                    <p class="error"><%= errors.email %></p>
                <% } %>

            </div>

            <div class="mb-3">

                <label>Password</label>

                <input
                    type="password"
                    name="password"
                    autocomplete="new-password"
                    class="form-control">

                <% if (errors?.password) { %>
                    <p class="error"><%= errors.password %></p>
                <% } %>

            </div>

            <button
                type="submit"
                class="btn btn-dark w-100">

                Login

            </button>

        </form>

    </div>

</div>

</body>
</html>