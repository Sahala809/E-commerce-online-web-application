
<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/admin/offer.css">

<div class="wrapper">
    <%- include("../partials/sidebar") %>

    <div class="flex-grow-1">
        <%- include("../partials/navbar", { pageTitle: "Offer Management" }) %>

        <div class="container-fluid mt-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                <div class="page-title">
                    <h1>Offer Management</h1>
                    <p>Create and manage variant, product, and category offers.</p>
                </div>

                <button type="button" class="btn add-btn"
                    data-bs-toggle="modal" data-bs-target="#addOfferModal">
                    <i class="bi bi-plus-circle me-2"></i> Add Offer
                </button>
            </div>

            <% if (successMessage) { %>
                <div class="alert alert-success"><%= successMessage %></div>
            <% } %>

            <% if (errorMessage) { %>
                <div class="alert alert-danger"><%= errorMessage %></div>
            <% } %>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="offer-stat-card">
                        <p>Total Offers</p>
                        <h3><%= totalOffers %></h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="offer-stat-card">
                        <p>Active Offers</p>
                        <h3 class="text-success"><%= activeOffers %></h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="offer-stat-card">
                        <p>Inactive Offers</p>
                        <h3 class="text-danger"><%= inactiveOffers %></h3>
                    </div>
                </div>
            </div>

           


<div class="offer-toolbar mb-4">
    <form action="/admin/offers" method="GET"
        class="d-flex gap-2 flex-wrap align-items-center">

        <input
            type="text"
            name="search"
            class="form-control"
            placeholder="Search offer name..."
            value="<%= search || '' %>"
            aria-label="Search offer name"
        >

        <select
            name="type"
            class="form-select"
            onchange="this.form.submit()">

            <option value="">All Types</option>

            <option value="VARIANT"
                <%= type === "VARIANT" ? "selected" : "" %>>
                Variant
            </option>

            <option value="PRODUCT"
                <%= type === "PRODUCT" ? "selected" : "" %>>
                Product
            </option>

            <option value="CATEGORY"
                <%= type === "CATEGORY" ? "selected" : "" %>>
                Category
            </option>
        </select>

        <% if ((search && search.trim()) || type) { %>
            <a href="/admin/offers"
                class="btn btn-outline-secondary">
                <i class="bi bi-x-circle me-1"></i> Clear
            </a>
        <% } %>

    </form>
</div>



            <div class="table-responsive offer-table-card">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Offer Name</th>
                            <th>Offer Type</th>
                            <th>Target</th>
                            <th>Discount</th>
                            <th>Validity</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (offers && offers.length > 0) { %>
                            <% offers.forEach(offer => { %>
                                <tr>
                                    <td><strong><%= offer.offerName %></strong></td>
                                    <td><span class="offer-type"><%= offer.offerType %></span></td>
                                    <td>
                                        <% if (offer.offerType === "VARIANT") { %>
                                            <%= offer.variantId ? (offer.variantId.color || "Variant") : "—" %>
                                        <% } else if (offer.offerType === "PRODUCT") { %>
                                            <%= offer.productId ? offer.productId.productName : "—" %>
                                        <% } else { %>
                                            <%= offer.categoryId ? offer.categoryId.categoryName : "—" %>
                                        <% } %>
                                    </td>
                                    <td><strong><%= offer.discountPercentage %>%</strong></td>
                                    <td>
                                        <small>
                                            <%= new Date(offer.startDate).toLocaleDateString() %>
                                            –
                                            <%= new Date(offer.endDate).toLocaleDateString() %>
                                        </small>
                                    </td>
                                    <td>
                                        <% if (offer.isActive) { %>
                                            <span class="badge bg-success">Active</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary">Inactive</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
    <div class="dropdown">
        <button
            class="btn btn-sm btn-light action-btn"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="Offer actions">
            <i class="bi bi-three-dots-vertical"></i>
        </button>

        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <button
    type="button"
    class="dropdown-item edit-offer-btn"
    data-bs-toggle="modal"
    data-bs-target="#editOfferModal"
    data-id="<%= offer._id %>"
    data-name="<%= offer.offerName %>"
    data-type="<%= offer.offerType %>"
    data-variant="<%= offer.variantId ? offer.variantId._id : '' %>"
    data-product="<%= offer.productId ? offer.productId._id : '' %>"
    data-category="<%= offer.categoryId ? offer.categoryId._id : '' %>"
    data-discount="<%= offer.discountPercentage %>"
    data-start="<%= new Date(offer.startDate).toISOString().slice(0, 16) %>"
    data-end="<%= new Date(offer.endDate).toISOString().slice(0, 16) %>">
    <i class="bi bi-pencil me-2"></i> Edit
</button>
            </li>

            
<li>
    <form action="/admin/offers/<%= offer._id %>/toggle-status"
          method="POST">
        <button type="submit" class="dropdown-item">
            <i class="bi bi-power me-2"></i>
            <%= offer.isActive ? "Deactivate" : "Activate" %>
        </button>
    </form>
</li>


            <li><hr class="dropdown-divider"></li>

            <li>
                
<button
    type="button"
    class="dropdown-item text-danger delete-offer-btn"
    data-id="<%= offer._id %>"
    data-name="<%= offer.offerName %>"
    data-bs-toggle="modal"
    data-bs-target="#deleteOfferModal">
    <i class="bi bi-trash me-2"></i> Delete
</button>

            </li>
        </ul>
    </div>
</td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    No offers found.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (totalPages > 1) { %>
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        <% for (let p = 1; p <= totalPages; p++) { %>
                            <li class="page-item <%= currentPage === p ? 'active' : '' %>">
                                <a class="page-link"
                                    href="/admin/offers?page=<%= p %>&search=<%= encodeURIComponent(search || '') %>&type=<%= encodeURIComponent(type || '') %>"
                                    <%= p %>
                                </a>
                            </li>
                        <% } %>
                    </ul>
                </nav>
            <% } %>
        </div>
    </div>
</div>

<!-- Add Offer Modal -->
<div class="modal fade" id="addOfferModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form action="/admin/offers/create" method="POST" id="addOfferForm">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Offer</h5>
                    <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Offer Name</label>
                        <input type="text" name="offerName" class="form-control"
                            required maxlength="100"
                            value="<%= formData.offerName || '' %>">
                        <% if (validationErrors.offerName) { %>
                            <small class="text-danger"><%= validationErrors.offerName %></small>
                        <% } %>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Offer Type</label>
                        <select name="offerType" id="offerType" class="form-select" required>
                            <option value="">Select offer type</option>
                            <option value="VARIANT" <%= formData.offerType === "VARIANT" ? "selected" : "" %>>Variant Offer</option>
                            <option value="PRODUCT" <%= formData.offerType === "PRODUCT" ? "selected" : "" %>>Product Offer</option>
                            <option value="CATEGORY" <%= formData.offerType === "CATEGORY" ? "selected" : "" %>>Category Offer</option>
                        </select>
                        <% if (validationErrors.offerType) { %>
                            <small class="text-danger"><%= validationErrors.offerType %></small>
                        <% } %>
                    </div>

                    <div class="mb-3 target-field" id="variantField">
                        <label class="form-label">Select Variant</label>
                        <select name="variantId" class="form-select">
                            <option value="">Select variant</option>
                            <% variants.forEach(variant => { %>
                                <option value="<%= variant._id %>"
                                    <%= String(formData.variantId || "") === String(variant._id) ? "selected" : "" %>>
                                    <%= variant.productId ? variant.productId.productName : "Product" %>
                                    — <%= variant.color %> — ₹<%= variant.price %>
                                </option>
                            <% }) %>
                        </select>
                        <% if (validationErrors.variantId) { %>
                            <small class="text-danger"><%= validationErrors.variantId %></small>
                        <% } %>
                    </div>

                    <div class="mb-3 target-field" id="productField">
                        <label class="form-label">Select Product</label>
                        <select name="productId" class="form-select">
                            <option value="">Select product</option>
                            <% products.forEach(product => { %>
                                <option value="<%= product._id %>"
                                    <%= String(formData.productId || "") === String(product._id) ? "selected" : "" %>>
                                    <%= product.productName %>
                                </option>
                            <% }) %>
                        </select>
                        <% if (validationErrors.productId) { %>
                            <small class="text-danger"><%= validationErrors.productId %></small>
                        <% } %>
                    </div>

                    <div class="mb-3 target-field" id="categoryField">
                        <label class="form-label">Select Category</label>
                        <select name="categoryId" class="form-select">
                            <option value="">Select category</option>
                            <% categories.forEach(category => { %>
                                <option value="<%= category._id %>"
                                    <%= String(formData.categoryId || "") === String(category._id) ? "selected" : "" %>>
                                    <%= category.categoryName %>
                                </option>
                            <% }) %>
                        </select>
                        <% if (validationErrors.categoryId) { %>
                            <small class="text-danger"><%= validationErrors.categoryId %></small>
                        <% } %>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Discount Percentage (%)</label>
                        <input type="number" name="discountPercentage"
                            class="form-control" min="1" max="99" step="1"
                            required value="<%= formData.discountPercentage || '' %>">
                        <% if (validationErrors.discountPercentage) { %>
                            <small class="text-danger"><%= validationErrors.discountPercentage %></small>
                        <% } %>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Start Date</label>
                            <input type="datetime-local" name="startDate"
                                class="form-control" required
                                value="<%= formData.startDate || '' %>">
                            <% if (validationErrors.startDate) { %>
                                <small class="text-danger"><%= validationErrors.startDate %></small>
                            <% } %>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">End Date</label>
                            <input type="datetime-local" name="endDate"
                                class="form-control" required
                                value="<%= formData.endDate || '' %>">
                            <% if (validationErrors.endDate) { %>
                                <small class="text-danger"><%= validationErrors.endDate %></small>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark">Create Offer</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- Edit Offer Modal -->
<div class="modal fade" id="editOfferModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form action="" method="POST" id="editOfferForm">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Offer</h5>
                    <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Offer Name</label>
                        <input type="text" name="offerName"
                            id="editOfferName" class="form-control"
                            maxlength="100" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Offer Type</label>
                        <select name="offerType" id="editOfferType"
                            class="form-select" required>
                            <option value="VARIANT">Variant Offer</option>
                            <option value="PRODUCT">Product Offer</option>
                            <option value="CATEGORY">Category Offer</option>
                        </select>
                    </div>

                    <div class="mb-3" id="editVariantField">
                        <label class="form-label">Select Variant</label>
                        <select name="variantId" id="editVariantId" class="form-select">
                            <option value="">Select variant</option>
                            <% variants.forEach(variant => { %>
                                <option value="<%= variant._id %>">
                                    <%= variant.productId ? variant.productId.productName : "Product" %>
                                    — <%= variant.color %> — ₹<%= variant.price %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="mb-3" id="editProductField">
                        <label class="form-label">Select Product</label>
                        <select name="productId" id="editProductId" class="form-select">
                            <option value="">Select product</option>
                            <% products.forEach(product => { %>
                                <option value="<%= product._id %>">
                                    <%= product.productName %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="mb-3" id="editCategoryField">
                        <label class="form-label">Select Category</label>
                        <select name="categoryId" id="editCategoryId" class="form-select">
                            <option value="">Select category</option>
                            <% categories.forEach(category => { %>
                                <option value="<%= category._id %>">
                                    <%= category.categoryName %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Discount Percentage (%)</label>
                        <input type="number" name="discountPercentage"
                            id="editDiscount" class="form-control"
                            min="1" max="99" step="1" required>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Start Date</label>
                            <input type="datetime-local" name="startDate"
                                id="editStartDate" class="form-control" required>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">End Date</label>
                            <input type="datetime-local" name="endDate"
                                id="editEndDate" class="form-control" required>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>



<!-- Delete Offer Confirmation Modal -->
<div class="modal fade" id="deleteOfferModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="deleteOfferForm" method="POST" action="">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Offer</h5>
                    <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">
                        Are you sure you want to delete
                        <strong id="deleteOfferName"></strong>?
                    </p>
                    <small class="text-danger">
                        This action cannot be undone.
                    </small>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">Cancel</button>

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Delete Offer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>



<script>
document.addEventListener("DOMContentLoaded", () => {
    // Add Offer Modal
    const offerType = document.getElementById("offerType");

    const targetFields = {
        VARIANT: document.getElementById("variantField"),
        PRODUCT: document.getElementById("productField"),
        CATEGORY: document.getElementById("categoryField")
    };

    function updateTargetFields() {
        Object.entries(targetFields).forEach(([type, field]) => {
            const select = field.querySelector("select");
            const selected = offerType.value === type;

            field.style.display = selected ? "" : "none";
            select.disabled = !selected;
            select.required = selected;
        });
    }

    offerType.addEventListener("change", updateTargetFields);
    updateTargetFields();

    // Edit Offer Modal
    const editForm = document.getElementById("editOfferForm");
    const editType = document.getElementById("editOfferType");

    const editFields = {
        VARIANT: document.getElementById("editVariantField"),
        PRODUCT: document.getElementById("editProductField"),
        CATEGORY: document.getElementById("editCategoryField")
    };

    function updateEditTargetFields() {
        Object.entries(editFields).forEach(([type, field]) => {
            const select = field.querySelector("select");
            const selected = editType.value === type;

            field.style.display = selected ? "" : "none";
            select.disabled = !selected;
            select.required = selected;
        });
    }

    editType.addEventListener("change", updateEditTargetFields);

    document.querySelectorAll(".edit-offer-btn").forEach(button => {
        button.addEventListener("click", () => {
            const id = button.dataset.id;

            editForm.action = `/admin/offers/${id}/edit`;

            document.getElementById("editOfferName").value =
                button.dataset.name || "";

            editType.value = button.dataset.type || "VARIANT";

            document.getElementById("editVariantId").value =
                button.dataset.variant || "";

            document.getElementById("editProductId").value =
                button.dataset.product || "";

            document.getElementById("editCategoryId").value =
                button.dataset.category || "";

            document.getElementById("editDiscount").value =
                button.dataset.discount || "";

            document.getElementById("editStartDate").value =
                button.dataset.start || "";

            document.getElementById("editEndDate").value =
                button.dataset.end || "";

            updateEditTargetFields();
        });
    });

    // Open modal again after a validation error
    const openModal = <%- JSON.stringify(openModal || "") %>;

    if (openModal === "add") {
        bootstrap.Modal.getOrCreateInstance(
            document.getElementById("addOfferModal")
        ).show();
    }

    if (openModal === "edit") {
        const offerId = new URLSearchParams(window.location.search)
            .get("offerId");

        const editButton = [...document.querySelectorAll(".edit-offer-btn")]
            .find(button => button.dataset.id === offerId);

        if (editButton) {
            editButton.click();
            bootstrap.Modal.getOrCreateInstance(
                document.getElementById("editOfferModal")
            ).show();
        }
    }

    
    // Delete Offer Modal
    const deleteForm = document.getElementById("deleteOfferForm");
    const deleteOfferName = document.getElementById("deleteOfferName");

    document.querySelectorAll(".delete-offer-btn").forEach(button => {
        button.addEventListener("click", () => {
            const id = button.dataset.id;
            const name = button.dataset.name;

            deleteForm.action = `/admin/offers/${id}/delete`;
            deleteOfferName.textContent = name || "this offer";
        });
    });

    
});
</script>

<%- include("../partials/footer") %>
