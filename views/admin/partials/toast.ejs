<div class="toast-container position-fixed top-0 end-0 p-3"
     style="z-index: 9999;">

    <div id="notificationToast"
         class="toast"
         role="alert"
         aria-live="assertive"
         aria-atomic="true">

        <div class="toast-header">

            <strong class="me-auto"
                    id="toastTitle">
                Notification
            </strong>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="toast">
            </button>

        </div>

        <div class="toast-body"
             id="toastMessage">
        </div>

    </div>

</div>