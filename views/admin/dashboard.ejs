<%- include("./partials/header") %>

<link rel="stylesheet" href="/css/admin/dashboard.css">

<body>

<div class="wrapper">

    <%- include("./partials/sidebar") %>

    <div class="main">

        <%- include("./partials/navbar") %>

        <div class="container-fluid p-4">

            <!-- ALERT MESSAGES -->
            <% if (successMessage) { %>
                <div class="alert alert-success alert-dismissible fade show">
                    <%= successMessage %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (errorMessage) { %>
                <div class="alert alert-danger alert-dismissible fade show">
                    <%= errorMessage %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>


            <!-- DASHBOARD HEADER -->
            <div class="dashboard-header mb-4">
                <h2>Welcome Back, Admin!</h2>
                <p>Here's what's happening with your Chronix store today.</p>
            </div>


            <!-- SUMMARY CARDS -->
            <div class="cards">

                <div class="card">
                    <div class="card-icon">
                        <i class="bi bi-currency-rupee"></i>
                    </div>
                    <h3>Total Revenue</h3>
                    <h2>₹<%= Number(totalRevenue || 0).toLocaleString("en-IN") %></h2>
                </div>

                <div class="card">
                    <div class="card-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <h3>Total Users</h3>
                    <h2><%= totalUsers || 0 %></h2>
                </div>

                <div class="card">
                    <div class="card-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <h3>Total Products</h3>
                    <h2><%= totalProducts || 0 %></h2>
                </div>

                <div class="card">
                    <div class="card-icon">
                        <i class="bi bi-cart-check"></i>
                    </div>
                    <h3>Total Orders</h3>
                    <h2><%= totalOrders || 0 %></h2>
                </div>

            </div>


            <!-- MAIN DASHBOARD CONTENT -->
            <div class="row g-4 mt-2">

                <!-- LEFT COLUMN -->
                <div class="col-lg-8">

                    <!-- SALES SUMMARY -->
                    <div class="dashboard-card mb-4">

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

                            <div>
                                <h2>
                                    <i class="bi bi-graph-up"></i>
                                    Sales Summary
                                </h2>
                                <p class="mb-0">Your store's sales performance over the last 7 days</p>
                            </div>

                            <span class="badge bg-light text-primary px-3 py-2">
                                Last 7 Days
                            </span>

                        </div>

                        <div style="height:280px; position:relative;">
                            <canvas id="salesChart"></canvas>
                        </div>

                    </div>


                    <!-- RECENT ORDERS -->
                    <div class="dashboard-card">

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

                            <div>
                                <h2>
                                    <i class="bi bi-clock-history"></i>
                                    Recent Orders
                                </h2>
                                <p class="mb-0">The latest 5 orders from your store</p>
                            </div>

                            <a href="/admin/orders"
                               class="btn btn-sm btn-outline-primary">
                                View All
                                <i class="bi bi-arrow-right"></i>
                            </a>

                        </div>


                        <div class="table-responsive">

                            <table class="table table-hover align-middle">

                                <thead>
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Customer</th>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    <% if (recentOrders && recentOrders.length > 0) { %>

                                        <% recentOrders.slice(0, 5).forEach(order => { %>

                                            <tr>

                                                <td class="fw-semibold">
                                                    #<%= order.orderId %>
                                                </td>

                                                <td>
                                                    <%= order.customerName || "Customer" %>
                                                </td>

                                                <td>
                                                    <%= order.createdAt
                                                        ? new Date(order.createdAt).toLocaleDateString("en-IN")
                                                        : "-" %>
                                                </td>

                                                <td class="fw-semibold">
                                                    ₹<%= Number(order.totalAmount || 0).toLocaleString("en-IN") %>
                                                </td>

                                                <td>

                                                    <% if (order.status === "DELIVERED") { %>
                                                        <span class="badge bg-success">Delivered</span>

                                                    <% } else if (order.status === "CANCELLED") { %>
                                                        <span class="badge bg-danger">Cancelled</span>

                                                    <% } else if (order.status === "RETURNED") { %>
                                                        <span class="badge bg-warning text-dark">Returned</span>

                                                    <% } else if (order.status === "SHIPPED") { %>
                                                        <span class="badge bg-info text-dark">Shipped</span>

                                                    <% } else if (order.status === "OUT_FOR_DELIVERY") { %>
                                                        <span class="badge bg-primary">Out for delivery</span>

                                                    <% } else { %>
                                                        <span class="badge bg-secondary">
                                                            <%= order.status %>
                                                        </span>
                                                    <% } %>

                                                </td>

                                            </tr>

                                        <% }) %>

                                    <% } else { %>

                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">
                                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                                No recent orders found.
                                            </td>
                                        </tr>

                                    <% } %>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>


                <!-- RIGHT COLUMN -->
                <div class="col-lg-4">

  
<!-- BEST-SELLING PRODUCTS -->
<div class="dashboard-card mb-4">

    <!-- HEADER -->
    <div class="mb-1">
        <h2>
            <i class="bi bi-trophy"></i>
            Best-Selling Products
        </h2>
        <p>Top 3 products by units sold</p>
    </div>

    <!-- PRODUCT LIST -->
    <% if (bestSellingProducts && bestSellingProducts.length > 0) { %>

        <% bestSellingProducts.slice(0, 3).forEach(product => { %>

            <div class="best-product-row">

                <!-- PRODUCT IMAGE -->
                <div class="best-product-image">

                    <% if (product.image) { %>
                        <img
                            src="<%= product.image %>"
                            alt="<%= product.productName %>"
                            onerror="this.style.display='none';"
                        >
                    <% } else { %>
                        <i class="bi bi-watch fs-3 text-secondary"></i>
                    <% } %>

                </div>

                <!-- PRODUCT DETAILS -->
                <div class="best-product-details">

                    <h6>
                        <%= product.productName %>
                    </h6>

                    <small>
                        <%= product.totalSold %> units sold
                    </small>

                </div>

            </div>

        <% }) %>

    <% } else { %>

        <!-- NO SALES DATA -->
        <div class="text-center text-muted py-4">
            <i class="bi bi-box-seam fs-3 d-block mb-2"></i>
            No sales data available.
        </div>

    <% } %>

</div>

                  
<!-- WEEKLY TOP CUSTOMERS -->
<div class="dashboard-card weekly-customers-card">

    <!-- HEADER -->
    <div class="mb-1">
        <h2>
            <i class="bi bi-people-fill"></i>
            Weekly Top Customers
        </h2>

        <p>Top 3 customers by spending in the last 7 days</p>
    </div>

    <!-- CUSTOMER LIST -->
    <% if (weeklyTopCustomers && weeklyTopCustomers.length > 0) { %>

        <% weeklyTopCustomers.slice(0, 3).forEach((customer, index) => { %>

            <div class="customer-row">

                <!-- CUSTOMER IMAGE -->
                <div class="customer-image">

                    <% if (customer.profileImage) { %>

                        <img
                            src="<%= customer.profileImage %>"
                            alt="<%= customer.customerName %>"
                            onerror="this.style.display='none';"
                        >

                    <% } else { %>

                        <i class="bi bi-person fs-4 text-secondary"></i>

                    <% } %>

                </div>

                <!-- CUSTOMER DETAILS -->
                <div class="customer-details">

                    <h6>
                        <%= customer.customerName %>
                    </h6>

                    <small>
                        <%= customer.totalOrders %> Orders
                    </small>

                </div>

                <!-- TOTAL SPENT -->
                <div class="customer-spending">

                    <strong>
                        ₹<%= Number(customer.totalSpent || 0).toLocaleString("en-IN") %>
                    </strong>

                    

                </div>

            </div>

        <% }) %>

    <% } else { %>

        <!-- NO CUSTOMER DATA -->
        <div class="text-center text-muted py-4">
            <i class="bi bi-person-x fs-3 d-block mb-2"></i>
            No customer purchases in the last 7 days.
        </div>

    <% } %>

</div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- BOOTSTRAP -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- CHART.JS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script>

    // Automatically hide alert messages
    setTimeout(() => {

        document.querySelectorAll(".alert").forEach(alert => {
            alert.remove();
        });

    }, 3000);


    // SALES SUMMARY CHART
    // Expected data: [{ label: "Mon", revenue: 1000 }, ...]
    const salesData = <%- JSON.stringify(salesChartData || []) %>;

    const chartCanvas = document.getElementById("salesChart");

    if (chartCanvas) {

        const labels = salesData.map(item => item.label);
        const revenue = salesData.map(item => Number(item.revenue || 0));

        new Chart(chartCanvas, {

            type: "line",

            data: {
                labels: labels,

                datasets: [{
                    label: "Revenue",
                    data: revenue,

                    borderColor: "#0d6efd",
                    backgroundColor: "rgba(13, 110, 253, 0.10)",

                    borderWidth: 2,
                    fill: true,
                    tension: 0.4,

                    pointRadius: 4,
                    pointHoverRadius: 6,
                    pointBackgroundColor: "#0d6efd"
                }]
            },

            options: {

                responsive: true,
                maintainAspectRatio: false,

                interaction: {
                    intersect: false,
                    mode: "index"
                },

                plugins: {
                    legend: {
                        display: false
                    },

                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return "Revenue: ₹" +
                                    Number(context.raw || 0).toLocaleString("en-IN");
                            }
                        }
                    }
                },

                scales: {

                    y: {
                        beginAtZero: true,

                        ticks: {
                            callback: function(value) {
                                return "₹" + Number(value).toLocaleString("en-IN");
                            }
                        },

                        grid: {
                            color: "#f0f0f0"
                        }
                    },

                    x: {
                        grid: {
                            display: false
                        }
                    }

                }

            }

        });

    }

</script>

</body>
</html>