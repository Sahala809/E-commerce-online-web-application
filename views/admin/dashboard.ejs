

<%- include("./partials/header") %>

<link rel="stylesheet" href="/css/admin/dashboard.css">

<body>

<div class="wrapper">

    <%- include("./partials/sidebar") %>

    <div class="main">

        <%- include("./partials/navbar") %>

        <div class="container mt-4">

            <main class="main-content">
                <% if(message){ %>
                    <div class="alert alert-danger">
                        <%= message %>
                    </div>
                <% } %>


                <div class="dashboard-header">
                    <h2>Welcome to the Chronix Admin Dashboard 👋</h2>
                    <p>Manage users, products, categories, brands, orders, coupons, offers, and analytics from one place.</p>
                </div>

                <div class="cards">

                    <div class="card">
                        <h3>Total Users</h3>
                        <h2><%= totalUsers || 0 %></h2>
                    </div>

                    <div class="card">
                        <h3>Total Products</h3>
                        <h2><%= totalProducts || 0 %></h2>
                    </div>

                    <div class="card">
                        <h3>Total Orders</h3>
                        <h2><%= totalOrders || 0 %></h2>
                    </div>

                    <div class="card">
                        <h3>Total Revenue</h3>
                        <h2>£<%= totalRevenue || 0 %></h2>
                    </div>

                </div>

            </main>
            

        </div>

    </div>

</div>



</body>

</html>