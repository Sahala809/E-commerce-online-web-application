<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/admin/addVariant.css">

<body>

<div class="wrapper">

    <%- include("../partials/sidebar") %>

    <div class="main">

        <%- include("../partials/navbar") %>

        <div class="content">

            <% if(successMessage){ %>
                <div class="alert alert-success">
                    <%= successMessage %>
                </div>
            <% } %>

            <% if(errorMessage){ %>
                <div class="alert alert-danger">
                    <%= errorMessage %>
                </div>
            <% } %>

            <div class="page-title">
                <h1>Edit Product Variant</h1>
                <p>Edit variant for <strong><%= product.productName %></strong></p>
            </div>

            <div class="form-card">

                <form
                    action="/admin/products/<%= product._id %>/variants/edit/<%= variant._id %>?_method=PATCH"
                    method="POST"
                    enctype="multipart/form-data">

                    <div class="row">

                        <!-- Left Side -->

                        <div class="col-lg-7">

                            <h3 class="mb-4">Variant Information</h3>

                            <div class="mb-3">

                                <label class="form-label">Color</label>

                                <input
                                    type="text"
                                    name="color"
                                    class="form-control"
                                    value="<%= formData?.color || variant.color %>">

                                <% if(errors?.color){ %>
                                    <small class="text-danger">
                                        <%= errors.color %>
                                    </small>
                                <% } %>

                            </div>

                            <div class="mb-3">

                                <label class="form-label">Stock</label>

                                <input
                                    type="number"
                                    name="stock"
                                    class="form-control"
                                    value="<%= formData?.stock || variant.stock %>">

                                <% if(errors?.stock){ %>
                                    <small class="text-danger">
                                        <%= errors.stock %>
                                    </small>
                                <% } %>

                            </div>

                            <div class="mb-3">

                                <label class="form-label">Price (₹)</label>

                                <input
                                    type="number"
                                    name="price"
                                    class="form-control"
                                    value="<%= formData?.price || variant.price %>">

                                <% if(errors?.price){ %>
                                    <small class="text-danger">
                                        <%= errors.price %>
                                    </small>
                                <% } %>

                            </div>

                            <div class="mb-3">

                                <label class="form-label">Offer Price (₹)</label>

                                <input
                                    type="number"
                                    name="offerPrice"
                                    class="form-control"
                                    value="<%= formData?.offerPrice || variant.offerPrice %>">

                            </div>

                            <div class="mb-3">

                                <label class="form-label">Status</label>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input"
                                        type="checkbox"
                                        name="isActive"
                                        value="true"
                                        <%= (formData?.isActive !== undefined ? formData.isActive === "true" : variant.isActive) ? "checked" : "" %>>

                                    <label class="form-check-label">

                                        Active

                                    </label>

                                </div>

                            </div>

                            <div class="mb-3">

                                <label class="form-label">Description</label>

                                <textarea
                                    rows="5"
                                    class="form-control"
                                    name="description"><%= formData?.description || variant.description %></textarea>

                            </div>

                        </div>

                                                <!-- Right Side -->
                        <div class="col-lg-5">

                            <h3 class="mb-4">Variant Images</h3>

                            <p class="image-help">
                                You can add up to 3 images for this variant.
                            </p>

                            <!-- Three image slots -->
                            <div class="variant-image-slots">

                                <% for(let i = 0; i < 3; i++) { %>

                                    <div class="variant-image-slot"
                                        id="slot<%= i %>">

                                        <% if(variant.images && variant.images[i]) { %>

                                            <!-- Existing image -->

                                            <img
                                                src="/uploads/variants/<%= variant.images[i] %>"
                                                class="variant-preview"
                                                id="preview<%= i %>">

                                            <!-- Remove button -->

                                            <button
                                                type="button"
                                                class="remove-image"
                                                onclick="removeExistingImage('<%= variant.images[i] %>', <%= i %>)">

                                                <i class="bi bi-x"></i>

                                            </button>

                                        <% } else { %>

                                            <!-- Empty slot -->

                                            <label class="empty-image-slot">

                                                <span class="plus">+</span>

                                                <input
                                                    type="file"
                                                    class="slot-input"
                                                    data-slot="<%= i %>"
                                                    accept="image/png,image/jpeg,image/jpg"
                                                    hidden>

                                            </label>

                                        <% } %>

                                    </div>

                                <% } %>

                            </div>


                            <!-- Hidden input for removed images -->

                            <div id="removedImagesContainer"></div>


                            <!-- Hidden files that will finally be submitted -->

                            <div id="newFilesContainer"></div>


                            <% if(errors?.images){ %>

                                <small class="text-danger">
                                    <%= errors.images %>
                                </small>

                            <% } %>

                        </div>

                    </div>

                    <div class="text-end mt-4">

                        <a
                            href="/admin/products/<%= product._id %>/variants"
                            class="btn btn-outline-secondary me-2">

                            Cancel

                        </a>

                        <button
                            type="submit"
                            class="btn btn-primary">

                            Update Variant

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>

document.addEventListener("DOMContentLoaded", function () {

    /* =====================================================
       REMOVE EXISTING IMAGE
    ===================================================== */

    window.removeExistingImage = function (imageName, index) {

        const slot =
            document.getElementById(`slot${index}`);

        if (!slot) return;


        /* Tell backend to remove old image */

        const removedInput =
            document.createElement("input");

        removedInput.type = "hidden";
        removedInput.name = "removedImages[]";
        removedInput.value = imageName;

        document
            .getElementById("removedImagesContainer")
            .appendChild(removedInput);


        /* Turn the same slot into + */

        slot.innerHTML = `

            <label class="empty-image-slot">

                <span class="plus">+</span>

                <input
                    type="file"
                    class="slot-input"
                    data-slot="${index}"
                    accept="image/png,image/jpeg,image/jpg"
                    hidden>

            </label>

        `;


        /* Add change event to new input */

        const input =
            slot.querySelector(".slot-input");

        input.addEventListener(
            "change",
            handleImageSelect
        );

    };


    /* =====================================================
       SELECT NEW IMAGE
    ===================================================== */

    window.handleImageSelect = function () {

        const input = this;

        const file = input.files[0];

        if (!file) return;


        const slotNumber =
            input.dataset.slot;

        const slot =
            document.getElementById(
                `slot${slotNumber}`
            );


        /* Preview image */

        const reader =
            new FileReader();


        reader.onload = function (e) {

            slot.innerHTML = `

                <img
                    src="${e.target.result}"
                    class="variant-preview">

                <button
                    type="button"
                    class="remove-image"
                    onclick="removeNewImage(${slotNumber})">

                    <i class="bi bi-x"></i>

                </button>

            `;

        };


        reader.readAsDataURL(file);


        /*
         * IMPORTANT:
         * Put selected file into a hidden file input
         * so it is submitted with the form.
         */

        const dataTransfer =
            new DataTransfer();

        dataTransfer.items.add(file);


        const fileInput =
            document.createElement("input");

        fileInput.type = "file";

        fileInput.name = "images";

        fileInput.hidden = true;

        fileInput.id =
            `newFile${slotNumber}`;

        fileInput.files =
            dataTransfer.files;


        document
            .getElementById("newFilesContainer")
            .appendChild(fileInput);

    };


    /* =====================================================
       REMOVE NEWLY SELECTED IMAGE
    ===================================================== */

    window.removeNewImage = function (index) {

        const slot =
            document.getElementById(
                `slot${index}`
            );


        /* Remove selected file */

        const fileInput =
            document.getElementById(
                `newFile${index}`
            );

        if (fileInput) {

            fileInput.remove();

        }


        /* Make slot + again */

        slot.innerHTML = `

            <label class="empty-image-slot">

                <span class="plus">+</span>

                <input
                    type="file"
                    class="slot-input"
                    data-slot="${index}"
                    accept="image/png,image/jpeg,image/jpg"
                    hidden>

            </label>

        `;


        const input =
            slot.querySelector(".slot-input");


        input.addEventListener(
            "change",
            handleImageSelect
        );

    };


    /* =====================================================
       INITIALIZE EMPTY SLOTS
    ===================================================== */

    document
        .querySelectorAll(".slot-input")
        .forEach(input => {

            input.addEventListener(
                "change",
                handleImageSelect
            );

        });

});

</script>
</body>

</html>