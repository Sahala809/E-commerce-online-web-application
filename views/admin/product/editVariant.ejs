<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/admin/editVariant.css">

<body>

<div class="wrapper">

    <%- include("../partials/sidebar") %>

    <div class="main">

        <%- include("../partials/navbar") %>

        <div class="content">

            <!-- ================================================= -->
            <!-- SUCCESS / ERROR MESSAGE -->
            <!-- ================================================= -->

            <% if (typeof successMessage !== "undefined" && successMessage) { %>

                <div class="alert alert-success">
                    <%= successMessage %>
                </div>

            <% } %>

            <% if (typeof errorMessage !== "undefined" && errorMessage) { %>

                <div class="alert alert-danger">
                    <%= errorMessage %>
                </div>

            <% } %>


            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <div class="page-title">

                <h1>Product Variants</h1>

                <p>
                    Manage variants for
                    <strong>
                        <%= product.productName %>
                    </strong>
                </p>

            </div>


            <!-- ================================================= -->
            <!-- VARIANTS CARD -->
            <!-- ================================================= -->

            <div class="form-card">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>

                        <h3 class="mb-1">
                            Variants
                        </h3>

                        <p class="text-muted mb-0">
                            Edit or manage product variants
                        </p>

                    </div>


                    <!-- ADD VARIANT -->

                    <button
                        type="button"
                        class="btn btn-primary"
                        id="addVariantButton">

                        <i class="bi bi-plus-lg"></i>
                        Add Variant

                    </button>

                </div>


                <!-- ================================================= -->
                <!-- VARIANT TABLE -->
                <!-- ================================================= -->

                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>

                            <tr>

                                <th>Image</th>

                                <th>Color</th>

                                <th>Price</th>

                                <th>Offer Price</th>

                                <th>Stock</th>

                                <th>Status</th>

                                <th>Action</th>

                            </tr>

                        </thead>


                        <tbody>

                        <% if (variants && variants.length > 0) { %>

                            <% variants.forEach(variant => { %>

                                <tr>

                                    <!-- IMAGE -->

                                    <td>

                                        <% if (variant.images && variant.images.length > 0) { %>

                                            <img
                                                src="/uploads/variants/<%= variant.images[0] %>"
                                                alt="<%= variant.color %>"
                                                style="
                                                    width:60px;
                                                    height:60px;
                                                    object-fit:cover;
                                                    border-radius:8px;
                                                "
                                            >

                                        <% } else { %>

                                            <div
                                                style="
                                                    width:60px;
                                                    height:60px;
                                                    display:flex;
                                                    align-items:center;
                                                    justify-content:center;
                                                    background:#f1f1f1;
                                                    border-radius:8px;
                                                "
                                            >

                                                <i class="bi bi-image"></i>

                                            </div>

                                        <% } %>

                                    </td>


                                    <!-- COLOR -->

                                    <td>

                                        <strong>
                                            <%= variant.color %>
                                        </strong>

                                    </td>


                                    <!-- PRICE -->

                                    <td>
                                        ₹ <%= variant.price %>
                                    </td>


                                    <!-- OFFER PRICE -->

                                    <td>

                                        <% if (
                                            variant.offerPrice !== undefined &&
                                            variant.offerPrice !== null &&
                                            variant.offerPrice !== ""
                                        ) { %>

                                            ₹ <%= variant.offerPrice %>

                                        <% } else { %>

                                            -

                                        <% } %>

                                    </td>


                                    <!-- STOCK -->

                                    <td>
                                        <%= variant.stock %>
                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <% if (variant.isActive) { %>

                                            <span class="badge bg-success">
                                                Active
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- ACTION -->

                                    <td>

    <div class="dropdown">

        <!-- Three dots button -->
        <button
            type="button"
            class="btn btn-sm btn-light"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            title="More options"
        >
            <i class="bi bi-three-dots-vertical"></i>
        </button>


        <!-- Dropdown -->
        <ul class="dropdown-menu dropdown-menu-end">

            <!-- EDIT -->
            <li>

                <button
                    type="button"
                    class="dropdown-item edit-variant-btn"

                    data-variant-id="<%= variant._id %>"

                    data-color="<%= variant.color || '' %>"

                    data-stock="<%= variant.stock ?? '' %>"

                    data-price="<%= variant.price ?? '' %>"

                    data-offer-price="<%= variant.offerPrice ?? '' %>"

                    data-description="<%= variant.description || '' %>"

                    data-is-active="<%= variant.isActive ? 'true' : 'false' %>"

                    data-image1="<%= variant.images?.[0] || '' %>"

                    data-image2="<%= variant.images?.[1] || '' %>"

                    data-image3="<%= variant.images?.[2] || '' %>"
                >

                    <i class="bi bi-pencil me-2"></i>
                    Edit

                </button>

            </li>


            <!-- DELETE -->
            <li>

                <button
                    type="button"
                    class="dropdown-item text-danger delete-variant-btn"
                    data-variant-id="<%= variant._id %>"
                    data-product-id="<%= product._id %>"
                >

                    <i class="bi bi-trash me-2"></i>
                    Delete

                </button>

            </li>

        </ul>

    </div>

</td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>

                                <td
                                    colspan="7"
                                    class="text-center py-5"
                                >

                                    <p class="text-muted mb-0">
                                        No variants found.
                                    </p>

                                </td>

                            </tr>

                        <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>



<!-- ========================================================= -->
<!-- EDIT VARIANT MODAL -->
<!-- ========================================================= -->

<div
    class="modal fade"
    id="editVariantModal"
    tabindex="-1"
    aria-labelledby="editVariantModalLabel"
    aria-hidden="true"
>

    <div
        class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"
    >

        <div class="modal-content">


            <!-- ================================================= -->
            <!-- MODAL HEADER -->
            <!-- ================================================= -->

            <div class="modal-header">

                <div>

                    <h5
                        class="modal-title"
                        id="editVariantModalLabel"
                    >
                        Edit Variant
                    </h5>

                    <small class="text-muted">

                        <%= product.productName %>

                    </small>

                </div>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                ></button>

            </div>



            <!-- ================================================= -->
            <!-- EDIT FORM -->
            <!-- ================================================= -->

            <form
                id="editVariantForm"
                method="POST"
                enctype="multipart/form-data"
                novalidate
            >

                <div class="modal-body">


                    <!-- SERVER ERROR -->

                    <div
                        id="modalErrorMessage"
                        class="alert alert-danger d-none"
                    ></div>


                    <div class="row">


                        <!-- ================================================= -->
                        <!-- LEFT SIDE -->
                        <!-- ================================================= -->

                        <div class="col-lg-7">

                            <h5 class="mb-4">
                                Variant Information
                            </h5>


                            <!-- COLOR -->

                            <div class="mb-3">

                                <label
                                    for="editColor"
                                    class="form-label"
                                >
                                    Color
                                </label>

                                <input
                                    type="text"
                                    name="color"
                                    id="editColor"
                                    class="form-control"
                                >

                                <small
                                    class="text-danger client-error"
                                    id="editColorError"
                                ></small>

                            </div>


                            <!-- STOCK -->

                            <div class="mb-3">

                                <label
                                    for="editStock"
                                    class="form-label"
                                >
                                    Stock
                                </label>

                                <input
                                    type="number"
                                    name="stock"
                                    id="editStock"
                                    class="form-control"
                                    min="0"
                                >

                                <small
                                    class="text-danger client-error"
                                    id="editStockError"
                                ></small>

                            </div>


                            <!-- PRICE -->

                            <div class="mb-3">

                                <label
                                    for="editPrice"
                                    class="form-label"
                                >
                                    Price (₹)
                                </label>

                                <input
                                    type="number"
                                    name="price"
                                    id="editPrice"
                                    class="form-control"
                                    min="1"
                                >

                                <small
                                    class="text-danger client-error"
                                    id="editPriceError"
                                ></small>

                            </div>


                            <!-- OFFER PRICE -->

                            <div class="mb-3">

                                <label
                                    for="editOfferPrice"
                                    class="form-label"
                                >
                                    Offer Price (₹)
                                </label>

                                <input
                                    type="number"
                                    name="offerPrice"
                                    id="editOfferPrice"
                                    class="form-control"
                                    min="0"
                                >

                                <small
                                    class="text-danger client-error"
                                    id="editOfferPriceError"
                                ></small>

                            </div>


                            <!-- STATUS -->

                            <div class="mb-3">

                                <label class="form-label">
                                    Status
                                </label>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input"
                                        type="checkbox"
                                        name="isActive"
                                        value="true"
                                        id="editIsActive"
                                    >

                                    <label
                                        class="form-check-label"
                                        for="editIsActive"
                                    >
                                        Active
                                    </label>

                                </div>

                            </div>


                            <!-- DESCRIPTION -->

                            <div class="mb-3">

                                <label
                                    for="editDescription"
                                    class="form-label"
                                >
                                    Description
                                </label>

                                <textarea
                                    rows="5"
                                    class="form-control"
                                    name="description"
                                    id="editDescription"
                                ></textarea>

                            </div>

                        </div>



                        <!-- ================================================= -->
                        <!-- RIGHT SIDE - IMAGES -->
                        <!-- ================================================= -->

                        <div class="col-lg-5">

                            <h5 class="mb-4">
                                Variant Images
                            </h5>


                            <!-- IMAGE UPLOAD AREA -->

                            <div
                                class="image-upload-area"
                                id="editImageUploadArea"
                            >

                                <div class="upload-icon">

                                    <i class="bi bi-cloud-arrow-up"></i>

                                </div>

                                <h4>
                                    Add or replace image
                                </h4>

                                <p>
                                    PNG, JPG up to 10MB
                                </p>

                                <button
                                    type="button"
                                    class="browse-btn"
                                    id="editBrowseBtn"
                                >
                                    Browse Files
                                </button>

                                <input
                                    type="file"
                                    id="editImageInput"
                                    name="images"
                                    accept="image/png,image/jpeg,image/jpg"
                                    hidden
                                >

                            </div>


                            <!-- IMAGE ERROR -->

                            <small
                                class="text-danger"
                                id="editImageError"
                            ></small>


                            <!-- ================================================= -->
                            <!-- IMAGE BOXES -->
                            <!-- ================================================= -->

                            <div class="image-preview-container">


                                <!-- IMAGE 1 -->

                                <div
                                    class="small-upload"
                                    id="editBox1"
                                >

                                    <span
                                        class="plus"
                                        id="editPlus1"
                                    >
                                        +
                                    </span>

                                    <img
                                        id="editPreview1"
                                        alt="Image 1"
                                        style="display:none;"
                                    >

                                    <div
                                        class="image-actions"
                                        id="editActions1"
                                        style="display:none;"
                                    >

                                        <button
                                            type="button"
                                            class="edit-image edit-existing-image"
                                            data-box="editBox1"
                                        >
                                            ✎
                                        </button>

                                        <button
                                            type="button"
                                            class="remove-image remove-existing-image"
                                            data-box="editBox1"
                                        >
                                            ×
                                        </button>

                                    </div>

                                </div>


                                <!-- IMAGE 2 -->

                                <div
                                    class="small-upload"
                                    id="editBox2"
                                >

                                    <span
                                        class="plus"
                                        id="editPlus2"
                                    >
                                        +
                                    </span>

                                    <img
                                        id="editPreview2"
                                        alt="Image 2"
                                        style="display:none;"
                                    >

                                    <div
                                        class="image-actions"
                                        id="editActions2"
                                        style="display:none;"
                                    >

                                        <button
                                            type="button"
                                            class="edit-image edit-existing-image"
                                            data-box="editBox2"
                                        >
                                            ✎
                                        </button>

                                        <button
                                            type="button"
                                            class="remove-image remove-existing-image"
                                            data-box="editBox2"
                                        >
                                            ×
                                        </button>

                                    </div>

                                </div>


                                <!-- IMAGE 3 -->

                                <div
                                    class="small-upload"
                                    id="editBox3"
                                >

                                    <span
                                        class="plus"
                                        id="editPlus3"
                                    >
                                        +
                                    </span>

                                    <img
                                        id="editPreview3"
                                        alt="Image 3"
                                        style="display:none;"
                                    >

                                    <div
                                        class="image-actions"
                                        id="editActions3"
                                        style="display:none;"
                                    >

                                        <button
                                            type="button"
                                            class="edit-image edit-existing-image"
                                            data-box="editBox3"
                                        >
                                            ✎
                                        </button>

                                        <button
                                            type="button"
                                            class="remove-image remove-existing-image"
                                            data-box="editBox3"
                                        >
                                            ×
                                        </button>

                                    </div>

                                </div>

                            </div>


                            <!-- REMOVED IMAGES -->

                            <div id="removedImagesContainer"></div>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- MODAL FOOTER -->
                <!-- ================================================= -->

                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="btn btn-primary"
                        id="updateVariantButton"
                    >
                        Update Variant
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- ========================================================= -->
<!-- CROPPER MODAL -->
<!-- ========================================================= -->

<div
    class="modal fade"
    id="editCropModal"
    tabindex="-1"
    aria-hidden="true"
>

    <div
        class="modal-dialog modal-lg modal-dialog-centered"
    >

        <div class="modal-content">


            <div class="modal-header">

                <h5 class="modal-title">
                    Adjust Image
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>


            <div class="modal-body text-center">

                <div class="crop-container">

                    <img
                        id="editCropImage"
                        style="
                            max-width:100%;
                            display:block;
                        "
                    >

                </div>

            </div>


            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal"
                >
                    Cancel
                </button>

                <button
                    type="button"
                    class="btn btn-primary"
                    id="editCropButton"
                >
                    Crop & Fix
                </button>

            </div>

        </div>

    </div>

</div>



<!-- ========================================================= -->
<!-- LIBRARIES -->
<!-- ========================================================= -->

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css"
>

<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>



<script>

document.addEventListener("DOMContentLoaded", function () {

    // =====================================================
    // MODALS
    // =====================================================

    const editVariantModalElement =
        document.getElementById("editVariantModal");

    const editVariantModal =
        new bootstrap.Modal(editVariantModalElement);


    const cropModalElement =
        document.getElementById("editCropModal");

    const cropModal =
        new bootstrap.Modal(cropModalElement);


    // =====================================================
    // FORM
    // =====================================================

    const form =
        document.getElementById("editVariantForm");


    // =====================================================
    // IMAGE ELEMENTS
    // =====================================================

    const imageInput =
        document.getElementById("editImageInput");

    const browseButton =
        document.getElementById("editBrowseBtn");

    const cropImage =
        document.getElementById("editCropImage");

    const cropButton =
        document.getElementById("editCropButton");


    // =====================================================
    // FORM FIELDS
    // =====================================================

    const colorInput =
        document.getElementById("editColor");

    const stockInput =
        document.getElementById("editStock");

    const priceInput =
        document.getElementById("editPrice");

    const offerPriceInput =
        document.getElementById("editOfferPrice");

    const descriptionInput =
        document.getElementById("editDescription");

    const activeInput =
        document.getElementById("editIsActive");


    // =====================================================
    // VARIABLES
    // =====================================================

    let currentVariantId = null;

    let currentBox = null;

    let cropper = null;

    let croppedFiles = {};

    let existingImages = {};


    // =====================================================
    // EDIT VARIANT BUTTON
    // =====================================================

    document
        .querySelectorAll(".edit-variant-btn")
        .forEach(button => {

            button.addEventListener("click", function () {

                // -----------------------------------------
                // GET VARIANT DATA
                // -----------------------------------------

                currentVariantId =
                    this.dataset.variantId;


                const color =
                    this.dataset.color || "";


                const stock =
                    this.dataset.stock || "";


                const price =
                    this.dataset.price || "";


                const offerPrice =
                    this.dataset.offerPrice || "";


                const description =
                    this.dataset.description || "";


                const isActive =
                    this.dataset.isActive === "true";


                const image1 =
                    this.dataset.image1 || "";


                const image2 =
                    this.dataset.image2 || "";


                const image3 =
                    this.dataset.image3 || "";


                // -----------------------------------------
                // FORM ACTION
                // -----------------------------------------

                form.action =
                    `/admin/products/<%= product._id %>/variants/edit/${currentVariantId}?_method=PATCH`;


                // -----------------------------------------
                // PUT EXISTING VALUES INTO FORM
                // -----------------------------------------

                colorInput.value =
                    color;


                stockInput.value =
                    stock;


                priceInput.value =
                    price;


                offerPriceInput.value =
                    offerPrice;


                descriptionInput.value =
                    description;


                activeInput.checked =
                    isActive;


                // -----------------------------------------
                // RESET DATA
                // -----------------------------------------

                croppedFiles = {};


                existingImages = {

                    editBox1: image1,

                    editBox2: image2,

                    editBox3: image3

                };


                // -----------------------------------------
                // CLEAR ERRORS
                // -----------------------------------------

                document
                    .querySelectorAll(".client-error")
                    .forEach(error => {

                        error.textContent = "";

                    });


                document
                    .getElementById("editImageError")
                    .textContent = "";


                document
                    .getElementById("modalErrorMessage")
                    .classList.add("d-none");


                // -----------------------------------------
                // RESET IMAGE BOXES
                // -----------------------------------------

                resetImageBoxes();


                // -----------------------------------------
                // LOAD EXISTING IMAGES
                // -----------------------------------------

                loadExistingImage(
                    "editBox1",
                    image1
                );


                loadExistingImage(
                    "editBox2",
                    image2
                );


                loadExistingImage(
                    "editBox3",
                    image3
                );


                // -----------------------------------------
                // SHOW MODAL
                // -----------------------------------------

                editVariantModal.show();

            });

        });


    // =====================================================
    // RESET IMAGE BOXES
    // =====================================================

    function resetImageBoxes() {

        [
            "editBox1",
            "editBox2",
            "editBox3"
        ]
        .forEach(boxId => {

            const box =
                document.getElementById(boxId);

            const preview =
                box.querySelector("img");

            const plus =
                box.querySelector(".plus");

            const actions =
                box.querySelector(".image-actions");


            preview.src = "";

            preview.style.display = "none";

            plus.style.display = "block";

            actions.style.display = "none";

        });


        document
            .getElementById("removedImagesContainer")
            .innerHTML = "";

    }


    // =====================================================
    // LOAD EXISTING IMAGE
    // =====================================================

    function loadExistingImage(boxId, imageName) {

        if (!imageName) {
            return;
        }


        const box =
            document.getElementById(boxId);

        const preview =
            box.querySelector("img");

        const plus =
            box.querySelector(".plus");

        const actions =
            box.querySelector(".image-actions");


        preview.src =
            `/uploads/variants/${imageName}`;

        preview.style.display =
            "block";

        plus.style.display =
            "none";

        actions.style.display =
            "flex";

    }


    // =====================================================
    // BROWSE BUTTON
    // =====================================================

    browseButton.addEventListener(
        "click",
        function () {

            currentBox =
                findFirstAvailableBox();

            imageInput.click();

        }
    );


    // =====================================================
    // CLICK IMAGE BOX
    // =====================================================

    document
        .querySelectorAll(".small-upload")
        .forEach(box => {

            box.addEventListener(
                "click",
                function (event) {

                    if (
                        event.target.closest(".edit-image") ||
                        event.target.closest(".remove-image")
                    ) {
                        return;
                    }


                    currentBox =
                        this.id;


                    imageInput.click();

                }
            );

        });


    // =====================================================
    // FIND EMPTY BOX
    // =====================================================

    function findFirstAvailableBox() {

        for (
            const boxId of
            [
                "editBox1",
                "editBox2",
                "editBox3"
            ]
        ) {

            if (
                !existingImages[boxId] &&
                !croppedFiles[boxId]
            ) {

                return boxId;

            }

        }


        return "editBox1";

    }


    // =====================================================
    // IMAGE SELECT
    // =====================================================

    imageInput.addEventListener(
        "change",
        function () {

            const file =
                this.files[0];


            if (!file) {
                return;
            }


            if (!file.type.startsWith("image/")) {

                showImageError(
                    "Please select a valid image."
                );

                imageInput.value = "";

                return;

            }


            openCropModal(file);

        }
    );


    // =====================================================
    // OPEN CROP MODAL
    // =====================================================

    function openCropModal(file) {

        const reader =
            new FileReader();


        reader.onload =
            function (event) {

                cropImage.src =
                    event.target.result;

                cropModal.show();

            };


        reader.readAsDataURL(file);

    }


    // =====================================================
    // INITIALIZE CROPPER
    // =====================================================

    cropModalElement.addEventListener(
        "shown.bs.modal",
        function () {

            if (cropper) {

                cropper.destroy();

                cropper = null;

            }


            cropper =
                new Cropper(
                    cropImage,
                    {

                        aspectRatio: 1,

                        viewMode: 1,

                        dragMode: "move",

                        autoCropArea: 1,

                        responsive: true,

                        background: false

                    }
                );

        }
    );


    // =====================================================
    // CROP & FIX
    // =====================================================

    cropButton.addEventListener(
        "click",
        function () {

            if (
                !cropper ||
                !currentBox
            ) {
                return;
            }


            const canvas =
                cropper.getCroppedCanvas({

                    width: 800,

                    height: 800

                });


            canvas.toBlob(
                function (blob) {

                    if (!blob) {

                        showImageError(
                            "Unable to crop image."
                        );

                        return;

                    }


                    const file =
                        new File(
                            [blob],
                            `variant-image-${Date.now()}.jpg`,
                            {
                                type: "image/jpeg"
                            }
                        );


                    // -------------------------------------
                    // IF OLD DATABASE IMAGE EXISTS
                    // -------------------------------------

                    const oldImage =
                        existingImages[currentBox];


                    if (oldImage) {

                        addRemovedImage(oldImage);

                        existingImages[currentBox] = "";

                    }


                    // -------------------------------------
                    // SAVE NEW FILE
                    // -------------------------------------

                    croppedFiles[currentBox] =
                        file;


                    // -------------------------------------
                    // SHOW PREVIEW
                    // -------------------------------------

                    showCroppedImage(
                        currentBox,
                        file
                    );


                    // -------------------------------------
                    // CLOSE MODAL
                    // -------------------------------------

                    cropModal.hide();


                    if (cropper) {

                        cropper.destroy();

                        cropper = null;

                    }


                    imageInput.value = "";

                },

                "image/jpeg",

                0.9

            );

        }
    );


    // =====================================================
    // SHOW CROPPED IMAGE
    // =====================================================

    function showCroppedImage(boxId, file) {

        const box =
            document.getElementById(boxId);

        const preview =
            box.querySelector("img");

        const plus =
            box.querySelector(".plus");

        const actions =
            box.querySelector(".image-actions");


        preview.src =
            URL.createObjectURL(file);

        preview.style.display =
            "block";

        plus.style.display =
            "none";

        actions.style.display =
            "flex";

    }


    // =====================================================
    // EDIT EXISTING IMAGE
    // =====================================================

    document
        .querySelectorAll(".edit-existing-image")
        .forEach(button => {

            button.addEventListener(
                "click",
                async function (event) {

                    event.stopPropagation();


                    currentBox =
                        this.dataset.box;


                    // -------------------------------------
                    // IF NEW CROPPED FILE EXISTS
                    // -------------------------------------

                    const newFile =
                        croppedFiles[currentBox];


                    if (newFile) {

                        openCropModal(newFile);

                        return;

                    }


                    // -------------------------------------
                    // GET EXISTING IMAGE
                    // -------------------------------------

                    const existingImage =
                        existingImages[currentBox];


                    if (!existingImage) {

                        imageInput.click();

                        return;

                    }


                    try {

                        const response =
                            await fetch(
                                `/uploads/variants/${existingImage}`
                            );


                        if (!response.ok) {

                            throw new Error(
                                "Image could not be loaded"
                            );

                        }


                        const blob =
                            await response.blob();


                        const file =
                            new File(
                                [blob],
                                existingImage,
                                {
                                    type: blob.type
                                }
                            );


                        openCropModal(file);

                    }
                    catch (error) {

                        console.error(error);

                        showImageError(
                            "Unable to edit image."
                        );

                    }

                }
            );

        });


    // =====================================================
    // REMOVE IMAGE
    // =====================================================

    document
        .querySelectorAll(".remove-existing-image")
        .forEach(button => {

            button.addEventListener(
                "click",
                function (event) {

                    event.stopPropagation();


                    const boxId =
                        this.dataset.box;


                    const oldImage =
                        existingImages[boxId];


                    if (oldImage) {

                        addRemovedImage(oldImage);

                    }


                    delete croppedFiles[boxId];


                    existingImages[boxId] = "";


                    const box =
                        document.getElementById(boxId);


                    const preview =
                        box.querySelector("img");

                    const plus =
                        box.querySelector(".plus");

                    const actions =
                        box.querySelector(".image-actions");


                    preview.src = "";

                    preview.style.display =
                        "none";

                    plus.style.display =
                        "block";

                    actions.style.display =
                        "none";

                }
            );

        });


    // =====================================================
    // ADD REMOVED IMAGE
    // =====================================================

    function addRemovedImage(imageName) {

        if (!imageName) {
            return;
        }


        const container =
            document.getElementById(
                "removedImagesContainer"
            );


        const alreadyExists =
            [
                ...container.querySelectorAll(
                    'input[name="removedImages[]"]'
                )
            ]
            .some(input =>
                input.value === imageName
            );


        if (alreadyExists) {
            return;
        }


        const input =
            document.createElement("input");


        input.type =
            "hidden";

        input.name =
            "removedImages[]";

        input.value =
            imageName;


        container.appendChild(input);

    }


    // =====================================================
    // FORM SUBMIT
    // =====================================================

    form.addEventListener(
        "submit",
        function (event) {

            let isValid = true;


            // ---------------------------------------------
            // CLEAR ERRORS
            // ---------------------------------------------

            document
                .querySelectorAll(".client-error")
                .forEach(error => {

                    error.textContent = "";

                });


            document
                .getElementById("editImageError")
                .textContent = "";


            // ---------------------------------------------
            // COLOR
            // ---------------------------------------------

            if (
                !colorInput.value.trim()
            ) {

                showFieldError(
                    "editColorError",
                    "Color is required"
                );

                isValid = false;

            }


            // ---------------------------------------------
            // STOCK
            // ---------------------------------------------

            if (
                stockInput.value.trim() === "" ||
                Number(stockInput.value) < 0
            ) {

                showFieldError(
                    "editStockError",
                    "Please enter a valid stock"
                );

                isValid = false;

            }


            // ---------------------------------------------
            // PRICE
            // ---------------------------------------------

            if (
                priceInput.value.trim() === "" ||
                Number(priceInput.value) <= 0
            ) {

                showFieldError(
                    "editPriceError",
                    "Please enter a valid price"
                );

                isValid = false;

            }


            // ---------------------------------------------
            // OFFER PRICE
            // ---------------------------------------------

            if (
                offerPriceInput.value.trim() !== "" &&
                Number(offerPriceInput.value) < 0
            ) {

                showFieldError(
                    "editOfferPriceError",
                    "Offer price cannot be negative"
                );

                isValid = false;

            }


            // ---------------------------------------------
            // IMAGE
            // ---------------------------------------------

            if (!hasAnyImage()) {

                showImageError(
                    "At least one image is required"
                );

                isValid = false;

            }


            // ---------------------------------------------
            // STOP
            // ---------------------------------------------

            if (!isValid) {

                event.preventDefault();

                return;

            }


            // ---------------------------------------------
            // PREPARE CROPPED FILES
            // ---------------------------------------------

            const dataTransfer =
                new DataTransfer();


            [
                "editBox1",
                "editBox2",
                "editBox3"
            ]
            .forEach(boxId => {

                const file =
                    croppedFiles[boxId];


                if (file) {

                    dataTransfer.items.add(file);

                }

            });


            imageInput.files =
                dataTransfer.files;

        }
    );


    // =====================================================
    // CHECK IMAGE
    // =====================================================

    function hasAnyImage() {

        return [
            "editBox1",
            "editBox2",
            "editBox3"
        ]
        .some(boxId => {

            return !!(
                existingImages[boxId] ||
                croppedFiles[boxId]
            );

        });

    }


    // =====================================================
    // FIELD ERROR
    // =====================================================

    function showFieldError(
        elementId,
        message
    ) {

        const element =
            document.getElementById(
                elementId
            );


        if (element) {

            element.textContent =
                message;

        }

    }


    // =====================================================
    // IMAGE ERROR
    // =====================================================

    function showImageError(message) {

        const error =
            document.getElementById(
                "editImageError"
            );


        error.textContent =
            message;

    }


    // =====================================================
    // REMOVE ERROR WHILE TYPING
    // =====================================================

    [
        "editColor",
        "editStock",
        "editPrice",
        "editOfferPrice"
    ]
    .forEach(inputId => {

        const input =
            document.getElementById(inputId);


        if (!input) {
            return;
        }


        input.addEventListener(
            "input",
            function () {

                const errorId =
                    inputId + "Error";


                const error =
                    document.getElementById(
                        errorId
                    );


                if (error) {

                    error.textContent = "";

                }

            }
        );

    });


    // =====================================================
    // CROP MODAL CLOSED
    // =====================================================

    cropModalElement.addEventListener(
        "hidden.bs.modal",
        function () {

            if (cropper) {

                cropper.destroy();

                cropper = null;

            }


            imageInput.value = "";

        }
    );


    // =====================================================
    // EDIT MODAL CLOSED
    // =====================================================

    editVariantModalElement.addEventListener(
        "hidden.bs.modal",
        function () {

            currentVariantId = null;

            currentBox = null;

            croppedFiles = {};

            existingImages = {};

            imageInput.value = "";

        }
    );

});

</script>

</body>

</html>