<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/admin/addVariant.css">

<body>

<div class="wrapper">

    <%- include("../partials/sidebar") %>

    <div class="main">

        <%- include("../partials/navbar") %>

        <div class="content">

            <% if(successMessage){ %>
                <div class="alert alert-success">
                    <%= successMessage %>
                </div>
            <% } %>

            <% if(errorMessage){ %>
                <div class="alert alert-danger">
                    <%= errorMessage %>
                </div>
            <% } %>

            <div class="page-title">
                <h1>Edit Product Variant</h1>
                <p>Edit variant for <strong><%= product.productName %></strong></p>
            </div>

            <div class="form-card">

                <form
                    action="/admin/products/<%= product._id %>/variants/edit/<%= variant._id %>?_method=PATCH"
                    method="POST"
                    enctype="multipart/form-data">

                    <div class="row">

                        <!-- Left Side -->

                        <div class="col-lg-7">

                            <h3 class="mb-4">Variant Information</h3>

                            <div class="mb-3">

                                <label class="form-label">Color</label>

                                <input
                                    type="text"
                                    name="color"
                                    id="color"
                                    class="form-control"
                                    value="<%= formData?.color || variant.color %>">

                                <% if(errors?.color){ %>
                                    <small class="text-danger" id="colorError">
                                        <%= errors.color %>
                                    </small>
                                <% } %>

                            </div>

                            <div class="mb-3">

                                <label class="form-label">Stock</label>

                                <input
                                    type="number"
                                    name="stock"
                                    id="stock"
                                    class="form-control"
                                    value="<%= formData?.stock || variant.stock %>">

                                <% if(errors?.stock){ %>
                                    <small class="text-danger" id="stockError">
                                        <%= errors.stock %>
                                    </small>
                                <% } %>

                            </div>

                            <div class="mb-3">

                                <label class="form-label">Price (₹)</label>

                                <input
                                    type="number"
                                    name="price"
                                    id="price"
                                    class="form-control"
                                    value="<%= formData?.price || variant.price %>">

                                <% if(errors?.price){ %>
                                    <small class="text-danger" 
                                            id="priceError">
                                        <%= errors.price %>
                                    </small>
                                <% } %>

                            </div>

                            <div class="mb-3">

                                <label class="form-label">Offer Price (₹)</label>

                                <input
                                    type="number"
                                    name="offerPrice"
                                    id="offerPrice"
                                    class="form-control"
                                    value="<%= formData?.offerPrice || variant.offerPrice %>">


                                    <% if(errors?.offerPrice){ %>

                                        <small
                                            class="text-danger"
                                            id="offerPriceError">

                                            <%= errors.offerPrice %>

                                        </small>

                                    <% } %>

                            </div>

                            <div class="mb-3">

                                <label class="form-label">Status</label>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input"
                                        type="checkbox"
                                        name="isActive"
                                        value="true"
                                        <%= (formData?.isActive !== undefined ? formData.isActive === "true" : variant.isActive) ? "checked" : "" %>>

                                    <label class="form-check-label">

                                        Active

                                    </label>

                                </div>

                            </div>
 
                            <div class="mb-3">

                                <label class="form-label">Description</label>

                                <textarea
                                    rows="5"
                                    class="form-control"
                                    name="description"><%= formData?.description || variant.description %></textarea>

                            </div>

                        </div>
                        <!-- Right Side -->

                        <div class="col-lg-5">

                            <h3 class="mb-4">Variant Images</h3>

                            <!-- Main Upload Area -->
                            <div class="image-upload-area" id="imageUploadArea">

                                <div class="upload-icon">
                                    <i class="bi bi-cloud-arrow-up"></i>
                                </div>

                                <h4>Drop files here to upload</h4>

                                <p>PNG, JPG up to 10MB each</p>

                                <button
                                    type="button"
                                    class="browse-btn"
                                    id="browseBtn">
                                    Browse Files
                                </button>

                                <input
                                    type="file"
                                    id="imageInput"
                                    name="images"
                                    accept="image/png,image/jpeg,image/jpg"
                                    multiple
                                    hidden>

                            </div>

                            <% if(errors && errors.images){ %>
                                <small class="text-danger" id="imageError">
                                    <%= errors.images %>
                                </small>
                            <% } %>


                            <!-- Three Image Preview Boxes -->

                        <div class="image-preview-container">

    <!-- IMAGE 1 -->
   <div class="small-upload" id="box1">

    <% if (variant.images?.[0]) { %>

        <img
            id="preview1"
            src="/uploads/variants/<%= variant.images[0] %>"
            alt="Image 1"
            style="display:block;">

        <span
            class="plus"
            id="plus1"
            style="display:none;">
            +
        </span>

        <div
            class="image-actions"
            id="actions1"
            style="display:flex;">

            <button
                type="button"
                class="edit-image"
                data-box="box1"
                data-existing="<%= variant.images[0] %>">
                ✎
            </button>

            <button
                type="button"
                class="remove-image"
                data-box="box1"
                data-existing="<%= variant.images?.[0] || '' %>">
                ×
            </button>

        </div>

    <% } else { %>

        <span class="plus" id="plus1">+</span>

        <img
            id="preview1"
            alt="Image 1"
            style="display:none;">

        <div
            class="image-actions"
            id="actions1"
            style="display:none;">

            <button
                type="button"
                class="edit-image"
                data-box="box1">
                ✎
            </button>

            <button
                type="button"
                class="remove-image"
                data-box="box1">
                ×
            </button>

        </div>

    <% } %>

</div>


  <!-- IMAGE 2 -->
<div class="small-upload" id="box2">

    <% if (variant.images?.[1]) { %>

        <img
            id="preview2"
            src="/uploads/variants/<%= variant.images[1] %>"
            alt="Image 2"
            style="display:block;">

        <span
            class="plus"
            id="plus2"
            style="display:none;">
            +
        </span>

        <div
            class="image-actions"
            id="actions2"
            style="display:flex;">

            <button
                type="button"
                class="edit-image"
                data-box="box2"
                data-existing="<%= variant.images[1] %>">
                ✎
            </button>

            <button
                type="button"
                class="remove-image"
                data-box="box2"
                data-existing="<%= variant.images?.[1] || '' %>">
                ×
            </button>

        </div>

    <% } else { %>

        <span
            class="plus"
            id="plus2">
            +
        </span>

        <img
            id="preview2"
            alt="Image 2"
            style="display:none;">

        <div
            class="image-actions"
            id="actions2"
            style="display:none;">

            <button
                type="button"
                class="edit-image"
                data-box="box2">
                ✎
            </button>

            <button
                type="button"
                class="remove-image"
                data-box="box2">
                ×
            </button>

        </div>

    <% } %>

</div>


    <!-- IMAGE 3 -->
<div class="small-upload" id="box3">

    <% if (variant.images?.[2]) { %>

        <img
            id="preview3"
            src="/uploads/variants/<%= variant.images[2] %>"
            alt="Image 3"
            style="display:block;">

        <span
            class="plus"
            id="plus3"
            style="display:none;">
            +
        </span>

        <div
            class="image-actions"
            id="actions3"
            style="display:flex;">

            <button
                type="button"
                class="edit-image"
                data-box="box3"
                data-existing="<%= variant.images[2] %>">
                ✎
            </button>

            <button
                type="button"
                class="remove-image"
                data-box="box3"
                data-existing="<%= variant.images?.[2] || '' %>">
                ×
            </button>

        </div>

    <% } else { %>

        <span
            class="plus"
            id="plus3">
            +
        </span>

        <img
            id="preview3"
            alt="Image 3"
            style="display:none;">

        <div
            class="image-actions"
            id="actions3"
            style="display:none;">

            <button
                type="button"
                class="edit-image"
                data-box="box3">
                ✎
            </button>

            <button
                type="button"
                class="remove-image"
                data-box="box3">
                ×
            </button>

        </div>

    <% } %>

</div>

</div>

<div id="removedImagesContainer"></div>


<div class="modal fade" id="cropModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Adjust Image</h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body text-center">

                <div class="crop-container">
                    <img id="cropImage">
                </div>

            </div>

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">
                    Cancel
                </button>

                <button
                    type="button"
                    class="btn btn-primary"
                    id="cropButton">
                    Crop & Fix
                </button>

            </div>

        </div>
    </div>
</div>

                        

                    </div>

                


                    <div class="text-end mt-4">

                        <a
                            href="/admin/products/<%= product._id %>/variants"
                            class="btn btn-outline-secondary me-2">

                            Cancel

                        </a>

                        <button
                            type="submit"
                            class="btn btn-primary">

                            Update Variant

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css">

<script
    src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js">
</script>

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

<script>

// ======================================================
// EDIT VARIANT - IMAGE + CROPPER
// ======================================================

const imageInput =
    document.getElementById("imageInput");

const cropModalElement =
    document.getElementById("cropModal");

const cropModal =
    new bootstrap.Modal(cropModalElement);

const cropImage =
    document.getElementById("cropImage");

const cropButton =
    document.getElementById("cropButton");

const form =
    document.querySelector("form");


let cropper = null;

let currentBox = null;

// Newly selected / cropped files
let croppedFiles = {};


// ======================================================
// 1. CLICK IMAGE BOX
// ======================================================

document.querySelectorAll(".small-upload").forEach(box => {

    box.addEventListener("click", function(e) {

        // Don't open file picker when clicking
        // Edit or Remove buttons

        if (
            e.target.closest(".edit-image") ||
            e.target.closest(".remove-image")
        ) {
            return;
        }

        // Store selected box

        currentBox = this.id;

        // Open file picker

        imageInput.click();

    });

});


// ======================================================
// 2. SELECT NEW IMAGE
// ======================================================

imageInput.addEventListener("change", function() {

    const file = this.files[0];

    if (!file) {
        return;
    }


    // Check image type

    if (!file.type.startsWith("image/")) {

        alert("Please select an image.");

        imageInput.value = "";

        return;

    }


    // Open crop modal

    openCropModal(file);

});


// ======================================================
// 3. OPEN CROP MODAL
// ======================================================

function openCropModal(file) {

    const reader =
        new FileReader();


    reader.onload = function(e) {

        cropImage.src =
            e.target.result;

        cropModal.show();

    };


    reader.readAsDataURL(file);

}


// ======================================================
// 4. INITIALIZE CROPPER
// ======================================================

cropModalElement.addEventListener(
    "shown.bs.modal",
    function() {

        // Destroy old cropper

        if (cropper) {

            cropper.destroy();

            cropper = null;

        }


        // Create cropper

        cropper =
            new Cropper(
                cropImage,
                {
                    aspectRatio: 1,

                    viewMode: 1,

                    dragMode: "move",

                    autoCropArea: 1,

                    responsive: true,

                    background: false
                }
            );

    }
);


// ======================================================
// 5. CROP & FIX
// ======================================================

cropButton.addEventListener(
    "click",
    function() {

        if (!cropper || !currentBox) {

            return;

        }


        const canvas =
            cropper.getCroppedCanvas({

                width: 800,

                height: 800

            });


        canvas.toBlob(
            function(blob) {

                if (!blob) {

                    alert(
                        "Unable to crop image."
                    );

                    return;

                }


                // Create new cropped file

                const file =
                    new File(
                        [blob],

                        `variant-image-${Date.now()}.jpg`,

                        {
                            type: "image/jpeg"
                        }
                    );


                // Store new file

                croppedFiles[currentBox] =
                    file;


                // --------------------------------------
                // Remove image validation errors
                // --------------------------------------

                const imageError =
                    document.getElementById(
                        "imageError"
                    );

                if (imageError) {

                    imageError.remove();

                }


                const clientImageError =
                    document.getElementById("clientImageError");

                if (clientImageError) {
                    clientImageError.remove();
                }


                // --------------------------------------
                // Get current box
                // --------------------------------------

                const box =
                    document.getElementById(
                        currentBox
                    );


                const preview =
                    box.querySelector("img");


                const plus =
                    box.querySelector(".plus");


                const actions =
                    box.querySelector(
                        ".image-actions"
                    );


                // --------------------------------------
                // Show image
                // --------------------------------------

                preview.src =
                    URL.createObjectURL(file);

                preview.style.display =
                    "block";


                // Hide +

                plus.style.display =
                    "none";


                // Show buttons

                actions.style.display =
                    "flex";


                // Close modal

                cropModal.hide();


                // Destroy cropper

                if (cropper) {

                    cropper.destroy();

                    cropper = null;

                }


                // Clear file input

                imageInput.value = "";

            },

            "image/jpeg",

            0.9
        );

    }
);


// ======================================================
// 6. EDIT / CROP EXISTING IMAGE
// ======================================================

document.querySelectorAll(".edit-image")
    .forEach(button => {

        button.addEventListener(
            "click",
            async function(e) {

                e.stopPropagation();


                // Current box

                currentBox =
                    this.dataset.box;


                // Existing database image

                const existingImage =
                    this.dataset.existing;


                // --------------------------------------
                // If this is a newly cropped image
                // --------------------------------------

                if (!existingImage) {

                    const existingFile =
                        croppedFiles[currentBox];


                    if (existingFile) {

                        openCropModal(
                            existingFile
                        );

                    }

                    return;

                }


                // --------------------------------------
                // Existing database image
                // --------------------------------------

                try {

                    const response =
                        await fetch(
                            `/uploads/variants/${existingImage}`
                        );


                    if (!response.ok) {

                        throw new Error(
                            "Image could not be loaded"
                        );

                    }


                    const blob =
                        await response.blob();


                    const file =
                        new File(
                            [blob],

                            existingImage,

                            {
                                type: blob.type
                            }
                        );


                    // Open cropper

                    openCropModal(file);

                }
                catch(error) {

                    console.error(error);

                    alert(
                        "Unable to edit image."
                    );

                }

            }
        );

    });


// ======================================================
// 7. REMOVE IMAGE
// ======================================================

document.querySelectorAll(".remove-image")
    .forEach(button => {

        button.addEventListener(
            "click",
            function(e) {

                e.stopPropagation();


                // Current box

                const boxId =
                    this.dataset.box;


                // Existing database image

                const existingImage =
                    this.dataset.existing;


                // --------------------------------------
                // Existing image
                // --------------------------------------

                if (existingImage) {

                    const removedInput =
                        document.createElement(
                            "input"
                        );


                    removedInput.type =
                        "hidden";


                    removedInput.name =
                        "removedImages[]";


                    removedInput.value =
                        existingImage;


                    document
                        .getElementById(
                            "removedImagesContainer"
                        )
                        .appendChild(
                            removedInput
                        );

                }


                // --------------------------------------
                // Remove newly cropped file
                // --------------------------------------

                delete croppedFiles[boxId];


                // Get box

                const box =
                    document.getElementById(
                        boxId
                    );


                const preview =
                    box.querySelector("img");


                const plus =
                    box.querySelector(".plus");


                const actions =
                    box.querySelector(
                        ".image-actions"
                    );


                // Remove preview

                preview.src = "";

                preview.style.display =
                    "none";


                // Show +

                plus.style.display =
                    "block";


                // Hide buttons

                actions.style.display =
                    "none";


                // Clear existing image reference

                box.dataset.existingImage =
                    "";

                button.dataset.existing =
                    "";

            }
        );

    });


// ======================================================
// 8. WHEN CROP MODAL CLOSES
// ======================================================

cropModalElement.addEventListener(
    "hidden.bs.modal",
    function() {

        if (cropper) {

            cropper.destroy();

            cropper = null;

        }


        imageInput.value = "";

    }
);


// ======================================================
// 9. CHECK WHETHER ANY IMAGE EXISTS
// ======================================================

function hasAnyImage() {

    const boxes =
        document.querySelectorAll(
            ".small-upload"
        );


    return [...boxes].some(box => {

        const preview =
            box.querySelector("img");


        if (!preview) {

            return false;

        }


        return (
            preview.style.display !== "none" &&
            preview.src !== ""
        );

    });

}


// ======================================================
// 10. FORM VALIDATION
// ======================================================

form.addEventListener(
    "submit",
    function(e) {

        let isValid = true;


        // ----------------------------------------------
        // Get fields
        // ----------------------------------------------

        const color =
            document.getElementById("color");


        const stock =
            document.getElementById("stock");


        const price =
            document.getElementById("price");


        // ----------------------------------------------
        // Remove previous CLIENT errors
        // ----------------------------------------------

        document
            .querySelectorAll(
                ".client-error"
            )
            .forEach(error => {

                error.remove();

            });


        // =================================================
        // COLOR
        // =================================================

        if (
            !color.value.trim()
        ) {

            showError(
                color,
                "Color is required"
            );

            isValid = false;

        }


        // =================================================
        // STOCK
        // =================================================

        if (
            stock.value.trim() === "" ||
            Number(stock.value) < 0
        ) {

            showError(
                stock,
                "Please enter a valid stock"
            );

            isValid = false;

        }


        // =================================================
        // PRICE
        // =================================================

        if (
            price.value.trim() === "" ||
            Number(price.value) <= 0
        ) {

            showError(
                price,
                "Please enter a valid price"
            );

            isValid = false;

        }


        // =================================================
        // IMAGE
        // =================================================

        if (!hasAnyImage()) {

            const error =
                document.createElement(
                    "small"
                );


            error.className =
                "text-danger client-error";


            error.id =
                "clientImageError";


            error.textContent =
                "At least one image is required";


            document
                .getElementById(
                    "imageUploadArea"
                )
                .insertAdjacentElement(
                    "afterend",
                    error
                );


            isValid = false;

        }


        // =================================================
        // STOP SUBMISSION
        // =================================================

        if (!isValid) {

            e.preventDefault();

            return;

        }


        // =================================================
        // PREPARE NEW CROPPED IMAGES
        // =================================================

        const dataTransfer =
            new DataTransfer();


        [
            "box1",
            "box2",
            "box3"
        ].forEach(boxId => {

            const file =
                croppedFiles[boxId];


            if (file) {

                dataTransfer.items.add(
                    file
                );

            }

        });


        // Put new files into input

        imageInput.files =
            dataTransfer.files;

    }
);


// ======================================================
// 11. SHOW CLIENT ERROR
// ======================================================

function showError(
    input,
    message
) {

    const error =
        document.createElement(
            "small"
        );


    error.className =
        "text-danger client-error";


    error.textContent =
        message;


    input.parentElement.appendChild(
        error
    );

}


// ======================================================
// 12. REMOVE ERROR WHEN USER TYPES
// ======================================================

const fields = [

    {
        input: "color",
        error: "colorError"
    },

    {
        input: "stock",
        error: "stockError"
    },

    {
        input: "price",
        error: "priceError"
    },

    {
        input: "offerPrice",
        error: "offerPriceError"
    }

];


fields.forEach(field => {

    const input =
        document.getElementById(
            field.input
        );


    if (!input) {

        return;

    }


    input.addEventListener(
        "input",
        function() {

            // Remove client error

            const clientError =
                input.parentElement
                    .querySelector(
                        ".client-error"
                    );


            if (clientError) {

                clientError.remove();

            }


            // Remove server error

            const serverError =
                document.getElementById(
                    field.error
                );


            if (serverError) {

                serverError.remove();

            }

        }
    );

});


// ======================================================
// 13. REMOVE IMAGE ERROR WHEN IMAGE IS SELECTED
// ======================================================

imageInput.addEventListener(
    "change",
    function() {

        const error =
            document.getElementById(
                "imageError"
            );


        if (error) {

            error.remove();

        }

    }
);

</script>

</body>

</html>