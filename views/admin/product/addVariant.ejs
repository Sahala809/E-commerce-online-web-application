<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/admin/addVariant.css">

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css"
>

<body>

<div class="wrapper">

    <!-- SIDEBAR -->
    <%- include("../partials/sidebar") %>

    <div class="main">

        <!-- NAVBAR -->
        <%- include("../partials/navbar") %>

        <div class="content">

            <!-- ================================================= -->
            <!-- PAGE HEADER -->
            <!-- ================================================= -->

            <div class="page-title d-flex justify-content-between align-items-center">

                <div>
                    <h1>Product Variants</h1>

                    <p>
                        Manage variants for
                        <strong>
                            <%= product.productName %>
                        </strong>
                    </p>
                </div>

                <!-- ADD VARIANT -->
                <a
                    href="/admin/products/<%= product._id %>/variants/add"
                    class="btn btn-primary"
                >
                    <i class="bi bi-plus-lg me-1"></i>
                    Add Variant
                </a>

            </div>


            <!-- ================================================= -->
            <!-- SUCCESS MESSAGE -->
            <!-- ================================================= -->

            <% if (successMessage) { %>

                <div
                    class="alert alert-success alert-dismissible fade show"
                    role="alert"
                >
                    <%= successMessage %>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                    ></button>
                </div>

            <% } %>


            <!-- ================================================= -->
            <!-- ERROR MESSAGE -->
            <!-- ================================================= -->

            <% if (errorMessage) { %>

                <div
                    class="alert alert-danger alert-dismissible fade show"
                    role="alert"
                >
                    <%= errorMessage %>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                    ></button>
                </div>

            <% } %>


            <!-- ================================================= -->
            <!-- VARIANT TABLE -->
            <!-- ================================================= -->

            <div class="table-card">

                <div class="mb-4">

                    <h3 class="mb-1">
                        Added Variants
                    </h3>

                    <p class="text-muted mb-0">

                        Product variants available for

                        <strong>
                            <%= product.productName %>
                        </strong>

                    </p>

                </div>


                <div class="table-responsive">

                    <table class="table">

                        <thead>

                            <tr>

                                <th>#</th>

                                <th>Image</th>

                                <th>Color</th>

                                <th>Stock</th>

                                <th>Price</th>

                                <th>Offer Price</th>

                                <th>Status</th>

                                <th>Action</th>

                            </tr>

                        </thead>


                        <tbody>

                        <% if (!variants || variants.length === 0) { %>

                            <tr>

                                <td
                                    colspan="8"
                                    class="text-center"
                                >
                                    No variants added.
                                </td>

                            </tr>

                        <% } else { %>


                            <% variants.forEach((variant, index) => { %>

                                <tr>

                                    <!-- NUMBER -->

                                    <td>
                                        <%= skip + index + 1 %>
                                    </td>


                                    <!-- IMAGE -->

                                    <td>

                                        <% if (
                                            variant.images &&
                                            variant.images.length > 0
                                        ) { %>

                                            <img
                                                src="/uploads/variants/<%= variant.images[0] %>"
                                                alt="<%= variant.color %>"
                                                class="variant-image"
                                                width="60"
                                                height="60"
                                            >

                                        <% } else { %>

                                            <span>
                                                No Image
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- COLOR -->

                                    <td>
                                        <%= variant.color %>
                                    </td>


                                    <!-- STOCK -->

                                    <td>
                                        <%= variant.stock %>
                                    </td>


                                    <!-- PRICE -->

                                    <td>
                                        ₹<%= variant.price %>
                                    </td>


                                    <!-- OFFER PRICE -->

                                    <td>

                                        <% if (
                                            variant.offerPrice !== undefined &&
                                            variant.offerPrice !== null &&
                                            variant.offerPrice !== ""
                                        ) { %>

                                            ₹<%= variant.offerPrice %>

                                        <% } else { %>

                                            —

                                        <% } %>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <% if (variant.isActive) { %>

                                            <span class="badge bg-success">
                                                Active
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- ACTION -->

                                    <td>

                                        <div class="dropdown">

                                            <button
                                                class="btn btn-sm border-0 bg-transparent"
                                                type="button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                            >

                                                <i class="bi bi-three-dots-vertical"></i>

                                            </button>


                                            <ul class="dropdown-menu">

                                                <!-- ============================= -->
                                                <!-- EDIT -->
                                                <!-- ============================= -->

                                                <li>

                                                    <button
                                                        type="button"
                                                        class="dropdown-item edit-variant-btn"

                                                        data-bs-toggle="modal"
                                                        data-bs-target="#editVariantModal"

                                                        data-id="<%= variant._id %>"

                                                        data-color="<%= variant.color || '' %>"

                                                        data-stock="<%= variant.stock ?? '' %>"

                                                        data-price="<%= variant.price ?? '' %>"

                                                        data-offer-price="<%= variant.offerPrice ?? '' %>"

                                                        data-description="<%= variant.description || '' %>"

                                                        data-active="<%= variant.isActive ? 'true' : 'false' %>"
                                                    >

                                                        <i class="bi bi-pencil-square me-2"></i>

                                                        Edit Variant

                                                    </button>

                                                </li>


                                                <!-- ============================= -->
                                                <!-- DELETE -->
                                                <!-- ============================= -->

                                                <li>

                                                    <form
                                                        action="/admin/products/<%= product._id %>/variants/delete/<%= variant._id %>?_method=DELETE"
                                                        method="POST"
                                                        onsubmit="return confirm('Are you sure you want to delete this variant?')"
                                                    >

                                                        <button
                                                            type="submit"
                                                            class="dropdown-item text-danger"
                                                        >

                                                            <i class="bi bi-trash me-2"></i>

                                                            Delete Variant

                                                        </button>

                                                    </form>

                                                </li>

                                            </ul>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        <% } %>

                        </tbody>

                    </table>

                </div>


                <!-- ================================================= -->
                <!-- PAGINATION -->
                <!-- ================================================= -->

                <div class="pagination">

                    <% if (page > 1) { %>

                        <a
                            href="/admin/products/<%= product._id %>/variants?page=<%= page - 1 %>"
                        >
                            Previous
                        </a>

                    <% } %>


                    <span>

                        Page
                        <%= page %>
                        of
                        <%= totalPages || 1 %>

                    </span>


                    <% if (page < totalPages) { %>

                        <a
                            href="/admin/products/<%= product._id %>/variants?page=<%= page + 1 %>"
                        >
                            Next
                        </a>

                    <% } %>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- BOTTOM BUTTONS -->
            <!-- ================================================= -->

            <div class="d-flex justify-content-end gap-3 mt-4">

                <a
                    href="/admin/products/<%= product._id %>/variants/add"
                    class="btn btn-outline-primary"
                >

                    <i class="bi bi-plus-lg me-1"></i>

                    Add Another Variant

                </a>


                <a
                    href="/admin/products"
                    class="btn btn-success"
                >

                    Finish Product

                </a>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- EDIT VARIANT MODAL -->
<!-- ========================================================= -->

<div
    class="modal fade"
    id="editVariantModal"
    tabindex="-1"
    aria-labelledby="editVariantModalLabel"
    aria-hidden="true"
>

    <div
        class="modal-dialog modal-lg modal-dialog-scrollable"
    >

        <div class="modal-content">


            <!-- HEADER -->

            <div class="modal-header">

                <div>

                    <h5
                        class="modal-title"
                        id="editVariantModalLabel"
                    >
                        Edit Product Variant
                    </h5>

                    <small class="text-muted">

                        <%= product.productName %>

                    </small>

                </div>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>


            <!-- FORM -->

            <form
                id="editVariantForm"
                method="POST"
                novalidate
            >

                <input
                    type="hidden"
                    name="_method"
                    value="PUT"
                >

                <div class="modal-body">


                    <!-- COLOR -->

                    <div class="mb-3">

                        <label
                            for="editColor"
                            class="form-label"
                        >
                            Color
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="editColor"
                            name="color"
                        >

                        <small
                            class="text-danger"
                            id="editColorError"
                        ></small>

                    </div>


                    <!-- STOCK -->

                    <div class="mb-3">

                        <label
                            for="editStock"
                            class="form-label"
                        >
                            Stock
                        </label>

                        <input
                            type="number"
                            class="form-control"
                            id="editStock"
                            name="stock"
                            min="0"
                        >

                        <small
                            class="text-danger"
                            id="editStockError"
                        ></small>

                    </div>


                    <!-- PRICE -->

                    <div class="mb-3">

                        <label
                            for="editPrice"
                            class="form-label"
                        >
                            Price (₹)
                        </label>

                        <input
                            type="number"
                            class="form-control"
                            id="editPrice"
                            name="price"
                            min="0"
                            step="0.01"
                        >

                        <small
                            class="text-danger"
                            id="editPriceError"
                        ></small>

                    </div>


                    <!-- OFFER PRICE -->

                    <div class="mb-3">

                        <label
                            for="editOfferPrice"
                            class="form-label"
                        >
                            Offer Price (₹)
                        </label>

                        <input
                            type="number"
                            class="form-control"
                            id="editOfferPrice"
                            name="offerPrice"
                            min="0"
                            step="0.01"
                        >

                        <small
                            class="text-danger"
                            id="editOfferPriceError"
                        ></small>

                    </div>


                    <!-- STATUS -->

                    <div class="mb-3">

                        <label class="form-label">
                            Status
                        </label>

                        <div class="form-check form-switch">

                            <input
                                class="form-check-input"
                                type="checkbox"
                                id="editIsActive"
                                name="isActive"
                                value="true"
                            >

                            <label
                                class="form-check-label"
                                for="editIsActive"
                            >
                                Active
                            </label>

                        </div>

                    </div>


                    <!-- DESCRIPTION -->

                    <div class="mb-3">

                        <label
                            for="editDescription"
                            class="form-label"
                        >
                            Description
                        </label>

                        <textarea
                            class="form-control"
                            id="editDescription"
                            name="description"
                            rows="5"
                        ></textarea>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="btn btn-primary"
                    >

                        <i class="bi bi-check-lg me-1"></i>

                        Update Variant

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- VALIDATION ERROR MODAL -->
<!-- ========================================================= -->

<div
    class="modal fade"
    id="validationErrorModal"
    tabindex="-1"
    aria-hidden="true"
>

    <div
        class="modal-dialog modal-dialog-centered modal-sm"
    >

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Validation Error
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>


            <div class="modal-body text-center">

                <i
                    class="bi bi-exclamation-circle-fill text-danger"
                    style="font-size:45px;"
                ></i>

                <p
                    id="validationErrorMessage"
                    class="mt-3 mb-0"
                ></p>

            </div>


            <div class="modal-footer justify-content-center">

                <button
                    type="button"
                    class="btn btn-primary"
                    data-bs-dismiss="modal"
                >
                    OK
                </button>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- BOOTSTRAP -->
<!-- ========================================================= -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


<!-- ========================================================= -->
<!-- EDIT VARIANT JAVASCRIPT -->
<!-- ========================================================= -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const editButtons =
        document.querySelectorAll(".edit-variant-btn");

    const editForm =
        document.getElementById("editVariantForm");

    const editColor =
        document.getElementById("editColor");

    const editStock =
        document.getElementById("editStock");

    const editPrice =
        document.getElementById("editPrice");

    const editOfferPrice =
        document.getElementById("editOfferPrice");

    const editDescription =
        document.getElementById("editDescription");

    const editIsActive =
        document.getElementById("editIsActive");


    /*
    ============================================================
    OPEN EDIT MODAL
    ============================================================
    */

    editButtons.forEach(button => {

        button.addEventListener("click", function () {

            const variantId =
                this.dataset.id;

            const color =
                this.dataset.color || "";

            const stock =
                this.dataset.stock || "";

            const price =
                this.dataset.price || "";

            const offerPrice =
                this.dataset.offerPrice || "";

            const description =
                this.dataset.description || "";

            const active =
                this.dataset.active === "true";


            /*
            SET FORM VALUES
            */

            editColor.value =
                color;

            editStock.value =
                stock;

            editPrice.value =
                price;

            editOfferPrice.value =
                offerPrice;

            editDescription.value =
                description;

            editIsActive.checked =
                active;


            /*
            SET UPDATE ACTION
            */

            editForm.action =
                `/admin/products/<%= product._id %>/variants/edit/${variantId}`;

        });

    });


    /*
    ============================================================
    EDIT VALIDATION
    ============================================================
    */

    editForm.addEventListener("submit", function (e) {

        e.preventDefault();


        /*
        CLEAR ERRORS
        */

        document.getElementById("editColorError").textContent = "";
        document.getElementById("editStockError").textContent = "";
        document.getElementById("editPriceError").textContent = "";
        document.getElementById("editOfferPriceError").textContent = "";


        /*
        COLOR
        */

        if (editColor.value.trim() === "") {

            document.getElementById("editColorError").textContent =
                "Color is required.";

            editColor.focus();

            return;

        }


        /*
        STOCK
        */

        if (
            editStock.value.trim() === "" ||
            Number(editStock.value) < 0
        ) {

            document.getElementById("editStockError").textContent =
                "Please enter a valid stock.";

            editStock.focus();

            return;

        }


        /*
        PRICE
        */

        if (
            editPrice.value.trim() === "" ||
            Number(editPrice.value) <= 0
        ) {

            document.getElementById("editPriceError").textContent =
                "Price must be greater than 0.";

            editPrice.focus();

            return;

        }


        /*
        OFFER PRICE
        */

        if (
            editOfferPrice.value.trim() !== "" &&
            Number(editOfferPrice.value) < 0
        ) {

            document.getElementById("editOfferPriceError").textContent =
                "Offer price cannot be negative.";

            editOfferPrice.focus();

            return;

        }


        /*
        OFFER PRICE MUST BE LESS THAN PRICE
        */

        if (
            editOfferPrice.value.trim() !== "" &&
            Number(editOfferPrice.value) >= Number(editPrice.value)
        ) {

            document.getElementById("editOfferPriceError").textContent =
                "Offer price must be less than regular price.";

            editOfferPrice.focus();

            return;

        }


        /*
        SUBMIT
        */

        this.submit();

    });

});

</script>


</body>

</html>