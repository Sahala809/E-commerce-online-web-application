<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/admin/addVariant.css">

<body>

<div class="wrapper">

    <%- include("../partials/sidebar") %>

    <div class="main">

        <%- include("../partials/navbar") %>

        <div class="content">

            <% if(successMessage){ %>
                <div class="alert alert-success">
                    <%= successMessage %>
                </div>
            <% } %>

            <% if(errorMessage){ %>
                <div class="alert alert-danger">
                    <%= errorMessage %>
                </div>
            <% } %>

            <div class="page-title">
                <h1>Add Product Variant</h1>
                <p>Add variants for <strong><%= product.productName %></strong></p>
            </div>

            <div class="form-card">

                <form
                    action="/admin/products/<%= product._id %>/variants"
                    method="POST"
                    enctype="multipart/form-data">

                    <div class="row">

                        <!-- Left Side -->

                        <div class="col-lg-7">

                            <h3 class="mb-4">Variant Information</h3>

                            <div class="mb-3">
                                <label class="form-label">Color</label>

                                <input
                                    type="text"
                                    name="color"
                                    id="color"
                                    class="form-control"
                                    value="<%= formData.color || '' %>">

                                <% if(errors.color){ %>
                                    <small class="text-danger" id="colorError"><%= errors.color %></small>
                                <% } %>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Stock</label>

                                <input
                                    type="number"
                                    name="stock"
                                    id="stock"
                                    class="form-control"
                                    value="<%= formData.stock || '' %>">

                                <% if(errors.stock){ %>
                                    <small class="text-danger" id="stockError"><%= errors.stock %></small>
                                <% } %>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Price (₹)</label>

                                <input
                                    type="number"
                                    name="price"
                                    id="price"
                                    class="form-control"
                                    value="<%= formData.price || '' %>">

                                <% if(errors.price){ %>
                                    <small class="text-danger" id="priceError"><%= errors.price %></small>
                                <% } %>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Offer Price (₹)</label>

                                <input
                                    type="number"
                                    name="offerPrice"
                                    class="form-control"
                                    value="<%= formData.offerPrice || '' %>">
                            </div>

                            <div class="mb-3">

                                <label class="form-label">Status</label>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input"
                                        type="checkbox"
                                        name="isActive"
                                        value="true"
                                        checked>

                                    <label class="form-check-label">
                                        Active
                                    </label>

                                </div>

                            </div>

                            <div class="mb-3">

                                <label class="form-label">Description</label>

                                <textarea
                                    rows="5"
                                    class="form-control"
                                    name="description"><%= formData.description || '' %></textarea>

                            </div>

                        </div>

                        <!-- Right Side -->

                        <div class="col-lg-5">

                            <h3 class="mb-4">Variant Images</h3>

                            <!-- Main Upload Area -->
                            <div class="image-upload-area" id="imageUploadArea">

                                <div class="upload-icon">
                                    <i class="bi bi-cloud-arrow-up"></i>
                                </div>

                                <h4>Drop files here to upload</h4>

                                <p>PNG, JPG up to 10MB each</p>

                                <button
                                    type="button"
                                    class="browse-btn"
                                    id="browseBtn">
                                    Browse Files
                                </button>

                                <input
                                    type="file"
                                    id="imageInput"
                                    name="images"
                                    accept="image/png,image/jpeg,image/jpg"
                                    multiple
                                    hidden>

                            </div>

                            <% if(errors && errors.images){ %>
                                <small class="text-danger" id="clientImageError">
                                    <%= errors.images %>
                                </small>
                            <% } %>


                            <!-- Three Image Preview Boxes -->

                        <div class="image-preview-container">

    <!-- IMAGE 1 -->
    <div class="small-upload" id="box1">

        <span class="plus" id="plus1">+</span>

        <img id="preview1" alt="Image 1">

        <div class="image-actions" id="actions1" style="display:none;">

            <button type="button" class="edit-image" data-box="box1">
                ✎
            </button>

            <button type="button" class="remove-image" data-box="box1">
                ×
            </button>

        </div>

    </div>


    <!-- IMAGE 2 -->
    <div class="small-upload" id="box2">

        <span class="plus" id="plus2">+</span>

        <img id="preview2" alt="Image 2">

        <div class="image-actions" id="actions2" style="display:none;">

            <button type="button" class="edit-image" data-box="box2">
                ✎
            </button>

            <button type="button" class="remove-image" data-box="box2">
                ×
            </button>

        </div>

    </div>


    <!-- IMAGE 3 -->
    <div class="small-upload" id="box3">

        <span class="plus" id="plus3">+</span>

        <img id="preview3" alt="Image 3">

        <div class="image-actions" id="actions3" style="display:none;">

            <button type="button" class="edit-image" data-box="box3">
                ✎
            </button>

            <button type="button" class="remove-image" data-box="box3">
                ×
            </button>

        </div>

    </div>

</div>


<div class="modal fade" id="cropModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Adjust Image</h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body text-center">

                <div class="crop-container">
                    <img id="cropImage">
                </div>

            </div>

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">
                    Cancel
                </button>

                <button
                    type="button"
                    class="btn btn-primary"
                    id="cropButton">
                    Crop & Fix
                </button>

            </div>

        </div>
    </div>
</div>

                        

                    </div>

                    <div class="text-end mt-4">

                        <button
                            type="submit"
                            class="btn btn-primary">

                            Save Variant

                        </button>

                    </div>

                </form>

            </div>

            <div class="table-card mt-5">

                <h3 class="mb-4">Added Variants</h3>

                <table class="table">

                    <thead>

                        <tr>

                            <th>#</th>
                            <th>Image</th>
                            <th>Color</th>
                            <th>Stock</th>
                            <th>Price</th>
                            <th>Offer Price</th>
                            <th>Status</th>
                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                    <% if(variants.length === 0){ %>

                        <tr>
                            <td colspan="7" class="text-center">
                                No variants added.
                            </td>
                        </tr>

                    <% } else { %>

                        <% variants.forEach((variant,index)=>{ %>

                        <tr>

                           <td><%= skip + index + 1 %></td>

                            <td>

                                <% if (variant.images && variant.images.length > 0) { %>

                                    <img
                                        src="/uploads/variants/<%= variant.images[0] %>"
                                        alt="<%= variant.color %>"
                                        class="variant-image"
                                        height="60"
                                        width="60">

                                <% } else { %>

                                    <span>No Image</span>

                                <% } %>

                            </td>

                            <td><%= variant.color %></td>

                            <td><%= variant.stock %></td>

                            <td>£<%= variant.price %></td>

                            <td>£<%= variant.offerPrice %></td>

                            <td>

                                <% if(variant.isActive){ %>

                                    <span class="badge bg-success">
                                        Active
                                    </span>

                                <% }else{ %>

                                    <span class="badge bg-danger">
                                        Inactive
                                    </span>

                                <% } %>

                            </td>

                            <td>

                                <div class="dropdown">

                                    <button
                                        class="btn btn-sm border-0 bg-transparent"
                                        type="button"
                                        data-bs-toggle="dropdown">

                                        <i class="bi bi-three-dots-vertical"></i>

                                    </button>

                                    <ul class="dropdown-menu">

                                        <li>

                                            <a
                                                class="dropdown-item"
                                                href="/admin/products/<%= product._id %>/variants/edit/<%= variant._id %>">

                                                <i class="bi bi-pencil-square me-2"></i>
                                                Edit Variant

                                            </a>

                                        </li>

                                        <li>

                                            <form
                                                action="/admin/products/<%= product._id %>/variants/delete/<%= variant._id %>?_method=DELETE"
                                                method="POST"
                                                onsubmit="return confirm('Delete this variant?')">

                                                <button
                                                    type="submit"
                                                    class="dropdown-item text-danger">

                                                    <i class="bi bi-trash me-2"></i>
                                                    Delete Variant

                                                </button>

                                            </form>

                                        </li>

                                    </ul>

                                </div>

                            </td>
                        </tr>

                        <% }) %>

                    <% } %>

                    </tbody>

                </table>

            </div>

            <div class="d-flex justify-content-end gap-3 mt-4">

                <a
                    href="/admin/products/<%= product._id %>/variants"
                    class="btn btn-outline-primary">

                    + Add Another Variant

                </a>

                <a
                    href="/admin/products"
                    class="btn btn-success">

                    Finish Product

                </a>

            </div>

        </div>

    </div>

</div>

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css">

<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>

// ======================================================
// IMAGE / CROPPER VARIABLES
// ======================================================

const imageInput = document.getElementById("imageInput");

const cropModalElement = document.getElementById("cropModal");

const cropModal = new bootstrap.Modal(cropModalElement);

const cropImage = document.getElementById("cropImage");

const cropButton = document.getElementById("cropButton");

const form = document.querySelector("form");


let cropper = null;

let currentBox = null;

let croppedFiles = {};


// ======================================================
// 1. CLICK IMAGE BOX
// ======================================================

document.querySelectorAll(".small-upload").forEach(box => {

    box.addEventListener("click", function(e) {

        // Do not open file picker when clicking
        // Edit or Remove buttons

        if (
            e.target.classList.contains("edit-image") ||
            e.target.classList.contains("remove-image")
        ) {
            return;
        }


        // Store which box was clicked

        currentBox = this.id;


        // Open file picker

        imageInput.click();

    });

});


// ======================================================
// 2. SELECT IMAGE
// ======================================================

imageInput.addEventListener("change", function() {

    const file = this.files[0];


    if (!file) {
        return;
    }


    // Check whether selected file is an image

    if (!file.type.startsWith("image/")) {

        alert("Please select an image.");

        imageInput.value = "";

        return;
    }


    // Open crop popup

    openCropModal(file);

});


// ======================================================
// 3. OPEN CROP MODAL
// ======================================================

function openCropModal(file) {

    const reader = new FileReader();


    reader.onload = function(e) {

        cropImage.src = e.target.result;

        cropModal.show();

    };


    reader.readAsDataURL(file);

}


// ======================================================
// 4. INITIALIZE CROPPER
// ======================================================

cropModalElement.addEventListener(
    "shown.bs.modal",
    function() {

        // Destroy old cropper if it exists

        if (cropper) {

            cropper.destroy();

            cropper = null;

        }


        // Create cropper

        cropper = new Cropper(cropImage, {

            aspectRatio: 1,

            viewMode: 1,

            dragMode: "move",

            autoCropArea: 1,

            responsive: true,

            background: false

        });

    }
);


// ======================================================
// 5. CROP & FIX
// ======================================================

cropButton.addEventListener("click", function() {

    if (!cropper || !currentBox) {

        return;

    }


    const canvas = cropper.getCroppedCanvas({

        width: 800,

        height: 800

    });


    canvas.toBlob(function(blob) {

        if (!blob) {

            alert("Unable to crop image.");

            return;

        }


        // Create cropped file

        const file = new File(

            [blob],

            `variant-image-${Date.now()}.jpg`,

            {
                type: "image/jpeg"
            }

        );


        // Store cropped file

        croppedFiles[currentBox] = file;

        // Remove image validation error

const imageError = document.getElementById("clientImageError");

if (imageError) {
    imageError.remove();
}

const serverImageError = document.getElementById("imageError");

if (serverImageError) {
    serverImageError.remove();
}


        // Get current image box

        const box =
            document.getElementById(currentBox);


        const preview =
            box.querySelector("img");


        const plus =
            box.querySelector(".plus");


        const actions =
            box.querySelector(".image-actions");


        // Show image

        preview.src =
            URL.createObjectURL(file);

        preview.style.display =
            "block";


        // Hide +

        plus.style.display =
            "none";


        // Show Edit / Remove buttons

        actions.style.display =
            "flex";


        // Close crop modal

        cropModal.hide();


        // Destroy cropper

        if (cropper) {

            cropper.destroy();

            cropper = null;

        }


        // Clear input

        imageInput.value = "";

    }, "image/jpeg", 0.9);

});


// ======================================================
// 6. EDIT / CROP IMAGE AGAIN
// ======================================================

document.querySelectorAll(".edit-image").forEach(button => {

    button.addEventListener("click", function(e) {

        e.stopPropagation();


        // Find which image box

        currentBox =
            this.dataset.box;


        // Get existing cropped file

        const existingFile =
            croppedFiles[currentBox];


        if (!existingFile) {

            return;

        }


        // Open crop popup again

        openCropModal(existingFile);

    });

});


// ======================================================
// 7. REMOVE IMAGE
// ======================================================

document.querySelectorAll(".remove-image").forEach(button => {

    button.addEventListener("click", function(e) {

        e.stopPropagation();


        // Find box

        const boxId =
            this.dataset.box;


        // Remove file from JavaScript object

        delete croppedFiles[boxId];


        // Get box

        const box =
            document.getElementById(boxId);


        const preview =
            box.querySelector("img");


        const plus =
            box.querySelector(".plus");


        const actions =
            box.querySelector(".image-actions");


        // Remove image preview

        preview.src = "";

        preview.style.display =
            "none";


        // Show +

        plus.style.display =
            "block";


        // Hide buttons

        actions.style.display =
            "none";

    });

});


// ======================================================
// 8. WHEN CROP MODAL CLOSES
// ======================================================

cropModalElement.addEventListener(
    "hidden.bs.modal",
    function() {

        // Destroy cropper

        if (cropper) {

            cropper.destroy();

            cropper = null;

        }


        // Clear file input

        imageInput.value = "";

    }
);


// ======================================================
// 9. FORM VALIDATION + SUBMIT
// ======================================================

form.addEventListener("submit", function(e) {

    let isValid = true;


    // Get form fields

    const color =
        document.getElementById("color");


    const stock =
        document.getElementById("stock");


    const price =
        document.getElementById("price");


        


    // --------------------------------------------------
    // Remove previous CLIENT-SIDE errors
    // --------------------------------------------------

    document
        .querySelectorAll(".client-error")
        .forEach(error => {

            error.remove();

        });


    // ==================================================
    // COLOR VALIDATION
    // ==================================================

    if (color.value.trim() === "") {

        showError(
            color,
            "Color is required"
        );

        isValid = false;

    }


    // ==================================================
    // STOCK VALIDATION
    // ==================================================

    if (
        stock.value.trim() === "" ||
        Number(stock.value) < 0
    ) {

        showError(
            stock,
            "Please enter a valid stock"
        );

        isValid = false;

    }


    // ==================================================
    // PRICE VALIDATION
    // ==================================================

    if (
        price.value.trim() === "" ||
        Number(price.value) <= 0
    ) {

        showError(
            price,
            "Please enter a valid price"
        );

        isValid = false;

    }

 // ==================================================
// IMAGE VALIDATION
// ==================================================

if (Object.keys(croppedFiles).length === 0) {

    const error = document.createElement("small");

    error.className = "text-danger client-error";

    error.id = "clientImageError";

    error.textContent = "At least one image is required";

    document
        .getElementById("imageUploadArea")
        .insertAdjacentElement("afterend", error);

    isValid = false;
}


// ==================================================
// IF VALIDATION FAILED
// ==================================================

if (!isValid) {

    e.preventDefault();

    return;
}


    // ==================================================
    // PREPARE CROPPED IMAGES
    // ==================================================

    const dataTransfer =
        new DataTransfer();


    // Keep image order:
    //
    // box1 → first image
    // box2 → second image
    // box3 → third image

    ["box1", "box2", "box3"].forEach(boxId => {

        const file =
            croppedFiles[boxId];


        if (file) {

            dataTransfer.items.add(file);

        }

    });


    // Put cropped files into file input

    imageInput.files =
        dataTransfer.files;


    // Form is now allowed to submit

});


// ======================================================
// 10. SHOW CLIENT-SIDE ERROR
// ======================================================

function showError(input, message) {

    const error =
        document.createElement("small");


    error.className =
        "text-danger client-error";


    error.textContent =
        message;


    input.parentElement.appendChild(error);

}


// ======================================================
// 11. REMOVE ERROR WHEN USER TYPES
// ======================================================

["color", "stock", "price","imageInput"].forEach(id => {

    const input =
        document.getElementById(id);


    // If input doesn't exist, skip it

    if (!input) {

        return;

    }


    input.addEventListener("input", function() {

        const error =
            input.parentElement.querySelector(
                ".client-error"
            );


        if (error) {

            error.remove();

        }

    });

});

</script>

</body>
</html>
</body>

</html>