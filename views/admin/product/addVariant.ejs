<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/admin/addVariant.css">

<body>

<div class="wrapper">

    <%- include("../partials/sidebar") %>

    <div class="main">

        <%- include("../partials/navbar") %>

        <div class="content">

            <% if(successMessage){ %>
                <div class="alert alert-success">
                    <%= successMessage %>
                </div>
            <% } %>

            <% if(errorMessage){ %>
                <div class="alert alert-danger">
                    <%= errorMessage %>
                </div>
            <% } %>

            <div class="page-title">
                <h1>Add Product Variant</h1>
                <p>Add variants for <strong><%= product.productName %></strong></p>
            </div>

            <div class="form-card">

                <form
                    action="/admin/products/<%= product._id %>/variants"
                    method="POST"
                    enctype="multipart/form-data">

                    <div class="row">

                        <!-- Left Side -->

                        <div class="col-lg-7">

                            <h3 class="mb-4">Variant Information</h3>

                            <div class="mb-3">
                                <label class="form-label">Color</label>

                                <input
                                    type="text"
                                    name="color"
                                    class="form-control"
                                    value="<%= formData.color || '' %>">

                                <% if(errors.color){ %>
                                    <small class="text-danger"><%= errors.color %></small>
                                <% } %>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Stock</label>

                                <input
                                    type="number"
                                    name="stock"
                                    class="form-control"
                                    value="<%= formData.stock || '' %>">

                                <% if(errors.stock){ %>
                                    <small class="text-danger"><%= errors.stock %></small>
                                <% } %>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Price (₹)</label>

                                <input
                                    type="number"
                                    name="price"
                                    class="form-control"
                                    value="<%= formData.price || '' %>">

                                <% if(errors.price){ %>
                                    <small class="text-danger"><%= errors.price %></small>
                                <% } %>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Offer Price (₹)</label>

                                <input
                                    type="number"
                                    name="offerPrice"
                                    class="form-control"
                                    value="<%= formData.offerPrice || '' %>">
                            </div>

                            <div class="mb-3">

                                <label class="form-label">Status</label>

                                <div class="form-check form-switch">

                                    <input
                                        class="form-check-input"
                                        type="checkbox"
                                        name="isActive"
                                        value="true"
                                        checked>

                                    <label class="form-check-label">
                                        Active
                                    </label>

                                </div>

                            </div>

                            <div class="mb-3">

                                <label class="form-label">Description</label>

                                <textarea
                                    rows="5"
                                    class="form-control"
                                    name="description"><%= formData.description || '' %></textarea>

                            </div>

                        </div>

                        <!-- Right Side -->

                        <div class="col-lg-5">

                            <h3 class="mb-4">Variant Images</h3>

                            <!-- Main Upload Area -->
                            <div class="image-upload-area" id="imageUploadArea">

                                <div class="upload-icon">
                                    <i class="bi bi-cloud-arrow-up"></i>
                                </div>

                                <h4>Drop files here to upload</h4>

                                <p>PNG, JPG up to 10MB each</p>

                                <button
                                    type="button"
                                    class="browse-btn"
                                    id="browseBtn">
                                    Browse Files
                                </button>

                                <input
                                    type="file"
                                    id="imageInput"
                                    name="images"
                                    accept="image/png,image/jpeg,image/jpg"
                                    multiple
                                    hidden>

                            </div>

                            <% if(errors && errors.images){ %>
                                <small class="text-danger">
                                    <%= errors.images %>
                                </small>
                            <% } %>


                            <!-- Three Image Preview Boxes -->

                            <div class="image-preview-container">

                                <!-- IMAGE 1 -->
                                <label class="small-upload" id="box1">

                                    <span class="plus" id="plus1">+</span>

                                    <img id="preview1" alt="Image 1">

                                    <input
                                        type="file"
                                        name="images"
                                         id="imageInput"
                                        
                                        multiple
                                        hidden
                                        accept="image/png,image/jpeg,image/jpg"
                                        onchange="previewImage(this, 'preview1', 'plus1')">

                                </label>


                                <!-- IMAGE 2 -->
                                <label class="small-upload" id="box2">

                                    <span class="plus" id="plus2">+</span>

                                    <img id="preview2" alt="Image 2">

                                    <input
                                        type="file"
                                        name="images"
                                        id="imageInput"
                                        
                                        multiple
                                        hidden
                                        accept="image/png,image/jpeg,image/jpg"
                                        onchange="previewImage(this, 'preview2', 'plus2')">

                                </label>


                                <!-- IMAGE 3 -->
                                <label class="small-upload" id="box3">

                                    <span class="plus" id="plus3">+</span>

                                    <img id="preview3" alt="Image 3">

                                    <input
                                        type="file"
                                        name="images"
                                         id="imageInput"
                                        
                                        multiple
                                        hidden
                                        accept="image/png,image/jpeg,image/jpg"
                                        onchange="previewImage(this, 'preview3', 'plus3')">

                                </label>

                            </div>

                        

                    </div>

                    <div class="text-end mt-4">

                        <button
                            type="submit"
                            class="btn btn-primary">

                            Save Variant

                        </button>

                    </div>

                </form>

            </div>

            <div class="table-card mt-5">

                <h3 class="mb-4">Added Variants</h3>

                <table class="table">

                    <thead>

                        <tr>

                            <th>#</th>
                            <th>Image</th>
                            <th>Color</th>
                            <th>Stock</th>
                            <th>Price</th>
                            <th>Offer Price</th>
                            <th>Status</th>
                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                    <% if(variants.length === 0){ %>

                        <tr>
                            <td colspan="7" class="text-center">
                                No variants added.
                            </td>
                        </tr>

                    <% } else { %>

                        <% variants.forEach((variant,index)=>{ %>

                        <tr>

                           <td><%= skip + index + 1 %></td>

                            <td>

                                <% if (variant.images && variant.images.length > 0) { %>

                                    <img
                                        src="/uploads/variants/<%= variant.images[0] %>"
                                        alt="<%= variant.color %>"
                                        class="variant-image"
                                        height="60"
                                        width="60">

                                <% } else { %>

                                    <span>No Image</span>

                                <% } %>

                            </td>

                            <td><%= variant.color %></td>

                            <td><%= variant.stock %></td>

                            <td>£<%= variant.price %></td>

                            <td>£<%= variant.offerPrice %></td>

                            <td>

                                <% if(variant.isActive){ %>

                                    <span class="badge bg-success">
                                        Active
                                    </span>

                                <% }else{ %>

                                    <span class="badge bg-danger">
                                        Inactive
                                    </span>

                                <% } %>

                            </td>

                            <td>

                                <div class="dropdown">

                                    <button
                                        class="btn btn-sm border-0 bg-transparent"
                                        type="button"
                                        data-bs-toggle="dropdown">

                                        <i class="bi bi-three-dots-vertical"></i>

                                    </button>

                                    <ul class="dropdown-menu">

                                        <li>

                                            <a
                                                class="dropdown-item"
                                                href="/admin/products/<%= product._id %>/variants/edit/<%= variant._id %>">

                                                <i class="bi bi-pencil-square me-2"></i>
                                                Edit Variant

                                            </a>

                                        </li>

                                        <li>

                                            <form
                                                action="/admin/products/<%= product._id %>/variants/delete/<%= variant._id %>?_method=DELETE"
                                                method="POST"
                                                onsubmit="return confirm('Delete this variant?')">

                                                <button
                                                    type="submit"
                                                    class="dropdown-item text-danger">

                                                    <i class="bi bi-trash me-2"></i>
                                                    Delete Variant

                                                </button>

                                            </form>

                                        </li>

                                    </ul>

                                </div>

                            </td>
                        </tr>

                        <% }) %>

                    <% } %>

                    </tbody>

                </table>

            </div>

            <div class="d-flex justify-content-end gap-3 mt-4">

                <a
                    href="/admin/products/<%= product._id %>/variants"
                    class="btn btn-outline-primary">

                    + Add Another Variant

                </a>

                <a
                    href="/admin/products"
                    class="btn btn-success">

                    Finish Product

                </a>

            </div>

        </div>

    </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>

const imageInput = document.getElementById("imageInput");

imageInput.addEventListener("change", function () {

    const files = Array.from(this.files);

    if (files.length > 3) {
        alert("You can upload maximum 3 images.");
        this.value = "";
        return;
    }

    files.forEach((file, index) => {

        const preview = document.getElementById(`preview${index + 1}`);
        const box = document.getElementById(`box${index + 1}`);
        const plus = box.querySelector(".plus");

        const reader = new FileReader();

        reader.onload = function (e) {

            preview.src = e.target.result;

            preview.style.display = "block";

            plus.style.display = "none";
        };

        reader.readAsDataURL(file);

    });

});


const browseBtn = document.getElementById("browseBtn");

browseBtn.addEventListener("click", function () {

    imageInput.click();

});


const uploadArea = document.getElementById("imageUploadArea");

uploadArea.addEventListener("click", function (e) {

    if (e.target !== browseBtn) {
        imageInput.click();
    }

});


function previewImage(input, previewId, plusId) {

    const file = input.files[0];

    if (!file) {
        return;
    }

    const preview = document.getElementById(previewId);
    const plus = document.getElementById(plusId);

    const reader = new FileReader();

    reader.onload = function (e) {

        preview.src = e.target.result;

        preview.style.display = "block";

        plus.style.display = "none";
    };

    reader.readAsDataURL(file);
}

</script>

</body>
</html>
</body>

</html>