    /* =========================================================
       ADD FORM
       ========================================================= */

    const addForm =
        document.getElementById(
            "addVariantForm"
        );


    addForm.addEventListener(
        "submit",
        function (event) {

            event.preventDefault();


            clearAddErrors();


            /* =============================================
               GET VALUES
               ============================================= */

            const color =
                document
                    .getElementById("addColor")
                    .value
                    .trim();


            const stock =
                document
                    .getElementById("addStock")
                    .value
                    .trim();


            const price =
                document
                    .getElementById("addPrice")
                    .value
                    .trim();


            const offerPrice =
                document
                    .getElementById("addOfferPrice")
                    .value
                    .trim();


            const description =
                document
                    .getElementById("addDescription")
                    .value
                    .trim();


            let valid = true;


            /* =============================================
               COLOR
               ============================================= */

            if (!color) {

                showAddError(
                    "addColorError",
                    "Color is required."
                );

                valid = false;

            }


            /* =============================================
               STOCK
               ============================================= */

            if (
                stock === "" ||
                Number.isNaN(Number(stock)) ||
                Number(stock) < 0
            ) {

                showAddError(
                    "addStockError",
                    "Stock must be 0 or greater."
                );

                valid = false;

            }


            /* =============================================
               PRICE
               ============================================= */

            if (
                price === "" ||
                Number.isNaN(Number(price)) ||
                Number(price) <= 0
            ) {

                showAddError(
                    "addPriceError",
                    "Price must be greater than 0."
                );

                valid = false;

            }


            /* =============================================
               OFFER PRICE
               ============================================= */

            if (
                offerPrice !== "" &&
                (
                    Number.isNaN(
                        Number(offerPrice)
                    ) ||
                    Number(offerPrice) < 0
                )
            ) {

                showAddError(
                    "addOfferPriceError",
                    "Offer price cannot be negative."
                );

                valid = false;

            }


            if (
                offerPrice !== "" &&
                price !== "" &&
                Number(offerPrice) >= Number(price)
            ) {

                showAddError(
                    "addOfferPriceError",
                    "Offer price must be less than price."
                );

                valid = false;

            }


            /* =============================================
               DESCRIPTION
               ============================================= */

            if (!description) {

                showAddError(
                    "addDescriptionError",
                    "Description is required."
                );

                valid = false;

            }


            /* =============================================
               IMAGES
               ============================================= */

            const imageCount =
                addImages.filter(Boolean).length;


            if (imageCount === 0) {

                showAddError(
                    "addImageError",
                    "Please upload at least one image."
                );

                valid = false;

            }


            /* =============================================
               STOP IF INVALID
               ============================================= */

            if (!valid) {

                showValidationPopup(
                    "Please correct the highlighted fields before submitting."
                );

                return;

            }


            /* =============================================
               FORM DATA
               ============================================= */

            const formData =
                new FormData(addForm);


            formData.delete("images");


            addImages.forEach(
                function (file) {

                    if (file) {

                        formData.append(
                            "images",
                            file
                        );

                    }

                }
            );


            /* =============================================
               SUBMIT BUTTON
               ============================================= */

            const saveButton =
                document.getElementById(
                    "saveVariantButton"
                );


            saveButton.disabled = true;

            saveButton.innerHTML =
                `<span class="spinner-border spinner-border-sm"></span> Saving...`;


            /* =============================================
               SUBMIT
               ============================================= */

            fetch(
                addForm.action,
                {
                    method: "POST",

                    body: formData
                }
            )
                .then(
                    async response => {

                        const contentType =
                            response.headers.get(
                                "content-type"
                            ) || "";


                        /* =================================
                           JSON RESPONSE
                           ================================= */

                        if (
                            contentType.includes(
                                "application/json"
                            )
                        ) {

                            const data =
                                await response.json();


                            if (!response.ok) {

                                throw new Error(
                                    data.message ||
                                    "Failed to add variant."
                                );

                            }


                            if (data.redirect) {

                                window.location.href =
                                    data.redirect;

                                return;

                            }

                        }


                        /* =================================
                           REDIRECT
                           ================================= */

                        if (response.redirected) {

                            window.location.href =
                                response.url;

                            return;

                        }


                        /* =================================
                           HTML RESPONSE
                           ================================= */

                        const html =
                            await response.text();


                        if (html) {

                            document.open();

                            document.write(html);

                            document.close();

                        }

                    }
                )
                .catch(
                    error => {

                        console.error(
                            "ADD VARIANT ERROR:",
                            error
                        );


                        showValidationPopup(
                            error.message ||
                            "Something went wrong while adding the variant."
                        );


                        saveButton.disabled =
                            false;

                        saveButton.innerHTML =
                            "Add Variant";

                    }
                );

        }
    );


