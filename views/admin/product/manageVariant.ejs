<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/admin/manageVariant.css">

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
>

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css"
>

<body>

<div class="wrapper">

    <%- include("../partials/sidebar") %>

    <div class="main">

        <%- include("../partials/navbar") %>

        <div class="content">

            <!-- ALERTS -->

            <% if (typeof successMessage !== "undefined" && successMessage) { %>

                <div class="alert alert-success">
                    <%= successMessage %>
                </div>

            <% } %>

            <% if (typeof errorMessage !== "undefined" && errorMessage) { %>

                <div class="alert alert-danger">
                    <%= errorMessage %>
                </div>

            <% } %>


            <!-- PAGE TITLE -->

            <div class="page-title">

                <h1>Product Variants</h1>

                <p>
                    Manage variants for
                    <strong>
                        <%= product.productName %>
                    </strong>
                </p>

            </div>


            <!-- MAIN CARD -->

            <div class="form-card">

                <!-- HEADER -->

                <div class="variant-card-header">

                    <div class="variant-heading">

                        <h3>Variants</h3>

                        <p>
                            Edit or manage product variants
                        </p>

                    </div>

                    <div class="add-btn">

                        <button
                            type="button"
                            class="add-variant-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#addVariantModal"
                        >

                            <i class="bi bi-plus-lg"></i>

                            Add Variant

                        </button>

                    </div>

                </div>


                <!-- TABLE -->

                <div class="table-responsive">

                    <table class="table variant-table">

                        <thead>

                            <tr>

                                <th>Image</th>
                                <th>Color</th>
                                <th>Price</th>
                                <th>Offer Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th>Action</th>

                            </tr>

                        </thead>


                        <tbody>

                        <% if (variants && variants.length > 0) { %>

                            <% variants.forEach(variant => { %>

                                <tr>

                                    <!-- IMAGE -->

                                    <td>

                                        <% if (variant.images && variant.images.length > 0) { %>

                                            <img
                                                src="/uploads/variants/<%= variant.images[0] %>"
                                                class="variant-table-image"
                                                alt="<%= variant.color %>"
                                            >

                                        <% } else { %>

                                            <div class="variant-table-image empty-image">

                                                <i class="bi bi-image"></i>

                                            </div>

                                        <% } %>

                                    </td>


                                    <!-- COLOR -->

                                    <td>

                                        <strong>
                                            <%= variant.color %>
                                        </strong>

                                    </td>


                                    <!-- PRICE -->

                                    <td>
                                        ₹ <%= variant.price %>
                                    </td>


                                    <!-- OFFER PRICE -->

                                    <td>

                                        <% if (
                                            variant.offerPrice !== undefined &&
                                            variant.offerPrice !== null &&
                                            variant.offerPrice !== ""
                                        ) { %>

                                            ₹ <%= variant.offerPrice %>

                                        <% } else { %>

                                            -

                                        <% } %>

                                    </td>


                                    <!-- STOCK -->

                                    <td>
                                        <%= variant.stock %>
                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <% if (variant.isActive) { %>

                                            <span class="status-badge active">
                                                Active
                                            </span>

                                        <% } else { %>

                                            <span class="status-badge inactive">
                                                Inactive
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- ACTION -->

                                    <td>

                                        <div class="dropdown">

                                            <button
                                                type="button"
                                                class="action-btn"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                            >

                                                <i class="bi bi-three-dots"></i>

                                            </button>


                                            <ul class="dropdown-menu dropdown-menu-end">

                                                <li>

                                                    <button
                                                        type="button"
                                                        class="dropdown-item edit-variant-btn"

                                                        data-bs-toggle="modal"
                                                        data-bs-target="#editVariantModal"

                                                        data-variant-id="<%= variant._id %>"

                                                        data-color="<%= variant.color || '' %>"

                                                        data-stock="<%= variant.stock ?? '' %>"

                                                        data-price="<%= variant.price ?? '' %>"

                                                        data-offer-price="<%= variant.offerPrice ?? '' %>"

                                                        data-description="<%= variant.description || '' %>"

                                                        data-is-active="<%= variant.isActive ? 'true' : 'false' %>"

                                                        data-image1="<%= variant.images?.[0] || '' %>"

                                                        data-image2="<%= variant.images?.[1] || '' %>"

                                                        data-image3="<%= variant.images?.[2] || '' %>"
                                                    >

                                                        <i class="bi bi-pencil"></i>

                                                        Edit Variant

                                                    </button>

                                                </li>


                                                <li>
                                                    <hr class="dropdown-divider">
                                                </li>


                                                <li>

                                                    <button
                                                        type="button"
                                                        class="dropdown-item delete-variant-btn text-danger"

                                                        data-variant-id="<%= variant._id %>"

                                                        data-product-id="<%= product._id %>"
                                                    >

                                                        <i class="bi bi-trash"></i>

                                                        Delete Variant

                                                    </button>

                                                </li>

                                            </ul>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>

                                <td colspan="7">

                                    <div class="empty-state">

                                        <i class="bi bi-box-seam"></i>

                                        <h5>No variants found</h5>

                                        <p>
                                            Add a variant to this product.
                                        </p>

                                    </div>

                                </td>

                            </tr>

                        <% } %>

                        </tbody>

                    </table>

                </div>


                <!-- BOTTOM ACTIONS -->

                <div class="variant-bottom-actions">

                    <button
                        type="button"
                        class="btn-add-another"
                        data-bs-toggle="modal"
                        data-bs-target="#addVariantModal"
                    >

                        <i class="bi bi-plus-lg"></i>

                        Add Another Variant

                    </button>


                    <button
                        type="button"
                        class="btn-finish"
                        onclick="window.location.href='/admin/products'"
                    >

                        Finish

                    </button>

                </div>


                <!-- PAGINATION -->

                <div class="variants-pagination">

                    <div class="pagination-info">

                        Showing

                        <strong>
                            <%= variants ? variants.length : 0 %>
                        </strong>

                        variants

                    </div>


                    <div class="pagination-buttons">

                        <button
                            type="button"
                            class="page-btn"
                            disabled
                        >

                            <i class="bi bi-chevron-left"></i>

                            Previous

                        </button>


                        <button
                            type="button"
                            class="page-btn active"
                        >
                            1
                        </button>


                        <button
                            type="button"
                            class="page-btn"
                            disabled
                        >

                            Next

                            <i class="bi bi-chevron-right"></i>

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>



<!-- ============================================================
     ADD VARIANT MODAL
     ============================================================ -->

<div
    class="modal fade variant-modal"
    id="addVariantModal"
    tabindex="-1"
    aria-labelledby="addVariantModalLabel"
    aria-hidden="true"
>

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <div>

                    <h5
                        class="modal-title"
                        id="addVariantModalLabel"
                    >
                        Add Variant
                    </h5>

                    <small>
                        <%= product.productName %>
                    </small>

                </div>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>


            <form
                id="addVariantForm"
                method="POST"
                action="/admin/products/<%= product._id %>/variants/add"
                enctype="multipart/form-data"
                novalidate
            >

                <div class="modal-body">

                    <div
                        id="addModalErrorMessage"
                        class="alert alert-danger d-none"
                    ></div>


                    <div class="row g-4">

                        <!-- LEFT -->

                        <div class="col-lg-7">

                            <div class="modal-section">

                                <h5>
                                    Variant Information
                                </h5>


                                <div class="form-group">

                                    <label for="addColor">
                                        Color
                                    </label>

                                    <input
                                        type="text"
                                        name="color"
                                        id="addColor"
                                        class="form-control"
                                    >

                                    <small
                                        id="addColorError"
                                        class="field-error"
                                    ></small>

                                </div>


                                <div class="form-group">

                                    <label for="addStock">
                                        Stock
                                    </label>

                                    <input
                                        type="number"
                                        name="stock"
                                        id="addStock"
                                        class="form-control"
                                        min="0"
                                    >

                                    <small
                                        id="addStockError"
                                        class="field-error"
                                    ></small>

                                </div>


                                <div class="form-group">

                                    <label for="addPrice">
                                        Price (₹)
                                    </label>

                                    <input
                                        type="number"
                                        name="price"
                                        id="addPrice"
                                        class="form-control"
                                        min="1"
                                    >

                                    <small
                                        id="addPriceError"
                                        class="field-error"
                                    ></small>

                                </div>


                                <div class="form-group">

                                    <label for="addOfferPrice">
                                        Offer Price (₹)
                                    </label>

                                    <input
                                        type="number"
                                        name="offerPrice"
                                        id="addOfferPrice"
                                        class="form-control"
                                        min="0"
                                    >

                                    <small
                                        id="addOfferPriceError"
                                        class="field-error"
                                    ></small>

                                </div>


                                <div class="form-group">

                                    <label>
                                        Status
                                    </label>

                                    <div class="form-check form-switch">

                                        <input
                                            class="form-check-input"
                                            type="checkbox"
                                            name="isActive"
                                            value="true"
                                            id="addIsActive"
                                            checked
                                        >

                                        <label
                                            class="form-check-label"
                                            for="addIsActive"
                                        >
                                            Active
                                        </label>

                                    </div>

                                </div>


                                <div class="form-group">

                                    <label for="addDescription">
                                        Description
                                    </label>

                                    <textarea
                                        name="description"
                                        id="addDescription"
                                        class="form-control"
                                        rows="5"
                                    ></textarea>

                                    <small
                                        id="addDescriptionError"
                                        class="field-error"
                                    ></small>

                                </div>

                            </div>

                        </div>


                        <!-- RIGHT -->

                        <div class="col-lg-5">

                            <div class="modal-section">

                                <h5>
                                    Variant Images
                                </h5>


                                <div class="image-upload-area">

                                    <div class="upload-icon">

                                        <i class="bi bi-cloud-arrow-up"></i>

                                    </div>

                                    <h4>
                                        Add variant images
                                    </h4>

                                    <p>
                                        PNG, JPG up to 10MB
                                    </p>


                                    <button
                                        type="button"
                                        class="browse-btn"
                                        id="addBrowseBtn"
                                    >
                                        Browse Files
                                    </button>


                                    <input
                                        type="file"
                                        id="addImageInput"
                                        accept="image/png,image/jpeg,image/jpg"
                                        hidden
                                    >

                                </div>


                                <small
                                    id="addImageError"
                                    class="field-error"
                                ></small>


                                <div
                                    class="image-preview-container"
                                    id="addImagePreviewContainer"
                                >

                                    <% for(let i = 1; i <= 3; i++) { %>

                                        <div
                                            class="small-upload"
                                            id="addBox<%= i %>"
                                            data-index="<%= i - 1 %>"
                                        >

                                            <span
                                                class="plus"
                                                id="addPlus<%= i %>"
                                            >
                                                +
                                            </span>

                                            <img
                                                id="addPreview<%= i %>"
                                                style="display:none;"
                                                alt="Variant image"
                                            >

                                            <div
                                                class="image-actions"
                                                id="addActions<%= i %>"
                                                style="display:none;"
                                            >

                                                <button
                                                    type="button"
                                                    class="edit-image"
                                                    data-index="<%= i - 1 %>"
                                                >
                                                    <i class="bi bi-pencil"></i>
                                                </button>

                                                <button
                                                    type="button"
                                                    class="remove-image"
                                                    data-index="<%= i - 1 %>"
                                                >
                                                    <i class="bi bi-x-lg"></i>
                                                </button>

                                            </div>

                                        </div>

                                    <% } %>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>


                    <button
                        type="submit"
                        class="btn btn-primary"
                        id="saveVariantButton"
                    >
                        Add Variant
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- ============================================================
     EDIT VARIANT MODAL
     ============================================================ -->

<div
    class="modal fade variant-modal"
    id="editVariantModal"
    tabindex="-1"
    aria-labelledby="editVariantModalLabel"
    aria-hidden="true"
>

    <div class="modal-dialog modal-xl ">

        <div class="modal-content">

            <div class="modal-header">

                <div>

                    <h5
                        class="modal-title"
                        id="editVariantModalLabel"
                    >
                        Edit Variant
                    </h5>

                    <small>
                        <%= product.productName %>
                    </small>

                </div>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>


            <form

                id="editVariantForm"
                 method="POST"
                enctype="multipart/form-data"
                novalidate
            >

                <div class="modal-body">

                    <div
                        id="editModalErrorMessage"
                        class="alert alert-danger d-none"
                    ></div>


                    <div class="row g-4">

                        <!-- LEFT -->

                        <div class="col-lg-7">

                            <div class="modal-section">

                                <h5>
                                    Variant Information
                                </h5>


                                <div class="form-group">

                                    <label for="editColor">
                                        Color
                                    </label>

                                    <input
                                        type="text"
                                        name="color"
                                        id="editColor"
                                        class="form-control"
                                    >

                                    <small
                                        id="editColorError"
                                        class="field-error"
                                    ></small>

                                </div>


                                <div class="form-group">

                                    <label for="editStock">
                                        Stock
                                    </label>

                                    <input
                                        type="number"
                                        name="stock"
                                        id="editStock"
                                        class="form-control"
                                        min="0"
                                    >

                                    <small
                                        id="editStockError"
                                        class="field-error"
                                    ></small>

                                </div>


                                <div class="form-group">

                                    <label for="editPrice">
                                        Price (₹)
                                    </label>

                                    <input
                                        type="number"
                                        name="price"
                                        id="editPrice"
                                        class="form-control"
                                        min="1"
                                    >

                                    <small
                                        id="editPriceError"
                                        class="field-error"
                                    ></small>

                                </div>


                                <div class="form-group">

                                    <label for="editOfferPrice">
                                        Offer Price (₹)
                                    </label>

                                    <input
                                        type="number"
                                        name="offerPrice"
                                        id="editOfferPrice"
                                        class="form-control"
                                        min="0"
                                    >

                                    <small
                                        id="editOfferPriceError"
                                        class="field-error"
                                    ></small>

                                </div>


                                <div class="form-group">

                                    <label>
                                        Status
                                    </label>

                                    <div class="form-check form-switch">

                                        <input
                                            class="form-check-input"
                                            type="checkbox"
                                            name="isActive"
                                            value="true"
                                            id="editIsActive"
                                        >

                                        <label
                                            class="form-check-label"
                                            for="editIsActive"
                                        >
                                            Active
                                        </label>

                                    </div>

                                </div>


                                <div class="form-group">

                                    <label for="editDescription">
                                        Description
                                    </label>

                                    <textarea
                                        name="description"
                                        id="editDescription"
                                        class="form-control"
                                        rows="6"
                                    ></textarea>

                                    <small
                                        id="editDescriptionError"
                                        class="field-error"
                                    ></small>

                                </div>

                            </div>

                        </div>


                        <!-- RIGHT -->

                        <div class="col-lg-5">

                            <div class="modal-section">

                                <h5>
                                    Variant Images
                                </h5>


                                <div
                                    class="edit-image-preview-container"
                                    id="editImagePreviewContainer"
                                >

                                    <% for(let i = 1; i <= 3; i++) { %>

                                        <div
                                            class="small-upload edit-upload"
                                            id="editBox<%= i %>"
                                            data-index="<%= i - 1 %>"
                                        >

                                            <span
                                                class="plus"
                                                id="editPlus<%= i %>"
                                            >
                                                +
                                            </span>

                                            <img
                                                id="editPreview<%= i %>"
                                                style="display:none;"
                                                alt="Variant image"
                                            >

                                            <div
                                                class="image-actions"
                                                id="editActions<%= i %>"
                                                style="display:none;"
                                            >

                                                <button
                                                    type="button"
                                                    class="edit-existing-image"
                                                    data-index="<%= i - 1 %>"
                                                >

                                                    <i class="bi bi-pencil"></i>

                                                </button>


                                                <button
                                                    type="button"
                                                    class="remove-existing-image"
                                                    data-index="<%= i - 1 %>"
                                                >

                                                    <i class="bi bi-x-lg"></i>

                                                </button>

                                            </div>

                                        </div>

                                    <% } %>

                                </div>


                                <div class="edit-upload-new">

                                    <button
                                        type="button"
                                        class="browse-btn"
                                        id="editBrowseBtn"
                                    >

                                        <i class="bi bi-plus-lg"></i>

                                        Add / Change Image

                                    </button>


                                    <input
                                        type="file"
                                        id="editImageInput"
                                        accept="image/png,image/jpeg,image/jpg"
                                        hidden
                                    >

                                </div>


                                <small
                                    id="editImageError"
                                    class="field-error"
                                ></small>


                                <input
                                    type="hidden"
                                    name="removedImages"
                                    id="removedImages"
                                    value=""
                                >

                            </div>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>


                    <button
                        type="submit"
                        class="btn btn-primary"
                        id="updateVariantButton"
                    >
                        Update Variant
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- ============================================================
     CROP MODAL
     ============================================================ -->

<div
    class="modal fade crop-modal"
    id="cropModal"
    tabindex="-1"
    aria-hidden="true"
>

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Crop Image
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>


            <div class="modal-body crop-modal-body">

                <div class="crop-container">

                    <img
                        id="cropImage"
                        src=""
                        alt="Crop image"
                    >

                </div>

            </div>


            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-outline-secondary"
                    data-bs-dismiss="modal"
                >
                    Cancel
                </button>


                <button
                    type="button"
                    class="btn btn-primary"
                    id="cropConfirmBtn"
                >
                    Crop & Use Image
                </button>

            </div>

        </div>

    </div>

</div>



<!-- ============================================================
     DELETE MODAL
     ============================================================ -->

<div
    class="modal fade"
    id="deleteVariantModal"
    tabindex="-1"
    aria-hidden="true"
>

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content delete-modal-content">

            <div class="modal-body text-center">

                <div class="delete-icon">

                    <i class="bi bi-trash"></i>

                </div>


                <h4>
                    Delete Variant?
                </h4>


                <p>
                    Are you sure you want to delete this variant?
                    This action cannot be undone.
                </p>


                <form
                    
                    id="deleteVariantForm"
                    method="POST"
                >

                    <input
                        type="hidden"
                        name="_method"
                        value="DELETE"
                    >


                    <div class="delete-modal-buttons">

                        <button
                            type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal"
                        >
                            Cancel
                        </button>


                        <button
                            type="submit"
                            class="btn btn-danger"
                        >
                            Delete
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     VALIDATION ERROR MODAL
     ========================================================= -->

<div
    class="modal fade"
    id="validationModal"
    tabindex="-1"
    aria-labelledby="validationModalLabel"
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content validation-modal">

            <div class="modal-header">
                <h5
                    class="modal-title"
                    id="validationModalLabel"
                >
                    <i class="bi bi-exclamation-circle me-2"></i>
                    Validation Error
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                ></button>
            </div>

            <div class="modal-body">
                <p id="validationMessage">
                    Please correct the highlighted fields.
                </p>
            </div>

            <div class="modal-footer">
                <button
                    type="button"
                    class="btn btn-primary"
                    data-bs-dismiss="modal"
                >
                    OK
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ============================================================
     BOOTSTRAP
     ============================================================ -->

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


<!-- ============================================================
     CROPPER
     ============================================================ -->

<script
    src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js">
</script>



<script>

document.addEventListener("DOMContentLoaded", function () {

    /* =========================================================
       PRODUCT ID
       ========================================================= */

    const productId = "<%= product._id %>";


    /* =========================================================
       BOOTSTRAP MODALS
       ========================================================= */

    const addModalElement =
        document.getElementById("addVariantModal");

    const editModalElement =
        document.getElementById("editVariantModal");

    const cropModalElement =
        document.getElementById("cropModal");

    const deleteModalElement =
        document.getElementById("deleteVariantModal");

    const validationModalElement =
        document.getElementById("validationModal");


    const addModal =
        bootstrap.Modal.getOrCreateInstance(
            addModalElement
        );

    const editModal =
        bootstrap.Modal.getOrCreateInstance(
            editModalElement
        );

    const cropModal =
        bootstrap.Modal.getOrCreateInstance(
            cropModalElement
        );

    const deleteModal =
        bootstrap.Modal.getOrCreateInstance(
            deleteModalElement
        );

    const validationModal =
        bootstrap.Modal.getOrCreateInstance(
            validationModalElement
        );


    /* =========================================================
       VALIDATION POPUP
       ========================================================= */

    const validationMessage =
        document.getElementById("validationMessage");


    function showValidationPopup(message) {

        validationMessage.textContent = message;

        validationModal.show();
    }


    /* =========================================================
       CROPPER
       ========================================================= */

    let cropper = null;

    let cropMode = null;

    let cropIndex = null;


    /* =========================================================
       ADD IMAGE STATE
       ========================================================= */

    let addImages = [
        null,
        null,
        null
    ];


    /* =========================================================
       EDIT IMAGE STATE
       ========================================================= */

    let editImages = [
        null,
        null,
        null
    ];

    let removedImages = [];


    /* =========================================================
       ELEMENTS
       ========================================================= */

    const addImageInput =
        document.getElementById("addImageInput");

    const editImageInput =
        document.getElementById("editImageInput");

    const cropImage =
        document.getElementById("cropImage");


    /* =========================================================
       ADD VARIANT ELEMENTS
       ========================================================= */

    const addBrowseBtn =
        document.getElementById("addBrowseBtn");


    /* =========================================================
       ADD IMAGE BROWSE
       ========================================================= */

    addBrowseBtn.addEventListener("click", function () {

        addImageInput.value = "";

        addImageInput.click();

    });


    /* =========================================================
       ADD IMAGE SELECT
       ========================================================= */

    addImageInput.addEventListener(
        "change",
        function (event) {

            const file =
                event.target.files[0];

            if (!file) return;


            /* ---------------------------------------------
               FILE TYPE VALIDATION
               --------------------------------------------- */

            const allowedTypes = [
                "image/jpeg",
                "image/jpg",
                "image/png"
            ];

            if (!allowedTypes.includes(file.type)) {

                showValidationPopup(
                    "Please select a JPG or PNG image."
                );

                addImageInput.value = "";

                return;
            }


            /* ---------------------------------------------
               FILE SIZE VALIDATION
               --------------------------------------------- */

            if (file.size > 10 * 1024 * 1024) {

                showValidationPopup(
                    "Image size must be less than 10MB."
                );

                addImageInput.value = "";

                return;
            }


            /* ---------------------------------------------
               TARGET INDEX
               --------------------------------------------- */

            const targetIndex =
                addImageInput.dataset.target !== undefined
                    ? Number(addImageInput.dataset.target)
                    : addImages.findIndex(
                        image => image === null
                    );


            if (
                targetIndex < 0 ||
                targetIndex > 2
            ) {

                showValidationPopup(
                    "Maximum 3 images are allowed."
                );

                addImageInput.value = "";

                return;
            }


            openCropper(
                file,
                "add",
                targetIndex
            );

        }
    );


    /* =========================================================
       ADD IMAGE BOX CLICK
       ========================================================= */

    document
        .querySelectorAll(
            "#addImagePreviewContainer .small-upload"
        )
        .forEach(box => {

            box.addEventListener(
                "click",
                function (event) {

                    if (
                        event.target.closest(
                            ".image-actions"
                        )
                    ) {
                        return;
                    }


                    const index =
                        Number(box.dataset.index);


                    if (addImages[index]) {

                        return;

                    }


                    addImageInput.dataset.target =
                        index;

                    addImageInput.value = "";

                    addImageInput.click();

                }
            );

        });


    /* =========================================================
       OPEN CROPPER
       ========================================================= */

    function openCropper(
        file,
        mode,
        index
    ) {

        cropMode = mode;

        cropIndex = index;


        const reader =
            new FileReader();


        reader.onload =
            function (event) {

                cropImage.src =
                    event.target.result;

                cropModal.show();

            };


        reader.onerror =
            function () {

                showValidationPopup(
                    "Unable to load the selected image."
                );

            };


        reader.readAsDataURL(file);

    }


    /* =========================================================
       CROPPER INITIALIZE
       ========================================================= */

    cropModalElement.addEventListener(
        "shown.bs.modal",
        function () {

            if (cropper) {

                cropper.destroy();

                cropper = null;

            }


            cropper =
                new Cropper(
                    cropImage,
                    {
                        aspectRatio: 1,

                        viewMode: 1,

                        dragMode: "move",

                        autoCropArea: 0.9,

                        responsive: true,

                        background: false,

                        movable: true,

                        zoomable: true,

                        rotatable: false,

                        scalable: false
                    }
                );

        }
    );


    /* =========================================================
       CROP CONFIRM
       ========================================================= */

    document
        .getElementById("cropConfirmBtn")
        .addEventListener(
            "click",
            function () {

                if (!cropper) {

                    showValidationPopup(
                        "Cropper is not ready. Please try again."
                    );

                    return;
                }


                const canvas =
                    cropper.getCroppedCanvas(
                        {
                            width: 800,

                            height: 800,

                            imageSmoothingEnabled: true,

                            imageSmoothingQuality: "high"
                        }
                    );


                if (!canvas) {

                    showValidationPopup(
                        "Unable to crop the image. Please try again."
                    );

                    return;
                }


                canvas.toBlob(
                    function (blob) {

                        if (!blob) {

                            showValidationPopup(
                                "Unable to crop the image. Please try again."
                            );

                            return;
                        }


                        const file =
                            new File(
                                [blob],
                                `variant-${Date.now()}.jpg`,
                                {
                                    type: "image/jpeg"
                                }
                            );


                        /* =====================================
                           ADD
                           ===================================== */

                        if (cropMode === "add") {

                            addImages[cropIndex] =
                                file;

                            renderAddImages();

                        }


                        /* =====================================
                           EDIT
                           ===================================== */

                        if (cropMode === "edit") {

                            editImages[cropIndex] = {

                                file: file,

                                existing: false

                            };

                            renderEditImages();

                        }


                        cropModal.hide();

                    },
                    "image/jpeg",
                    0.9
                );

            }
        );


    /* =========================================================
       CROP MODAL CLEANUP
       ========================================================= */

    cropModalElement.addEventListener(
        "hidden.bs.modal",
        function () {

            if (cropper) {

                cropper.destroy();

                cropper = null;

            }


            cropImage.src = "";

            cropMode = null;

            cropIndex = null;

        }
    );


    /* =========================================================
       RENDER ADD IMAGES
       ========================================================= */

    function renderAddImages() {

        addImages.forEach(
            function (file, index) {

                const number =
                    index + 1;


                const box =
                    document.getElementById(
                        `addBox${number}`
                    );


                const image =
                    document.getElementById(
                        `addPreview${number}`
                    );


                const plus =
                    document.getElementById(
                        `addPlus${number}`
                    );


                const actions =
                    document.getElementById(
                        `addActions${number}`
                    );


                if (file) {

                    image.src =
                        URL.createObjectURL(file);

                    image.style.display =
                        "block";

                    plus.style.display =
                        "none";

                    actions.style.display =
                        "flex";

                    box.classList.add(
                        "has-image"
                    );

                }

                else {

                    image.src = "";

                    image.style.display =
                        "none";

                    plus.style.display =
                        "block";

                    actions.style.display =
                        "none";

                    box.classList.remove(
                        "has-image"
                    );

                }

            }
        );

    }


