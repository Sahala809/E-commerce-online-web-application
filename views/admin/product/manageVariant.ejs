                if (imageData.existing) {

                    image.src =
                        `/uploads/variants/${imageData.filename}`;

                }

                else {

                    image.src =
                        URL.createObjectURL(
                            imageData.file
                        );

                }


                image.style.display =
                    "block";

                plus.style.display =
                    "none";

                actions.style.display =
                    "flex";

                box.classList.add(
                    "has-image"
                );

