                price !== "" &&
                Number(offerPrice) >= Number(price)
            ) {

                showEditError(
                    "editOfferPriceError",
                    "Offer price must be less than price."
                );

                valid = false;

            }


            /* =============================================
               DESCRIPTION
               ============================================= */

            if (!description) {

                showEditError(
                    "editDescriptionError",
                    "Description is required."
                );

                valid = false;

            }


            /* =============================================
               IMAGE VALIDATION
               ============================================= */

            const remainingImages =
                editImages.filter(Boolean).length;


            if (remainingImages === 0) {

                showEditError(
                    "editImageError",
                    "At least one image is required."
                );

                valid = false;

            }


            /* =============================================
               STOP IF INVALID
               ============================================= */

            if (!valid) {

                showValidationPopup(
                    "Please correct the highlighted fields before updating."
                );

                return;

            }


            /* =============================================
               FORM DATA
               ============================================= */

            const formData =
                new FormData(editForm);


            formData.delete("images");


            /* =============================================
               REMOVED IMAGES
               ============================================= */

            formData.set(
                "removedImages",
                JSON.stringify(
                    removedImages
                )
            );


            /* =============================================
               ADD NEW / CROPPED IMAGES
               ============================================= */

            editImages.forEach(
                function (imageData) {

                    if (
                        imageData &&
                        !imageData.existing &&
                        imageData.file
                    ) {

                        formData.append(
                            "images",
                            imageData.file
                        );

                    }

                }
            );


            /* =============================================
               SUBMIT BUTTON
               ============================================= */

            const updateButton =
                document.getElementById(
                    "updateVariantButton"
                );


            updateButton.disabled =
                true;


            updateButton.innerHTML =
                `<span class="spinner-border spinner-border-sm"></span> Updating...`;


            /* =============================================
               SUBMIT
               ============================================= */

            fetch(
                editForm.action,
                {
                    method: "POST",

                    body: formData
                }
            )
                .then(
                    async response => {

                        /* =================================
                           REDIRECT
                           ================================= */

                        if (
                            response.redirected
                        ) {

                            window.location.href =
                                response.url;

                            return;

                        }


                        /* =================================
                           RESPONSE TYPE
                           ================================= */

                        const contentType =
                            response.headers.get(
                                "content-type"
                            ) || "";


                        /* =================================
                           JSON RESPONSE
                           ================================= */

                        if (
                            contentType.includes(
                                "application/json"
                            )
                        ) {

                            const data =
                                await response.json();


                            if (!response.ok) {

                                throw new Error(
                                    data.message ||
                                    "Failed to update variant."
                                );

                            }


                            if (
                                data.redirect
                            ) {

                                window.location.href =
                                    data.redirect;

                            }

                            return;

                        }


                        /* =================================
                           HTML RESPONSE
                           ================================= */

                        const html =
                            await response.text();


                        if (html) {

                            document.open();

                            document.write(html);

                            document.close();

                        }

                    }
                )
                .catch(
                    error => {

                        console.error(
                            "EDIT VARIANT ERROR:",
                            error
                        );


                        showValidationPopup(
                            error.message ||
                            "Something went wrong while updating the variant."
                        );


                        updateButton.disabled =
                            false;


                        updateButton.innerHTML =
                            "Update Variant";

                    }
                );

        }
    );


    /* =========================================================
       EDIT ERROR HELPER
       ========================================================= */

    function showEditError(
        id,
        message
    ) {

        const element =
            document.getElementById(id);


        if (element) {

            element.textContent =
                message;

        }

    }


    /* =========================================================
       CLEAR EDIT ERRORS
       ========================================================= */

    function clearEditErrors() {

        document
            .querySelectorAll(
                "#editVariantModal .field-error"
            )
            .forEach(
                element => {

                    element.textContent = "";

                }
            );


        const errorBox =
            document.getElementById(
                "editModalErrorMessage"
            );


        if (errorBox) {

            errorBox.classList.add(
                "d-none"
            );

            errorBox.textContent = "";

        }

    }


    /* =========================================================
       DELETE VARIANT
       ========================================================= */

    document
        .querySelectorAll(".delete-variant-btn")
        .forEach(
            button => {

                button.addEventListener(
                    "click",
                    function () {

                        const variantId =
                            button.dataset.variantId;


                        const productId =
                            button.dataset.productId;


                        const deleteForm =
                            document.getElementById(
                                "deleteVariantForm"
                            );


                        deleteForm.action =
                            `/admin/products/${productId}/variants/${variantId}/delete`;


                        deleteModal.show();

                    }
                );

            }
        );


    /* =========================================================
       RESET ADD MODAL
       ========================================================= */

    addModalElement.addEventListener(
        "hidden.bs.modal",
        function () {

            addForm.reset();


            addImages = [
                null,
                null,
                null
            ];


            addImageInput.value = "";


            delete addImageInput.dataset.target;


            renderAddImages();


            clearAddErrors();


            const saveButton =
                document.getElementById(
                    "saveVariantButton"
                );


            saveButton.disabled =
                false;


            saveButton.innerHTML =
                "Add Variant";

        }
    );


    /* =========================================================
       RESET EDIT MODAL
       ========================================================= */

    editModalElement.addEventListener(
        "hidden.bs.modal",
        function () {

            editImages = [
                null,
                null,
                null
            ];


            removedImages = [];


            editImageInput.value = "";


            delete editImageInput.dataset.target;


            document
                .getElementById(
                    "removedImages"
                )
                .value = "";


            clearEditErrors();


            const updateButton =
                document.getElementById(
                    "updateVariantButton"
                );


            updateButton.disabled =
                false;


            updateButton.innerHTML =
                "Update Variant";

        }
    );


    /* =========================================================
       RESET VALIDATION POPUP
       ========================================================= */

    validationModalElement.addEventListener(
        "hidden.bs.modal",
        function () {

            validationMessage.textContent = "";

        }
    );


    /* =========================================================
       INITIAL RENDER
       ========================================================= */

    renderAddImages();

});

</script>

</body>
</html>