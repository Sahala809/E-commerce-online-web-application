<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/admin/addProduct.css">

<body>

<div class="wrapper">

    <%- include("../partials/sidebar") %>

    <div class="main">

        <%- include("../partials/navbar") %>

        <div class="content">

            <div class="page-title">
                <h1>Add Product</h1>
                <p>Create a new product before adding its variants.</p>
            </div>

                
            <% if(successMessage){ %>
                <div class="alert alert-success">
                    <%= successMessage %>
                </div>
            <% } %>

            <% if(errorMessage){ %>
                <div class="alert alert-danger">
                    <%= errorMessage %>
                </div>
            <% } %>

            <div class="form-card">

                <form action="/admin/products/add" method="POST">

                    <div class="form-row">

                        <!-- Product Name -->

                        <div class="form-group">

                            <label>Product Name</label>

                            <input
                                type="text"
                                name="productName"
                                placeholder="Enter product name"
                                value="<%= formData?.productName || '' %>"
                            >

                            <% if(errors?.productName){ %>
                                <small class="text-danger">
                                    <%= errors.productName %>
                                </small>
                            <% } %>

                        </div>

                        <!-- Category -->

                        <div class="form-group">

                            <label>Category</label>

                            <select name="categoryId">

                                <option value="">
                                    Select Category
                                </option>

                                <% categories.forEach(category=>{ %>

                                    <option
                                        value="<%= category._id %>"
                                        <%= formData?.categoryId == category._id ? "selected" : "" %>>
                                        <%= category.categoryName %>
                                    </option>

                                <% }) %>

                            </select>

                            <% if(errors?.categoryId){ %>
                                <small class="text-danger">
                                    <%= errors.categoryId %>
                                </small>
                            <% } %>

                        </div>

                    </div>

                    <div class="form-row">

                        <!-- Brand -->

                        <div class="form-group">

                            <label>Brand (Optional)</label>

                            <select name="brandId">

                                <option value="">
                                    No Brand
                                </option>

                                <% brands.forEach(brand=>{ %>

                                    <option
                                        value="<%= brand._id %>"
                                        <%= formData?.brandId == brand._id ? "selected" : "" %>>
                                        <%= brand.brandName %>
                                    </option>

                                <% }) %>

                            </select>

                        </div>

                        <!-- Status -->

                        <div class="form-group">

                            <label>Status</label>

                            <div class="form-check form-switch mt-2">

                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    id="status"
                                    name="isActive"
                                    value="true"
                                    checked
                                >

                                <label
                                    class="form-check-label"
                                    for="status">

                                    Active

                                </label>

                            </div>

                        </div>

                    </div>

                    <!-- Description -->

                    <div class="form-group">

                        <label>Description</label>

                        <textarea
                            rows="5"
                            name="description"
                            placeholder="Enter product description"><%= formData?.description || '' %></textarea>

                        <% if(errors?.description){ %>
                            <small class="text-danger">
                                <%= errors.description %>
                            </small>
                        <% } %>

                    </div>

                    <div class="form-buttons">

                        <a
                            href="/admin/products"
                            class="cancel-btn">

                            Cancel

                        </a>

                        <button
                            type="submit"
                            class="save-btn">

                            Save Product

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>