

<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/admin/users.css">

<body>

<div class="wrapper">

    <%- include("../partials/sidebar") %>

    <div class="main">

        <%- include("../partials/navbar") %>

        <div class="content">

            

            <!-- Statistics -->

            <div class="stats">

                <div class="stat-card">
                    <h4>Total Customers</h4>
                    <h2><%= totalUsers %></h2>
                </div>

                <div class="stat-card">
                    <h4>Active Users</h4>
                    <h2><%= activeUsers %></h2>
                </div>

                <div class="stat-card">
                    <h4>Blocked Users</h4>
                    <h2><%= blockedUsers %></h2>
                </div>

            </div>

            <div class="page-title">

                <h1>Customers</h1>

                <p>Customer and their account details</p>

            </div>

              <% if(message){ %>
                    <div class="alert alert-danger">
                        <%= message %>
                    </div>
                <% } %>


            <!-- Search -->

            <div class="toolbar">

                <form action="/admin/users" method="GET">

                    <input
                        type="text"
                        name="search"
                        placeholder="Search user..."
                        value="<%= search || '' %>"
                    >

                    

                    <% if(search){ %>

                        <a href="/admin/users" class="clear-btn">
                            Clear
                        </a>

                    <% } %>


                </form>

            </div>

             <!-- Search Result -->

            <% if(search){ %>

                <div class="search-info">

                    Showing results for:

                    <strong>
                        <%= search %>
                    </strong>

                    (<%= users.length %> user<%= users.length !== 1 ? "s" : "" %> found)

                </div>

            <% } %>


            <!-- Table -->

            <div class="table-card">

                <table>

                    <thead>

                        <tr>

                            <th>Name</th>
                            <th>Email</th>
                            <th>Joined</th>
                            <th>Status</th>
                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% if(users.length === 0){ %>

                            <tr>
                                <td colspan="5" class="no-result">

                                    <% if(search){ %>

                                        No users found for "<%= search %>"

                                    <% } else { %>

                                        No users available

                                    <% } %>

                                </td>
                            </tr>


                        <% } else { %>


                            <% users.forEach(user=>{ %>


                            <tr class="<%= search && user.name.toLowerCase().includes(search.toLowerCase()) ? 'search-highlight' : '' %>">


                                <td>
                                    <%= user.name %>
                                </td>


                                <td>
                                    <%= user.email %>
                                </td>


                                <td>
                                    <%= user.createdAt.toLocaleDateString() %>
                                </td>


                                <td>

                                    <% if(user.isBlocked){ %>

                                        <span class="blocked">
                                            Blocked
                                        </span>

                                    <% } else { %>

                                        <span class="active">
                                            Active
                                        </span>

                                    <% } %>

                                </td>


                                <td>

                                    <a href="/admin/users/<%= user._id %>"
                                    class="view-btn">

                                        View

                                    </a>

                                </td>


                            </tr>


                            <% }) %>


                        <% } %>


                    </tbody>

                </table>

            </div>


            <!-- Pagination -->


            <div class="pagination">


                <% if(currentPage > 1){ %>


                    <a href="/admin/users?page=<%= currentPage - 1 %>&search=<%= search || '' %>">

                        Previous

                    </a>


                <% } %>





                <span>

                    Page <%= currentPage %> of <%= totalPages %>

                </span>





                <% if(currentPage < totalPages){ %>


                    <a href="/admin/users?page=<%= currentPage + 1 %>&search=<%= search || '' %>">

                        Next

                    </a>


                <% } %>



            </div>


        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    setTimeout(() => {
        const alert = document.querySelector(".alert");
        if (alert) {
            alert.remove();
        }
    }, 3000);
</script>

</body>

</html>