<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/admin/category.css">

<body>

<div class="wrapper">

    <%- include("../partials/sidebar") %>

    <div class="flex-grow-1">

        <%- include("../partials/navbar", { pageTitle: "Category" }) %>

        <div class="container-fluid mt-4">

            <!-- Your Category Table -->

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div class="page-title">
                    <h1>Category Management</h1>
                    <p>Add, edit, and manage product categories.</p>
                </div>

                <a href="/admin/category/add" class="btn add-btn">
    
                    <i class="bi bi-plus-circle me-2"></i>Add Category
                </a>
            </div>
            
           <% if(successMessage){ %>
                <div class="alert alert-success">
                    <%= successMessage %>
                </div>
            <% } %>

            <% if(errorMessage){ %>
                <div class="alert alert-danger">
                    <%= errorMessage %>
                </div>
            <% } %>

            <div class="toolbar">

                <form action="/admin/category" method="GET">

                    <input
                        type="text"
                        name="search"
                        placeholder="Search category..."
                        value="<%= search || '' %>">

    

                    <% if(search){ %>
                        <a href="/admin/category" class="clear-btn">
                            Clear
                        </a>
                    <% } %>

                </form>

            </div>

            <div class="table-card">

            <table class="table">

                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    <% if(categories.length > 0){ %>

                        <% categories.forEach((category,index)=>{ %>

                            <tr>

                                <td><%= index + 1 %></td>

                                <td><%= category.categoryName %></td>

                                <td><%= category.description %></td>

                                <td>

                                    <% if(category.isActive){ %>

                                        <span class="status-active">
                                            Active
                                        </span>

                                    <% }else{ %>

                                        <span class="status-inactive">
                                            Inactive
                                        </span>

                                    <% } %>

                                </td>

                                <td>
                                    <%= category.createdAt.toLocaleDateString() %>
                                </td>

                                <td>

                                    <div class="dropdown">

                                        <button
                                            class="btn action-btn"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">

                                            <i class="bi bi-three-dots-vertical"></i>

                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end">

                                            <li>
                                                <a class="dropdown-item"
                                                href="/admin/category/edit/<%= category._id %>">

                                                    <i class="bi bi-pencil-square"></i>
                                                    Edit

                                                </a>
                                            </li>

                                            <li>
                                                <form action="/admin/category/<%= category._id %>?_method=DELETE"
                                                    method="POST"
                                                    onsubmit="return confirm('Are you sure you want to delete this category?')">

                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="bi bi-trash me-2"></i>
                                                        Delete
                                                    </button>

                                                </form>
                                            </li>

                                        </ul>

                                    </div>

                                </td>

                            </tr>

                        <% }) %>

                    <% }else{ %>

                        <tr>
                            <td colspan="6" class="no-result">
                                No Categories Found
                            </td>
                        </tr>

                    <% } %>

                </tbody>

            </table>

            <!-- Pagination -->

                <% if(totalPages > 1){ %>

                <div class="pagination">

                    <% if(currentPage > 1){ %>

                        <a href="/admin/category?page=<%= currentPage - 1 %>&search=<%= search || '' %>">

                            Previous

                        </a>

                    <% } %>

                    <span>

                        Page <%= currentPage %> of <%= totalPages %>

                    </span>

                    <% if(currentPage < totalPages){ %>

                        <a href="/admin/category?page=<%= currentPage + 1 %>&search=<%= search || '' %>">

                            Next

                        </a>

                    <% } %>

                </div>

                <% } %>
            </div>
        </div>

    </div>

</div>

<%- include("../partials/footer") %>