
<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/admin/brands.css">

<body>

<div class="wrapper">

    <%- include("../partials/sidebar") %>

    <div class="main">

        <%- include("../partials/navbar") %>

        <div class="content">

            <!-- =====================================================
                 PAGE HEADER
            ====================================================== -->

            <div class="page-title">

                <div>
                    <h1>Brand Management</h1>

                    <p>
                        Manage your product brands.
                    </p>
                </div>

                <div class="add-brand-wrapper">

                    <button
                        type="button"
                        class="add-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#addBrandModal"
                    >
                        Add Brand
                    </button>

                </div>

            </div>


            <!-- =====================================================
                 SUCCESS MESSAGE
            ====================================================== -->

            <% if(successMessage){ %>

                <div class="alert alert-success">
                    <%= successMessage %>
                </div>

            <% } %>


            <!-- =====================================================
                 ERROR MESSAGE
            ====================================================== -->

            <% if(errorMessage){ %>

                <div class="alert alert-danger">
                    <%= errorMessage %>
                </div>

            <% } %>


            <!-- =====================================================
                 RECENT BRANDS
            ====================================================== -->

            <div class="section-header">

                <div>

                    <h3>
                        Recent Brands
                    </h3>

                    <p>
                        Recently added product brands.
                    </p>

                </div>

            </div>


            <!-- =====================================================
                 BRAND TABLE
            ====================================================== -->

            <div class="table-card">

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead>

                            <tr>

                                <th>#</th>

                                <th>
                                    Brand Image
                                </th>

                                <th>
                                    Brand Name
                                </th>

                                <th>
                                    Description
                                </th>

                                <th>
                                    Created At
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% if(brands && brands.length > 0){ %>

                                <% brands.forEach((brand, index) => { %>

                                    <tr>

                                        <!-- NUMBER -->

                                        <td>
                                            <%= index + 1 %>
                                        </td>


                                        <!-- BRAND IMAGE -->

                                        <td>

                                            <img
                                                src="<%= brand.brandImage %>"
                                                alt="<%= brand.brandName %>"
                                                class="brand-image"
                                            >

                                        </td>


                                        <!-- BRAND NAME -->

                                        <td>

                                            <strong>
                                                <%= brand.brandName %>
                                            </strong>

                                        </td>


                                        <!-- DESCRIPTION -->

                                        <td class="description-cell">

                                            <%= brand.description %>

                                        </td>


                                        <!-- CREATED DATE -->

                                        <td>

                                            <%= new Date(
                                                brand.createdAt
                                            ).toLocaleDateString() %>

                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                            <% if(brand.isActive){ %>

                                                <span class="badge bg-success">
                                                    Active
                                                </span>

                                            <% } else { %>

                                                <span class="badge bg-secondary">
                                                    Inactive
                                                </span>

                                            <% } %>

                                        </td>


                                        <!-- ACTION -->

                                        <td class="text-center">

                                            <div class="dropdown">

                                                <button
                                                    class="btn action-btn"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false"
                                                >

                                                    <i class="bi bi-three-dots-vertical"></i>

                                                </button>


                                                <ul class="dropdown-menu dropdown-menu-end">

                                                    <!-- EDIT -->

                                                    <li>

                                                        <button
                                                            type="button"
                                                            class="dropdown-item"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#editBrandModal<%= brand._id %>"
                                                        >

                                                            <i class="bi bi-pencil me-2"></i>

                                                            Edit

                                                        </button>

                                                    </li>


                                                    <!-- ACTIVATE / DEACTIVATE -->

                                                    <li>

                                                        <form
                                                            action="/admin/brands/toggle-status/<%= brand._id %>"
                                                            method="POST"
                                                        >

                                                            <button
                                                                type="submit"
                                                                class="dropdown-item"
                                                            >

                                                                <% if(brand.isActive){ %>

                                                                    <i class="bi bi-eye-slash me-2"></i>

                                                                    Deactivate

                                                                <% } else { %>

                                                                    <i class="bi bi-check-circle me-2"></i>

                                                                    Activate

                                                                <% } %>

                                                            </button>

                                                        </form>

                                                    </li>


                                                    <!-- DELETE -->

                                                    <li>

                                                        <button
                                                            type="button"
                                                            class="dropdown-item text-danger"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#deleteBrandModal<%= brand._id %>"
                                                        >

                                                            <i class="bi bi-trash me-2"></i>

                                                            Delete

                                                        </button>

                                                    </li>

                                                </ul>

                                            </div>

                                        </td>

                                    </tr>

                                <% }) %>


                            <% } else { %>

                                <!-- NO BRANDS -->

                                <tr>

                                    <td
                                        colspan="7"
                                        class="text-center py-5 text-muted"
                                    >

                                        No brands found.

                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>



<!-- =============================================================
     EDIT + DELETE MODALS
     IMPORTANT:
     These are outside the table / tbody.
============================================================== -->

<% if(brands && brands.length > 0){ %>

    <% brands.forEach((brand) => { %>


        <!-- =====================================================
             EDIT BRAND MODAL
        ====================================================== -->

        <div
            class="modal fade"
            id="editBrandModal<%= brand._id %>"
            tabindex="-1"
            aria-labelledby="editBrandModalLabel<%= brand._id %>"
            aria-hidden="true"
        >

            <div class="modal-dialog modal-lg modal-dialog-centered">

                <div class="modal-content">


                    <!-- HEADER -->

                    <div class="modal-header">

                        <div>

                            <h5
                                class="modal-title"
                                id="editBrandModalLabel<%= brand._id %>"
                            >
                                Edit Brand
                            </h5>

                            <small class="text-muted">
                                Update brand information
                            </small>

                        </div>

                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                        ></button>

                    </div>


                    <!-- FORM -->

                    <form
                        action="/admin/brands/edit/<%= brand._id %>?_method=PATCH"
                        method="POST"
                        enctype="multipart/form-data"
                    >

                        <div class="modal-body">

                            <div class="row g-4">


                                <!-- LEFT SIDE -->

                                <div class="col-md-7">

                                    <!-- BRAND NAME -->

                                    <div class="mb-3">

                                        <label class="form-label">
                                            Brand Name
                                            <span class="text-danger">*</span>
                                        </label>

                                        <input
                                            type="text"
                                            name="brandName"
                                            class="form-control"
                                            value="<%= brand.brandName %>"
                                            required
                                        >

                                    </div>


                                    <!-- DESCRIPTION -->

                                    <div class="mb-3">

                                        <label class="form-label">
                                            Description
                                            <span class="text-danger">*</span>
                                        </label>

                                        <textarea
                                            name="description"
                                            class="form-control"
                                            rows="5"
                                            required
                                        ><%= brand.description %></textarea>

                                    </div>


                                    <!-- STATUS -->

                                    <div class="mb-3">

                                        <label class="form-label">
                                            Status
                                        </label>

                                        <div class="form-check form-switch">

                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                name="isActive"
                                                value="true"
                                                <%= brand.isActive ? "checked" : "" %>
                                            >

                                            <label class="form-check-label">
                                                Active
                                            </label>

                                        </div>

                                    </div>

                                </div>


                                <!-- RIGHT SIDE -->

                                <div class="col-md-5">

                                    <label class="form-label">
                                        Brand Image
                                    </label>


                                    <!-- CURRENT IMAGE -->

                                    <div class="edit-brand-image-box">

                                        <img
                                            src="<%= brand.brandImage %>"
                                            alt="<%= brand.brandName %>"
                                            id="editBrandPreview<%= brand._id %>"
                                        >

                                    </div>


                                    <!-- CHANGE IMAGE -->

                                    <div class="mt-3">

                                        <input
                                            type="file"
                                            class="form-control"
                                            name="brandImage"
                                            accept="image/png,image/jpeg,image/jpg,image/webp"
                                        >

                                        <small class="text-muted">
                                            Leave empty to keep the current image.
                                        </small>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- FOOTER -->

                        <div class="modal-footer">

                            <button
                                type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal"
                            >
                                Cancel
                            </button>

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >
                                Save Changes
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>



        <!-- =====================================================
             DELETE BRAND MODAL
        ====================================================== -->

        <div
            class="modal fade"
            id="deleteBrandModal<%= brand._id %>"
            tabindex="-1"
            aria-labelledby="deleteBrandModalLabel<%= brand._id %>"
            aria-hidden="true"
        >

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content delete-modal">

                    <div class="modal-body text-center">


                        <!-- DELETE ICON -->

                        <div class="delete-icon">

                            <i class="bi bi-trash"></i>

                        </div>


                        <!-- TITLE -->

                        <h5
                            class="delete-title"
                            id="deleteBrandModalLabel<%= brand._id %>"
                        >
                            Delete Brand?
                        </h5>


                        <!-- MESSAGE -->

                        <p class="delete-message">

                            Are you sure you want to delete

                            <strong>
                                <%= brand.brandName %>
                            </strong>?

                        </p>


                        <!-- WARNING -->

                        <p class="delete-warning">

                            This action cannot be undone.

                        </p>


                        <!-- BUTTONS -->

                        <div class="delete-buttons">

                            <button
                                type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal"
                            >
                                Cancel
                            </button>


                            <form
                                action="/admin/brands/delete/<%= brand._id %>?_method=DELETE"
                                method="POST"
                            >

                                <button
                                    type="submit"
                                    class="btn btn-danger"
                                >
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

        </div>


    <% }) %>

<% } %>



<!-- =============================================================
     ADD BRAND MODAL
============================================================== -->

<div
    class="modal fade"
    id="addBrandModal"
    tabindex="-1"
    aria-labelledby="addBrandModalLabel"
    aria-hidden="true"
>

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content brand-modal">


            <!-- =================================================
                 HEADER
            ================================================== -->

            <div class="modal-header brand-modal-header">

                <div>

                    <h5
                        class="modal-title"
                        id="addBrandModalLabel"
                    >
                        Create New Brand
                    </h5>

                    <p class="brand-modal-subtitle">
                        Add a new watch brand to Chronix
                    </p>

                </div>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                ></button>

            </div>


            <!-- =================================================
                 FORM
            ================================================== -->

            <form
                action="/admin/brands/add"
                method="POST"
                enctype="multipart/form-data"
            >

                <div class="modal-body brand-modal-body">

                    <div class="row g-4">


                        <!-- =====================================
                             LEFT SIDE - BRAND INFORMATION
                        ====================================== -->

                        <div class="col-lg-6">

                            <div class="brand-form-section">


                                <!-- SECTION HEADING -->

                                <div class="section-heading">

                                    <div class="section-icon">

                                        <i class="bi bi-tag"></i>

                                    </div>

                                    <div>

                                        <h6>
                                            Brand Information
                                        </h6>

                                        <small>
                                            Enter the basic details
                                        </small>

                                    </div>

                                </div>


                                <!-- BRAND NAME -->

                                <div class="brand-field">

                                    <label
                                        for="brandName"
                                        class="form-label"
                                    >

                                        Brand Name

                                        <span>*</span>

                                    </label>


                                    <input
                                        type="text"
                                        class="form-control"
                                        id="brandName"
                                        name="brandName"
                                        placeholder="Enter brand name"
                                        required
                                    >

                                </div>


                                <!-- DESCRIPTION -->

                                <div class="brand-field">

                                    <label
                                        for="description"
                                        class="form-label"
                                    >

                                        Description

                                        <span>*</span>

                                    </label>


                                    <textarea
                                        class="form-control"
                                        id="description"
                                        name="description"
                                        rows="5"
                                        placeholder="Enter brand description"
                                        required
                                    ></textarea>

                                </div>


                                <!-- STATUS -->

                                <div class="brand-field">

                                    <label
                                        for="brandStatus"
                                        class="form-label"
                                    >

                                        Status

                                        <span>*</span>

                                    </label>


                                    <select
                                        class="form-select"
                                        id="brandStatus"
                                        name="isActive"
                                        required
                                    >

                                        <option
                                            value="true"
                                            selected
                                        >
                                            Active
                                        </option>

                                        <option value="false">
                                            Inactive
                                        </option>

                                    </select>

                                </div>

                            </div>

                        </div>



                        <!-- =====================================
                             RIGHT SIDE - BRAND LOGO
                        ====================================== -->

                        <div class="col-lg-6">

                            <div class="brand-logo-section">


                                <!-- SECTION HEADING -->

                                <div class="section-heading">

                                    <div class="section-icon">

                                        <i class="bi bi-image"></i>

                                    </div>

                                    <div>

                                        <h6>
                                            Brand Logo
                                        </h6>

                                        <small>
                                            Upload your brand image
                                        </small>

                                    </div>

                                </div>


                                <!-- =================================
                                     IMAGE UPLOAD AREA
                                ================================== -->

                                <label
                                    for="brandImage"
                                    class="brand-upload-box"
                                    id="brandUploadBox"
                                >


                                    <!-- DEFAULT CONTENT -->

                                    <div
                                        id="uploadContent"
                                        class="upload-content"
                                    >

                                        <div class="upload-icon">

                                            <i class="bi bi-cloud-arrow-up"></i>

                                        </div>


                                        <h6>
                                            Upload Brand Logo
                                        </h6>


                                        <p>
                                            Click to browse your files
                                        </p>


                                        <span class="upload-format">
                                            PNG, JPG, JPEG or WEBP
                                        </span>

                                    </div>



                                    <!-- IMAGE PREVIEW -->

                                    <div
                                        id="imagePreviewContent"
                                        class="image-preview-content d-none"
                                    >

                                        <div class="preview-image-wrapper">

                                            <img
                                                id="brandImagePreview"
                                                src=""
                                                alt="Brand Preview"
                                                class="brand-image-preview"
                                            >

                                        </div>


                                        <div class="preview-text">

                                            <strong>
                                                Image selected
                                            </strong>

                                            <span>
                                                Click to change image
                                            </span>

                                        </div>

                                    </div>

                                </label>


                                <!-- FILE INPUT -->

                                <input
                                    type="file"
                                    class="d-none"
                                    id="brandImage"
                                    name="brandImage"
                                    accept="image/png,image/jpeg,image/jpg,image/webp"
                                    required
                                >


                                <!-- IMAGE NOTE -->

                                <div class="image-upload-note">

                                    <i class="bi bi-info-circle"></i>

                                    <span>
                                        Recommended: square image with a clear logo
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>



                <!-- =================================================
                     FOOTER / BUTTONS
                ================================================== -->

                <div class="modal-footer brand-modal-footer">

                    <button
                        type="button"
                        class="btn btn-outline-secondary brand-cancel-btn"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>


                    <button
                        type="submit"
                        class="btn brand-save-btn"
                    >

                        <i class="bi bi-plus-lg me-2"></i>

                        Add Brand

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- =============================================================
     BRAND IMAGE PREVIEW JAVASCRIPT
============================================================== -->

<script src="/js/admin/brands.js"></script>


<%- include("../partials/footer") %>

